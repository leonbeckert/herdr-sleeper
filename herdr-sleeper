NAME_TAIL_BYTES = 256 * 1024


def claude_session_name(transcript: Path | None) -> str | None:
    """The name Claude Code lists this session under (ListAgents, SendMessage `to`): the last
    `agent-name` record of its transcript. None when there is none or it cannot be read."""
    if transcript is None:
        return None
    try:
        with transcript.open("rb") as fh:
            fh.seek(max(0, transcript.stat().st_size - NAME_TAIL_BYTES))
            tail = fh.read()
    except OSError:
        return None
    for line in reversed(tail.splitlines()):
        if b'"agent-name"' not in line:
            continue
        with contextlib.suppress(ValueError):
            rec = json.loads(line)
            if isinstance(rec, dict) and rec.get("type") == "agent-name" and isinstance(rec.get("agentName"), str):
                return rec["agentName"]
    return None


def transcript_for(uuid: str) -> Path | None:
    """The transcript for a claude session; when several match, the most recently written one."""
    hits = [Path(p) for p in glob.glob(str(TRANSCRIPTS / "*" / f"{uuid}.jsonl"))]
    if not hits:
        return None
    try:
        return max(hits, key=lambda p: p.stat().st_mtime)
    except OSError:
        return None


def agent_process(pane: str, kind: str) -> tuple[bool | None, list[str] | None, int | None]:
    """(present, argv_after_argv0, pid) for the agent process controlling the pane.

    present is True/False when process-info answered, None when it could not
    be read — an unknown must never be mistaken for "gone". A foreground
    process whose argv Herdr could not read (macOS gives a name but no argv
    for some processes) makes the answer unknown too, unless another process
    already identifies the agent.
    """
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None, None, None
    # an idle pane still lists its shell; [] is Herdr's "could not see the foreground job" (unwrap_or_default)
    unknown = not info["foreground_processes"]
    for proc in info["foreground_processes"]:
        argv = proc.get("argv") or []
        if not argv:
            unknown = True
            continue
        base = os.path.basename(str(argv[0]))
        if base == kind or proc.get("name") == kind or base == "node" and any(
                str(p).endswith(f"{kind}-code/cli.js") or str(p).endswith(f"{kind}/cli.js") for p in argv[1:3]):
            return True, [str(a) for a in argv[1:]], proc.get("pid")
    return (None, None, None) if unknown else (False, None, None)


def stub_argv_index(argv: list[str]) -> int | None:
    """Index of the script token when argv is our wake stub, else None.

    Structural, never a substring test: `[python] /…/herdr-sleeper stub PANE UUID [STATE_DIR]`,
    the script as argv[0] (shebang exec) or argv[1] after a python interpreter. A claude whose
    prompt or `--add-dir` merely mentions this plugin and the word `stub` is not a stub.
    """
    for i in (0, 1):
        if i < len(argv) and os.path.basename(str(argv[i])) == "herdr-sleeper":
            if i == 1 and not os.path.basename(str(argv[0])).lower().startswith("python"):
                return None
            return i if [str(a) for a in argv[i + 1:i + 2]] == ["stub"] and len(argv) >= i + 4 else None
    return None


def stub_running(pane: str, uuid: str | None = None) -> bool | None:
    """Is our in-pane wake stub (for this pane, and this uuid when given) the pane's foreground process?

    The stub appears as `<python> /path/to/herdr-sleeper stub <pane> <uuid>`
    (a child of the pane's shell — never exec'd over the shell itself).
    None when that cannot be told (process-info unreadable, or a process without argv).
    """
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None
    unknown = not info["foreground_processes"]  # [] is "could not see the job", never "no stub"
    for proc in info["foreground_processes"]:
        argv = [str(a) for a in (proc.get("argv") or [])]
        if not argv:
            unknown = True
            continue
        i = stub_argv_index(argv)
        if i is not None and argv[i + 2] == pane and (uuid is None or argv[i + 3] == uuid):
            return True
    return None if unknown else False


def rss_mb(pane: str) -> int:
    """Resident memory of the pane's foreground job (the agent plus what it spawned)."""
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    pids = [str(p.get("pid")) for p in (info or {}).get("foreground_processes", []) if p.get("pid")]
    if not pids:
        return 0
    try:
        out = subprocess.run([PS, "-o", "rss=", "-p", ",".join(pids)], capture_output=True, text=True, timeout=10).stdout
        return sum(int(x) for x in out.split() if x.isdigit()) // 1024
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0


SHELLS = {"bash", "sh", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "login"}
# Executable names (ps `comm`) an agent of each kind may run as: the binary itself, or the runtime of
# an npm/bun install. SIGTERM goes only to a pid whose name is on this list.
AGENT_COMMS = {"claude": {"claude", "node"}, "opencode": {"opencode", "node", "bun"}}


def process_table() -> dict[int, tuple[int, str]]:
    """pid -> (ppid, executable name) for every process; {} when ps fails (callers fail closed).
    Names only (`comm`): argument vectors can carry secrets and are not read here."""
    try:
        out = subprocess.run([PS, "-A", "-o", "pid=,ppid=,comm="], capture_output=True, text=True,
                             timeout=15, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    table: dict[int, tuple[int, str]] = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            table[int(parts[0])] = (int(parts[1]), os.path.basename(parts[2].strip()))
    return table


def descendants(table: dict[int, tuple[int, str]], pid: int) -> dict[int, str]:
    """Every process below pid in the table: pid -> executable name."""
    kids: dict[int, list[int]] = {}
    for child, (parent, _comm) in table.items():
        kids.setdefault(parent, []).append(child)
    out: dict[int, str] = {}
    todo = list(kids.get(pid, []))
    while todo:
        child = todo.pop()
        if child not in out:
            out[child] = table[child][1]
            todo.extend(kids.get(child, []))
    return out


def signalable(pid: object, kind: str, table: dict[int, tuple[int, str]]) -> str | None:
    """Why pid must not get our SIGTERM, or None when it may. A pid of 0 or -1 would signal a whole
    process group or every process we own; a reused pid would hit a stranger."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1 or pid in (os.getpid(), os.getppid()):
        return f"pid {pid!r} is not a plausible agent pid"
    row = table.get(pid)
    if row is None:
        return f"pid {pid} is not in the process table (gone, or ps failed)"
    if row[1].lstrip("-") not in AGENT_COMMS.get(kind, {kind}):
        return f"pid {pid} runs {row[1]!r}, not {kind}"
    return None


def pane_at_shell(pane: str) -> bool | None:
    """Is the pane's foreground nothing but its shell? Typing a line (`pane run`, `agent start`)
    into anything else (an editor, a pager, a REPL) would feed it keystrokes. None: cannot tell."""
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None
    procs = info["foreground_processes"]
    if not procs:
        return None  # [] is "could not see the job", never "bare shell"
    names = [os.path.basename(str((p.get("argv") or [p.get("name") or ""])[0])).lstrip("-") for p in procs]
    return all(n in SHELLS for n in names)


def reap_helpers(helpers: dict[int, str]) -> list[str]:
    """SIGTERM the agent's former children that outlived it: still alive, same name, and reparented
    to launchd/init (ppid 1). MCP servers and other helpers otherwise keep their memory forever."""
    if not helpers:
        return []
    table = process_table()
    reaped: list[str] = []
    for pid, comm in helpers.items():
        row = table.get(pid)
        if row and row[0] == 1 and row[1] == comm:
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGTERM)
                reaped.append(comm)
    return reaped


REFUSED_OPTIONS = {"--fork-session", "--print", "--session-id", "--new", "--replay", "-p"}
BOOLEAN_OPTIONS = {"--dangerously-skip-permissions", "--verbose", "--debug", "-d"}
# Values of these are replayed and kept in the journal, so none of them may carry a secret
# (`--env KEY=VALUE` did; an argv with it now refuses as an unrecognised option).
VALUE_OPTIONS = {"--model", "--permission-prompt-tool", "--add-dir", "--setting-source", "-n", "--name"}


def replayable_argv(args: list[str]) -> tuple[list[str] | None, str | None]:
    """Strip session-selection flags; refuse argv that would fork the session or re-run work.

    Returns (argv_to_replay, refusal_reason). Claude-specific: only used for
    kinds whose profile replays the original argv. A reason names options, never
    values or positional text: it ends up in the log and the event stream.
    """
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return None, "argv contains `--` (positional input would be replayed)"
        if a in REFUSED_OPTIONS or a.split("=", 1)[0] in REFUSED_OPTIONS:
            return None, f"argv contains {a.split('=', 1)[0]} (not safely replayable)"
        if a in ("--resume", "-r"):
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1  # drop its value too
            i += 1
            continue
        if a.startswith("--resume=") or a in ("--continue", "-c"):
            i += 1
            continue
        if a in BOOLEAN_OPTIONS:
            out.append(a)
            i += 1
            continue
        base = a.split("=", 1)[0]
        if base in VALUE_OPTIONS:
            out.append(a)
            if "=" not in a:
                if i + 1 >= len(args):
                    return None, f"{a} is missing its value"
                out.append(args[i + 1])
                i += 1
            i += 1
            continue
        if a.startswith("-"):
            # an option we do not know the arity of: guessing could turn a prompt into a "value" and replay it
            return None, (f"argv has unrecognised option {a.split('=', 1)[0]} "
                          "(add it to VALUE_OPTIONS/BOOLEAN_OPTIONS if it is safe)")
        return None, "argv has positional input (an initial prompt would be re-sent on wake)"
    return out, None


ANSI_SGR = re.compile(r"\x1b\[([0-9;:]*)m")
ANSI_ANY = re.compile(r"\x1b(?:\[[0-9;:?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])")
SGR_COLOR_ARGS = {"5": 1, "2": 3}  # after 38/48/58: `5;n` (palette) or `2;r;g;b` (truecolour)


def strip_ansi(line: str) -> str:
    return ANSI_ANY.sub("", line)


def sgr_dim(params: str, dim: bool) -> bool:
    """Whether text is dim after one SGR sequence. Colour arguments are skipped, not read as
    attributes: the `2` in `38;2;r;g;b` is truecolour, not dim."""
    codes = (params or "0").split(";")
    i = 0
    while i < len(codes):
        code = codes[i].split(":", 1)[0]  # `38:2::r:g:b` carries its arguments in one parameter
        if code in ("38", "48", "58") and ":" not in codes[i]:
            i += 1 + (1 + SGR_COLOR_ARGS[codes[i + 1]] if i + 1 < len(codes) and codes[i + 1] in SGR_COLOR_ARGS else 0)
            continue
        if code in ("", "0", "22"):
            dim = False
        elif code == "2":
            dim = True
        i += 1
    return dim


def typed_text(line: str) -> str:
    """The characters of a screen line not rendered dim. Claude Code shows a prompt suggestion in
    an empty composer as dim (SGR 2) text; that is not a draft. Plain-text input has no styling,
    so everything in it counts as typed."""
    out: list[str] = []
    dim, i = False, 0
    while i < len(line):
        m = ANSI_SGR.match(line, i)
        if m:
            dim = sgr_dim(m.group(1), dim)
            i = m.end()
            continue
        m = ANSI_ANY.match(line, i)
        if m:
            i = m.end()
            continue
        if not dim:
            out.append(line[i])
        i += 1
    return "".join(out)


def is_rule(line: str) -> bool:
    text = line.strip()
    return len(text) >= 3 and set(text) <= {"─"}


def composer_state(screen: str | None) -> tuple[str, str]:
    """('empty' | 'draft' | 'unknown', detail) judged from the pane screen, failing closed.

    The composer is the last line starting with a prompt glyph. Text on it that is not dim, or
    any such text on the lines between it and the next horizontal rule (a multi-line draft), is a
    draft. Below that rule is the footer (status line, mode, hints), whatever it says. No glyph,
    no rule below it, or no screen at all is unknown: refuse.
    """
    if screen is None:
        return "unknown", "screen unreadable"
    raw = [ln.rstrip() for ln in screen.splitlines() if strip_ansi(ln).strip()]
    lines = [strip_ansi(ln) for ln in raw]
    for idx in range(len(lines) - 1, -1, -1):
        stripped = lines[idx].lstrip()
        if stripped.startswith(PROMPT_GLYPHS):
            # the detail is logged: say where the text is and its shape, never what it says. A typed
            # draft ("2. good point") and an open question menu ("❯ 1. Option") look alike: both refuse
            typed = typed_text(raw[idx]).strip()
            if typed.startswith(PROMPT_GLYPHS):
                typed = typed[1:].strip()
            if typed:
                return "draft", f"text on the prompt line (a draft or an open question menu), {len(typed)} chars"
            rest = lines[idx + 1:]
            rule = next((j for j, ln in enumerate(rest) if is_rule(ln)), None)
            if rule is None:  # a bare glyph with no box under it is not a composer we can vouch for
                return "unknown", "no rule below the prompt"
            below = sum(1 for ln in raw[idx + 1:idx + 1 + rule] if typed_text(ln).strip())
            if below:
                return "draft", (f"text below the prompt line (a multi-line draft or an open menu), "
                                 f"{below} line{'s' if below != 1 else ''}")
            return "empty", ""
        if stripped.startswith(("⏺", "✻", "⎿")):
            return "unknown", "composer not visible below transcript"
    return "unknown", "no prompt glyph on screen"


BG_ITEM = re.compile(r"^(\d+) (monitor|shell)s?$")
SUBAGENT_LINE = re.compile(r"^\S \S+ {2,}.* · ↓ [\d.]+[kM]? tokens$")


def background_work(screen: str | None) -> str | None:
    """What Claude Code's footer says still runs ("1 monitor", "2 shells", subagent rows), or None.

    Only lines below the last horizontal rule count, so transcript text cannot match. Patterns
    from netresearch/herdr-bg-activity (MIT): Herdr reports such a pane as idle (herdr#1217).
    """
    if screen is None:
        return None
    lines = [strip_ansi(ln).strip() for ln in screen.splitlines()]
    rules = [i for i, ln in enumerate(lines) if is_rule(ln)]
    if not rules:
        return None
    found: list[str] = []
    for line in lines[rules[-1] + 1:]:
        if SUBAGENT_LINE.match(line):
            found.append("a subagent")
            continue
        for piece in re.split(r"[·,]", line):
            m = BG_ITEM.match(piece.strip())
            if m:
                found.append(f"{m.group(1)} {m.group(2)}{'s' if m.group(1) != '1' else ''}")
    return ", ".join(found) or None


def _age_seconds(stamp: object, now: float) -> float:
    """Age of a transcript ISO timestamp; 0 (fresh) when it cannot be parsed — fail closed."""
    try:
        return now - dt.datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


CRON_SCAN: dict[str, dict] = {}  # transcript path -> {ino, offset, events}: what cron_jobs has read


def cron_jobs(path: Path, now: float) -> int:
    """Session cron jobs still scheduled: CronCreate minus CronDelete over the whole transcript,
    within CRON_HORIZON_SECONDS. A cron made long before the tail would otherwise be missed;
    the watcher keeps its read offset, so each tick reads only what was appended."""
    st = path.stat()
    rec = CRON_SCAN.get(str(path))
    with path.open("rb") as fh:
        if rec is not None and rec["ino"] == st.st_ino and st.st_size >= rec["offset"]:
            fh.seek(max(0, rec["offset"] - len(rec["mark"])))
            if fh.read(len(rec["mark"])) != rec["mark"]:
                rec = None  # rewritten in place, not appended to: read it again
        if rec is None or rec["ino"] != st.st_ino or st.st_size < rec["offset"]:
            rec = {"ino": st.st_ino, "offset": 0, "events": [], "mark": b""}
        fh.seek(rec["offset"])
        pos = rec["offset"]
        for line in fh:
            if not line.endswith(b"\n"):
                break  # a line still being written: read it whole next time
            pos += len(line)
            if b'"Cron' not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict) or entry.get("isSidechain") or entry.get("type") != "assistant":
                continue
            content = (entry.get("message") or {}).get("content")
            for b in content if isinstance(content, list) else []:
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in ("CronCreate", "CronDelete"):
                    # an unparseable stamp ages from now: fail closed, the job counts for the whole horizon
                    stamp = now - _age_seconds(entry.get("timestamp"), now) if entry.get("timestamp") else now
                    rec["events"].append((stamp, 1 if b["name"] == "CronCreate" else -1))
        fh.seek(max(0, pos - 64))
        rec["mark"] = fh.read(pos - max(0, pos - 64))  # the bytes before the offset: proof of an append
    rec["offset"] = pos
    rec["events"] = [(t, d) for t, d in rec["events"] if now - t < CRON_HORIZON_SECONDS]
    CRON_SCAN[str(path)] = rec
    count = 0
    for _t, d in rec["events"]:
        count = max(0, count + d)
    return count


def scheduled_work(uuid: str) -> str | None:
    """A ScheduleWakeup still pending, or session cron jobs still scheduled, per the transcript tail.

    A wakeup is pending when the last one (not `stop`) came after the last human prompt and is
    younger than WAKEUP_HORIZON_SECONDS; crons count CronCreate minus CronDelete over the last
    CRON_HORIZON_SECONDS. Sleeping such a session would cancel the timer silently.
    """
    path = transcript_for(uuid)
    if path is None:
        return None  # assess refuses a claude pane without a transcript before this is asked
    now = time.time()
    try:
        crons = cron_jobs(path, now)
        with path.open("rb") as fh:
            fh.seek(max(0, path.stat().st_size - TRANSCRIPT_TAIL_BYTES))
            tail = fh.read()
    except OSError:
        return "transcript unreadable (cannot rule out scheduled work)"
    last_prompt = -1
    wakeup: tuple[int, object] | None = None
    for idx, line in enumerate(tail.splitlines()):
        if b'"user"' not in line and b'"ScheduleWakeup"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue  # the first line of the tail is usually cut
        if not isinstance(rec, dict) or rec.get("isSidechain"):
            continue
        content = (rec.get("message") or {}).get("content")
        blocks = [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []
        if rec.get("type") == "user" and not rec.get("isMeta"):
            if isinstance(content, str) or (blocks and not any(b.get("type") == "tool_result" for b in blocks)):
                last_prompt = idx
        elif rec.get("type") == "assistant":
            for b in blocks:
                if b.get("type") != "tool_use":
                    continue
                name, args = b.get("name"), b.get("input") if isinstance(b.get("input"), dict) else {}
                if name == "ScheduleWakeup":
                    wakeup = None if args.get("stop") else (idx, rec.get("timestamp"))
    if crons:
        return f"{crons} session cron job(s) scheduled"
    if wakeup and wakeup[0] > last_prompt and _age_seconds(wakeup[1], now) < WAKEUP_HORIZON_SECONDS:
        return "a scheduled wakeup is pending"
    return None


def busy_reason(agent: dict) -> str | None:
    """Why an idle-looking pane must not sleep yet (profiles with idle_guards), or None.

    Herdr's `idle` only means the turn ended: a draft may sit in the composer, and monitors,
    background shells, subagents, or a scheduled wakeup may still run.
    """
    pane, kind = agent["pane_id"], agent.get("agent")
    screen = herdr_screen(pane)
    state, detail = composer_state(screen)
    if state != "empty":
        return f"composer {state}: {detail}"
    bg = background_work(screen)
    if bg:
        return f"background work running ({bg})"
    present, _argv, pid = agent_process(pane, str(kind))
    if present is not True or not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return "agent process not identifiable (cannot check its children)"
    table = process_table()
    if pid not in table:
        return "process table unreadable (cannot check the agent's children)"
    shells = [c for c in descendants(table, pid).values() if c.lstrip("-") in SHELLS]
    if shells:
        return f"{len(shells)} shell process(es) still run under the agent (background task)"
    uuid = (agent.get("agent_session") or {}).get("value")
    return scheduled_work(uuid) if kind == "claude" and uuid else None


def uuid_live_elsewhere(uuid: str, except_pane: str | None = None, cwd: str | None = None) -> str | None:
    """Where this session is already running ('pane w1:p2', 'pid 123'); None if verified nowhere.

    Raises SleeperError when that cannot be verified — an unknown answer must
    not authorise a resume, which would fork the session.
    """
    try:
        agents = list_agents()
    except SleeperError as exc:
        raise SleeperError(f"cannot verify session liveness: {exc}")
    for a in agents:
        if a["pane_id"] != except_pane and (a.get("agent_session") or {}).get("value") == uuid:
            return f"pane {a['pane_id']}"
    try:
        ps = subprocess.run([PS, "-eo", "pid=,args="], capture_output=True, text=True, timeout=15, check=True).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        raise SleeperError(f"cannot verify session liveness: ps failed ({exc})")
    for line in ps.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        # a shell whose command text merely mentions the uuid is not a session; anything else that
        # selects the uuid on its command line (claude, node …/claude, node …/cli.js) is treated as one
        if os.path.basename(parts[1]) in ("bash", "sh", "zsh", "fish", "dash", "login"):
            continue
        i = stub_argv_index(parts[1:])
        if i is not None and parts[i + 4:i + 5] == [uuid]:
            continue  # our own in-pane wake stub carries the uuid as an argument; it is not a session
        selects = any(p == uuid or p.endswith("=" + uuid) for p in parts[2:])
        if selects:
            return f"pid {parts[0]}"
        if not any(os.path.basename(p) == "claude" or p.endswith("claude-code/cli.js") for p in parts[1:3]):
            continue
        # `claude --continue` picks up the newest session in its cwd, which may be this one
        if cwd and any(p in ("--continue", "-c") for p in parts[2:]):
            where = process_cwd(parts[0])
            if where is None:
                raise SleeperError(f"cannot verify session liveness: pid {parts[0]} runs `claude --continue` "
                                   "and its cwd could not be inspected (lsof)")
            if where == cwd:
                return f"pid {parts[0]} (claude --continue in {cwd})"
    return None


def process_cwd(pid: str) -> str | None:
    """The process's cwd via lsof, or None when that could not be established (callers treat None as unknown)."""
    try:
        proc = subprocess.run([LSOF, "-a", "-p", pid, "-d", "cwd", "-Fn"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        if line.startswith("n") and len(line) > 1:
            return line[1:]
    return None


def same_dir(a: str, b: str) -> bool:
    return os.path.realpath(a) == os.path.realpath(b)


def carries_sleep_label(info: dict) -> bool:
    return str(info.get("label") or "").startswith(SLEEP_MARK)


def identity(entry: dict, info: dict) -> str:
    """How a pane (`pane get`/`pane list`/`agent list` row) relates to a journal entry's pane.

    'same'      the terminal the entry was recorded in;
    'restarted' a new terminal id on a pane that still carries our 💤 label: Herdr
                re-allocates every terminal id on restore (src/persist/restore.rs:574) and
                re-applies the saved manual label (:577), so this is the slept pane after a
                restart. cwd is deliberately not evidence: workspace ids restart at
                max(restored)+1 (src/workspace.rs:151), so a fresh pane can get a recycled
                pane id *and* the same cwd; it never gets our label;
    'reused'    a new terminal without the label: the pane id was handed to something else;
    'unknown'   either side has no terminal id (legacy entries) — callers fail closed.
    """
    ours, now = entry.get("terminal_id"), info.get("terminal_id")
    if not ours or not now:
        return "unknown"
    if ours == now:
        return "same"
    return "restarted" if carries_sleep_label(info) else "reused"


def orphan_key(container: dict, uuid: str) -> str:
    key = "orphan:" + uuid[:8]
    if key in container and (container[key] or {}).get("uuid") != uuid:
        key += "-" + hashlib.sha1(uuid.encode()).hexdigest()[:6]
    return key


def is_orphan(key: str, entry: dict) -> bool:
    """Orphans are never auto-woken; a hand-made `orphan:` key counts whatever its phase says."""
    return (str(key).startswith("orphan:") or entry.get("phase") == "orphaned"
            or str(entry.get("pane_id") or "").startswith("orphan:"))


def orphan_entry(journal: dict, pane: str, reason: str) -> str:
    """Re-key an entry out of the pane namespace (its pane id now belongs to something else).

    Keeps every field, so `list` still prints the manual resume line; one event, then
    silence (focus hooks and reconcile look up pane ids, which an orphan key never is).
    """
    entry = journal.pop(pane)
    entry.pop("seen_running", None)
    key = orphan_key(journal, entry["uuid"])
    journal[key] = {**entry, "phase": "orphaned", "orphaned_from": pane, "orphan_reason": reason,
                    "orphaned_at": dt.datetime.now().isoformat(timespec="seconds")}
    say(f"orphaned {pane} as {key}: {reason}; resume by hand: {manual_command(entry)}")
    event("orphaned", pane=pane, key=key, name=entry.get("name"), uuid=entry["uuid"], reason=reason)
    return key


WAKING_FIELDS = ("waking_pid", "waking_at")


def waking_alive(entry: dict) -> bool | None:
    """Is the process that took a `waking` row still the stub, or the session it exec'd into?

    exec keeps the pid, so one pid covers both. True: its argv is our stub for this pane and
    uuid, or selects the uuid (the resumed agent). False: gone, or the pid now runs something
    else (reused). None: ps could not tell — callers treat that like alive (refuse, keep).
    """
    pid = entry.get("waking_pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False  # exists, but another user's: not our stub or agent
    except OSError:
        return None
    try:
        out = subprocess.run([PS, "-p", str(pid), "-o", "args="], capture_output=True, text=True,
                             timeout=10, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    toks = out.split()
    if not toks:
        return False
    uuid = entry.get("uuid") or ""
    i = stub_argv_index(toks)
    if i is not None:
        return toks[i + 2:i + 4] == [entry.get("pane_id"), uuid]
    return any(t == uuid or t.endswith("=" + uuid) for t in toks[1:])


def put_back(journal: dict, pane: str, row: dict, why: str) -> None:
    """Return a woken-but-not-running row to `asleep` under pane. Never `setdefault`: if the
    pane's row now names another session, ours goes to an orphan key instead of vanishing."""
    back = {k: v for k, v in row.items() if k not in WAKING_FIELDS and k != "resume_reported"}
    back["phase"] = "asleep"  # the stub released the pane before its exec: Herdr dropped our resume command
    cur = journal.get(pane)
    if isinstance(cur, dict) and cur.get("uuid") != row["uuid"]:
        key = orphan_key(journal, row["uuid"])
        journal[key] = {**back, "phase": "orphaned", "orphaned_from": pane, "orphan_reason": why,
                        "orphaned_at": dt.datetime.now().isoformat(timespec="seconds")}
        say(f"{pane} now holds {cur.get('uuid')}; {row['uuid']} kept as {key}: {why}")
        event("orphaned", pane=pane, key=key, name=row.get("name"), uuid=row["uuid"], reason=why)
    else:
        journal[pane] = back


def snapshot_argv(kind: str, argv: object) -> list[str] | None:
    """What panes.json keeps of an argv: only what a wake would replay (claude), else nothing.
    Raw argv can carry an initial prompt or option values; it never reaches the disk."""
    if not PROFILES.get(kind, {}).get("argv_after_binary") or not isinstance(argv, list):
        return None
    return replayable_argv([str(a) for a in argv])[0]


def native_resume(argv: list[str] | None, uuid: str) -> bool:
    """Is this the argv Herdr's own restore starts a session with (`claude --resume <uuid>`, nothing
    else)? Native restore drops every flag the session was started with; the snapshot still has them."""
    return argv == ["--resume", uuid]


def inherits_flags(prior: object, uuid: str, argv: list[str] | None, terminal_id: object,
                   pid: object) -> bool:
    """May a bare `--resume <uuid>` keep the flags panes.json recorded (`prior`: the pane's row)?

    Only when it is Herdr's own restore, and the evidence for that is a new terminal: Herdr
    re-allocates every terminal id on restore (src/persist/restore.rs:574). The same bare form in
    the terminal that already ran the session is someone resuming it by hand without flags (to drop
    --dangerously-skip-permissions, say): what runs is what counts there. Once inherited, the row
    carries `flags_inherited` with the pid it was decided for, so later looks at the restored
    session keep the flags, until another process runs the bare form in that terminal (an unknown
    pid on either side keeps them: losing the flags is the worse mistake).
    """
    if not native_resume(argv, uuid) or not isinstance(prior, dict) or prior.get("uuid") != uuid \
            or not isinstance(prior.get("argv"), list):
        return False
    then = prior.get("terminal_id")
    if then and terminal_id and then != terminal_id:
        return True
    if not prior.get("flags_inherited"):
        return False
    was = prior.get("inherited_pid")
    return was is None or pid is None or was == pid


def snapshot_row(pane: str) -> dict | None:
    """panes.json's row for this pane, or None (no row, unreadable snapshot)."""
    try:
        row = read_json(SNAPSHOT).get(pane)
    except SleeperError:
        return None
    return row if isinstance(row, dict) else None


def merge_snapshot(agents: list[dict]) -> None:
    """pane→uuid→argv for every supported pane, merged so that panes currently asleep keep their handle.

    A pane now running a different session retires the old row: dropped when it is the same
    terminal (a deliberate replacement), kept under an `orphan:` key when the pane id was reused.
    A session Herdr restored natively (bare `--resume <uuid>` in a new terminal) keeps the flags the
    row already had; see inherits_flags.
    """
    snap = read_json(SNAPSHOT)
    live = {a["pane_id"]: a for a in agents}

    def retire(pane: str) -> None:
        row = snap.pop(pane)
        if isinstance(row, dict) and row.get("uuid") and (
                not row.get("terminal_id") or row.get("terminal_id") != live[pane].get("terminal_id")):
            snap[orphan_key(snap, row["uuid"])] = {**row, "pane_id": pane, "orphaned_from": pane}

    for a in agents:
        kind = a.get("agent")
        if kind not in PROFILES:
            continue
        uuid = (a.get("agent_session") or {}).get("value")
        if not uuid:
            continue
        prior = snap.get(a["pane_id"]) or {}
        if isinstance(prior, dict) and prior.get("uuid") and prior.get("uuid") != uuid:
            retire(a["pane_id"])
            prior = {}
        present, argv, pid = agent_process(a["pane_id"], kind)
        inherited: dict = {}
        if argv is None and present is None and prior.get("uuid") == uuid:
            argv = prior.get("argv")  # process-info hiccup: keep what we knew rather than erase it
            inherited = {k: prior[k] for k in ("flags_inherited", "inherited_pid") if k in prior}
        elif inherits_flags(prior, uuid, argv, a.get("terminal_id"), pid):
            argv = prior["argv"]  # Herdr restored it as a bare `--resume`: the flags it ran with are still ours
            inherited = {"flags_inherited": True, "inherited_pid": pid if pid is not None else prior.get("inherited_pid")}
        argv = snapshot_argv(kind, argv)
        snap[a["pane_id"]] = {
            "kind": kind, "uuid": uuid, "name": a.get("name"), "cwd": a.get("cwd"),
            "title": a.get("terminal_title_stripped"), "argv": argv,
            "terminal_id": a.get("terminal_id"),
            "seen_at": dt.datetime.now().isoformat(timespec="seconds"),
            **inherited,
        }
    for pane in list(snap):  # a live pane whose agent (of any kind) runs another session
        now = ((live.get(pane) or {}).get("agent_session") or {}).get("value")
        if now and isinstance(snap[pane], dict) and snap[pane].get("uuid") != now:
            retire(pane)
    for row in snap.values():  # rows written by earlier versions held the raw argv
        if isinstance(row, dict) and row.get("argv") is not None:
            row["argv"] = snapshot_argv(str(row.get("kind") or "claude"), row["argv"])
    write_json(SNAPSHOT, snap)


def wake_name(entry: dict) -> str:
    return entry.get("name") or "wake-" + entry["pane_id"].replace(":", "-")


# --------------------------------------------------------------- assessment

SLEEPABLE_STATUSES = {"idle", "done"}
DRY_RUN_OUTCOME = "would sleep (dry run)"


def assess(agent: dict, all_agents: list[dict], idle_hours: float, journal: dict,
           exclude: set[str] | None = None, idle_since: float | None = None,
           allow_focused: bool = False, restart: bool = False) -> tuple[bool, str, float | None]:
    """Decide whether one agent may be slept. Returns (ok, reason, idle_hours).

    The idle clock itself lives in the watcher (seq movement); `idle_since`
    is the wall-clock start (time.time()) of this pane's current idle
    stretch. Manual `sleep-pane` passes idle_since=None to skip the window,
    and allow_focused=True: an explicit request may sleep the focused pane.
    restart=True: a sleep that is woken at once onto a new build, which an
    insomnia claim does not stop (a restart is not a sleep).
    """
    pane = agent["pane_id"]
    kind = agent.get("agent")
    if exclude and (pane in exclude or agent.get("name") in exclude):
        return False, "excluded", None
    if pane in journal:
        return False, f"already in sleep journal ({journal[pane].get('phase', 'asleep')})", None
    if kind not in PROFILES:
        return False, f"agent kind {kind!r} not supported", None
    uuid = (agent.get("agent_session") or {}).get("value")
    if not uuid:
        return False, "no session uuid (cannot resume)", None
    if not valid_session_id(uuid):
        return False, "session id has an unexpected shape (refusing to use it in a glob or argv)", None
    if not restart:
        held = insomnia_reason(uuid, pane, agent.get("terminal_id"))
        if held:
            return False, held, None
    # A restarted claude pane loses its Herdr name; the Claude session name and the title it sets survive.
    if exclude and kind == "claude" and (agent.get("terminal_title_stripped") in exclude
                                         or claude_session_name(transcript_for(uuid)) in exclude):
        return False, "excluded", None
    if not allow_focused and agent.get("focused") is not False:  # missing/None must not read as "not focused"
        return False, "pane is focused (or focus unknown)", None
    status = agent.get("agent_status")
    if status not in SLEEPABLE_STATUSES:
        return False, f"status {status}", None
    others = [a for a in all_agents if a["pane_id"] != pane and (a.get("agent_session") or {}).get("value") == uuid]
    if others:
        return False, f"session also open in {', '.join(a['pane_id'] for a in others)}", None
    if kind == "claude" and transcript_for(uuid) is None:
        return False, "no transcript on disk (nothing to resume)", None
    if pending_mail(uuid):
        return False, "mail pending (delivered once the agent is idle)", None
    if idle_since is not None:
        idle = (time.time() - idle_since) / 3600
        if idle < idle_hours:
            return False, f"idle {idle:.1f}h < {idle_hours:g}h", idle
        return True, f"idle {idle:.1f}h", idle
    return True, "manual", None


def recheck(agent: dict, idle_hours: float, journal: dict, exclude: set[str],
            idle_since: float | None = None, allow_focused: bool = False,
            restart: bool = False) -> tuple[str | None, dict | None]:
    """Re-run every check against live state right before acting. Returns (reason_to_stop, live_agent)."""
    fresh = {a["pane_id"]: a for a in list_agents() if a.get("agent")}
    now = fresh.get(agent["pane_id"])
    if now is None:
        return "agent gone", None
    if now.get("state_change_seq") != agent.get("state_change_seq"):
        return f"state changed since scan ({agent.get('agent_status')} → {now.get('agent_status')})", now
    if (now.get("agent_session") or {}).get("value") != (agent.get("agent_session") or {}).get("value"):
        return "session changed since scan", now
    ok, reason, _ = assess(now, list(fresh.values()), idle_hours, journal, exclude, idle_since, allow_focused,
                           restart)
    if not ok:
        return reason, now
    profile = PROFILES.get(now.get("agent"), {})
    if profile.get("idle_guards"):
        busy = busy_reason(now)
        if busy:
            return busy, now
    elif profile.get("exit") == "prompt":
        state, detail = composer_state(herdr_screen(agent["pane_id"]))
        if state != "empty":
            return f"composer {state}: {detail}", now
    return None, now


# ----------------------------------------------------------------- sidebar

RESUME_MAX_ARGS = 64          # Herdr's validate_resume_argv (src/agent_resume.rs:58), mirrored
RESUME_MAX_BYTES = 8192
RESUME_CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")   # Rust char::is_control: the Cc category
PLAIN_COMMAND = re.compile(r"[A-Za-z0-9_.-]+")


def resume_argv_problem(argv: list[str]) -> str | None:
    """Why Herdr would refuse this as a reported resume command, or None. Checked before sending,
    so a refusal is logged with its reason instead of costing a round trip and the claim."""
    if not argv:
        return "empty"
    if len(argv) > RESUME_MAX_ARGS:
        return f"more than {RESUME_MAX_ARGS} arguments"
    if sum(len(a.encode()) for a in argv) > RESUME_MAX_BYTES:
        return f"more than {RESUME_MAX_BYTES} bytes"
    if any(RESUME_CONTROL.search(a) for a in argv):
        return "control characters"
    if any("'" in a for a in argv):
        return "an apostrophe (Herdr quotes POSIX-style)"
    if not PLAIN_COMMAND.fullmatch(argv[0]) or argv[0].startswith("-"):
        return "the first element is not a plain command name"
    return None


def claim(pane: str, kind: str, done: bool = False, resume: list[str] | None = None) -> bool:
    """Keep the slept pane's sidebar row: report a placeholder agent we own. Best effort; True when
    the pane is claimed afterwards. See claim_reporting."""
    return claim_reporting(pane, kind, done, resume)[0]


def claim_reporting(pane: str, kind: str, done: bool = False,
                    resume: list[str] | None = None) -> tuple[bool, bool]:
    """claim(), answering (claimed, resume command accepted by Herdr).

    `done` (finished, unviewed) is carried into the label so sleeping does not hide that cue.
    `resume`: the wake stub's argv (stub_argv), passed only when the stub runs in the pane. Herdr
    saves a reported resume command with the pane and types it into the restored shell after a
    server restart, so the stub comes back with the pane; it drops the command when we release the
    pane (every wake does) or another agent takes it. A command Herdr would refuse, or a refusal
    (`resume_not_accepted`, `invalid_resume_argv`, a pre-0.9.2 Herdr), falls back to the plain claim
    and logs `resume-not-reported`: the pane then comes back as a shell that wakes on focus.
    """
    report = ("pane", "report-agent", pane, "--source", CLAIM_SOURCE, "--agent", CLAIM_AGENT, "--state", "unknown")
    with contextlib.suppress(SleeperError):
        sent = False
        if resume:
            why = resume_argv_problem(resume)
            if why is None:
                try:
                    herdr(*report, "--", *resume)
                    sent = True
                except SleeperError as exc:
                    why = f"{getattr(exc, 'code', None) or 'error'}: {exc}"
            if not sent:
                say(f"WARN {pane}: resume command not reported ({why}); after a Herdr restart the pane comes "
                    "back as a shell that wakes on focus")
                event("resume-not-reported", pane=pane, reason=why[:200])
        if not sent:
            herdr(*report, check=False)
        herdr("pane", "report-metadata", pane, "--source", "herdr-sleeper",
              "--display-agent", f"{kind} · sleeping" + (" · done" if done else ""), check=False)
        return herdr("pane", "get", pane, check=False).get("pane", {}).get("agent") == CLAIM_AGENT, sent
    return False, False


def release(pane: str) -> None:
    """Drop the claim; must precede any agent start in the pane (a stale claim outranks detection)."""
    with contextlib.suppress(SleeperError):
        herdr("pane", "release-agent", pane, "--source", CLAIM_SOURCE, "--agent", CLAIM_AGENT, check=False)
        herdr("pane", "report-metadata", pane, "--source", "herdr-sleeper",
              "--clear-display-agent", check=False)


def claimed(entry: dict, pane_info: dict | None) -> bool:
    """Is this pane's reported agent our own placeholder?"""
    return bool(pane_info) and pane_info.get("agent") == CLAIM_AGENT


def restore_label(pane: str, entry: dict, current: str | None) -> None:
    """Put back the label the pane had before sleeping; clear our 💤 label if it had none."""
    if entry.get("label"):
        herdr("pane", "rename", pane, entry["label"], check=False)
    elif current and current.startswith(SLEEP_MARK):
        herdr("pane", "rename", pane, "--clear", check=False)  # bare `rename <pane>` is a usage error (verified)


# -------------------------------------------------------------------- sleep

def sleep_agent(agent: dict, idle_hours: float, exclude: set[str], dry_run: bool,
                idle_since: float | None = None, allow_focused: bool = False,
                notify_enabled: bool = True, restart: bool = False) -> tuple[bool, str]:
    """Try to sleep one agent. Returns (slept, outcome). Caller holds the lock.

    allow_focused: an explicit request may sleep the focused pane (threaded
    through to the final recheck, which re-reads `focused` live); it still has
    to be idle. restart: restart_onto_new_build's sleep, which wakes at once
    (an insomnia claim does not stop it).
    """
    pane = agent["pane_id"]
    kind = agent.get("agent")
    profile = PROFILES.get(kind)
    if profile is None:
        return False, f"agent kind {kind!r} not supported"
    uuid = (agent.get("agent_session") or {}).get("value")
    if not uuid:
        return False, "no session uuid (cannot resume)"
    if not valid_session_id(uuid):
        return False, "session id has an unexpected shape (refusing to use it in a glob or argv)"

    replay: list[str] = []
    if profile["argv_after_binary"]:
        _present, raw_argv, pid = agent_process(pane, kind)
        if raw_argv is None:
            return False, "could not read agent argv from pane"
        replay, why = replayable_argv(raw_argv)
        if replay is None:
            return False, why or "argv not replayable"
        row = snapshot_row(pane)
        if row is not None and inherits_flags(row, uuid, raw_argv, agent.get("terminal_id"), pid):
            # restored by Herdr after a restart with no flags; wake it with the ones it was started with
            replay = replayable_argv([str(a) for a in row["argv"]])[0] or replay

    journal = read_json(JOURNAL)
    held = journal.get(pane)
    if isinstance(held, dict) and held.get("uuid") != uuid:
        # sleep-pane skips assess: never write over a handle kept for another session (displaced,
        # wake_pending, waking); the same uuid (an exit-requested retry) may be rewritten
        return False, (f"refused: pane holds a kept handle for {held.get('uuid')} ({held.get('phase', 'asleep')}); "
                       "wake or resolve it first")
    if dry_run:  # no event: the dry-run watcher asks this every tick; its log records changes only
        stop, _ = recheck(agent, idle_hours, journal, exclude, idle_since, allow_focused, restart)
        if stop:
            return False, f"refused: {stop}"
        return False, DRY_RUN_OUTCOME
    # A `deliver` holds the session's mailbox lock while it types into the agent, and takes the
    # global lock after it (to wake): waiting here, under the global lock, could deadlock. Held
    # until the stub is in place, so mail is never typed into a pane mid-exit; pending mail is
    # re-checked under it (recheck -> assess).
    with mailbox_lock(uuid, wait=False) as free:
        if not free:
            return False, "refused: a message to this session is being delivered"
        return _sleep_transaction(agent, profile, replay, idle_hours, exclude, idle_since, allow_focused,
                                  notify_enabled, restart)


def _sleep_transaction(agent: dict, profile: dict, replay: list[str], idle_hours: float, exclude: set[str],
                       idle_since: float | None, allow_focused: bool, notify_enabled: bool,
                       restart: bool = False) -> tuple[bool, str]:
    """sleep_agent past its checks: journal, last recheck, exit, stub. Caller holds both locks."""
    pane, kind = agent["pane_id"], agent.get("agent")
    uuid = agent["agent_session"]["value"]
    pane_info = herdr("pane", "get", pane).get("pane", {})
    label = pane_info.get("label") or None
    if label and label.startswith(SLEEP_MARK):
        label = label[len(SLEEP_MARK):] or None
    freed_mb = rss_mb(pane)
    entry = {
        "pane_id": pane, "workspace_id": agent.get("workspace_id"), "tab_id": agent.get("tab_id"),
        "terminal_id": agent.get("terminal_id") or pane_info.get("terminal_id"),
        "name": agent.get("name"), "label": label, "title": agent.get("terminal_title_stripped"),
        "cwd": agent.get("cwd"), "uuid": uuid, "kind": kind,
        "argv": replay, "slept_at": dt.datetime.now().isoformat(timespec="seconds"),
        "status": agent.get("agent_status"), "phase": "exit-requested",
        "claude_name": claude_session_name(transcript_for(uuid)) if kind == "claude" else None,
    }
    name = wake_name(entry)

    # 1. journal first, under the lock, re-read: if anything below fails the handle still exists.
    journal = read_json(JOURNAL)
    journal[pane] = entry
    write_json(JOURNAL, journal)

    # 2. the last look before acting — after the journal write, so nothing happens between
    #    check and act but the exit itself. Targets the pane id: names can be renamed under us.
    stop, _ = recheck(agent, idle_hours, {k: v for k, v in journal.items() if k != pane}, exclude, idle_since,
                      allow_focused, restart)
    if stop:
        journal = read_json(JOURNAL)
        journal.pop(pane, None)
        write_json(JOURNAL, journal)
        event("refused", pane=pane, name=name, uuid=uuid, reason=stop)
        return False, f"refused: {stop}"

    # 3. the exit itself. A signal discards composer drafts instead of submitting them;
    #    a typed command is only used for kinds whose composer we positively verified empty.
    how = "signal"
    helpers: dict[int, str] = {}
    if profile["exit"] == "signal":
        present, _argv, pid = agent_process(pane, kind)
        table = process_table()
        why = ("agent process not identifiable for signal" if present is not True or not pid
               else signalable(pid, kind, table))
        if why:
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            event("refused", pane=pane, name=name, uuid=uuid, reason=why)
            return False, f"refused: {why}"
        # direct children only: they are reparented to init once the agent exits (reaped below);
        # grandchildren keep their own parent, which the reap stops or leaves to its own shutdown
        helpers = {child: comm for child, (parent, comm) in table.items() if parent == int(pid)}
        freed_mb = freed_mb or rss_mb(pane)
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (OSError, ValueError) as exc:
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            event("refused", pane=pane, name=name, uuid=uuid, reason=f"signal failed: {exc}")
            return False, f"refused: signal failed: {exc}"
        how = f"SIGTERM to pid {pid}"
    else:
        herdr("agent", "prompt", pane, profile["exit_command"], check=False)
        how = f"typed {profile['exit_command']!r}"

    # 4. "gone" needs positive evidence: Herdr no longer lists the agent AND no agent process.
    deadline = time.monotonic() + EXIT_WAIT_SECONDS
    gone = False
    while time.monotonic() < deadline:
        time.sleep(1)
        pane_now = herdr("pane", "get", pane, check=False).get("pane")
        present, _argv, _pid = agent_process(pane, kind)
        if isinstance(pane_now, dict) and "agent" not in pane_now and present is False:
            gone = True
            break
    if not gone:
        # A timeout is not proof the exit failed; keep the handle and let the next tick reconcile.
        say(f"WARN {pane}: agent still present {EXIT_WAIT_SECONDS}s after exit; entry kept as exit-requested")
        event("exit-uncertain", pane=pane, name=name, uuid=uuid)
        return False, "exit uncertain; will reconcile next tick"

    time.sleep(1)  # let the agent's own shutdown stop its children first
    reaped = reap_helpers(helpers)

    # 5. reset terminal modes, claim the sidebar row, leave the Enter-stub, mark the label, notify.
    #    The stub runs as a child of the pane's shell (no `exec` — the shell must survive beneath
    #    it, or the pane would close when the woken agent exits). The pane shell has none of the
    #    plugin env, so the typed command carries the stub's own routing (see stub_command). It is
    #    typed only at a bare shell; otherwise the pane sleeps without one ("stub": false) and
    #    focus or `wake` resume it with `agent start` once the pane is back at its shell.
    at_shell = pane_at_shell(pane) is True
    journal = read_json(JOURNAL)
    if pane in journal:
        journal[pane].update(phase="asleep", stub=at_shell)
        write_json(JOURNAL, journal)
    if at_shell:
        herdr("pane", "run", pane, stub_command(pane, uuid, entry["slept_at"]), check=False)
    else:
        say(f"WARN {pane}: the pane's foreground is not its shell after the exit; asleep without a wake stub")
    herdr("pane", "rename", pane, SLEEP_MARK + (label or entry["title"] or name), check=False)
    time.sleep(2)  # herdr takes ~2s to drop the exited agent's session; the claim is ignored before that
    # the stub's argv goes along as the pane's resume command only when it was typed: a restart
    # must not start a stub in a pane that never had one (focus and `wake` cover those)
    _claimed, reported = claim_reporting(pane, kind, done=entry["status"] == "done",
                                         resume=stub_argv(pane, uuid) if at_shell else None)
    if at_shell:
        # Herdr's saved resume command cannot be read back: the row says whether it holds ours, so
        # reconcile can report it again to a pane that has the stub but not the command
        journal = read_json(JOURNAL)
        if isinstance(journal.get(pane), dict) and journal[pane].get("uuid") == uuid:
            journal[pane]["resume_reported"] = reported
            write_json(JOURNAL, journal)
    event("slept", pane=pane, name=name, uuid=uuid, kind=kind, title=entry["title"], cwd=entry["cwd"],
          freed_mb=freed_mb or None, how=how, stub=at_shell, helpers_stopped=reaped or None)
    notify(f"{SLEEP_MARK}slept {name}", f"freed ~{freed_mb} MB · wake: focus the pane, press Enter, or "
            f"{shlex.join([str(SELF), 'wake', name])}", enabled=notify_enabled)
    return True, "slept"


# ------------------------------------------------------------------- stub

def stub_command(pane: str, uuid: str, slept_at: str) -> str:
    """The line typed into a slept pane's shell: reset modes, a banner, then the wake stub.

    POSIX-shell text with no control bytes (escapes are printf's), and `env` for the
    routing — the session's socket, the herdr binary, the session name — so it does not
    depend on the shell's assignment-prefix syntax. HERDR_CLIENT_SOCKET_PATH is left
    out: the CLI routes by HERDR_SOCKET_PATH (src/session.rs), and an inherited client
    socket could belong to an outer session.
    """
    banner = SLEEP_MARK + "slept by herdr-sleeper " + slept_at
    return (f"printf '{MODE_RESET_PRINTF}'; clear; printf '%s\\n' {shlex.quote(banner)}; "
            + shlex.join(stub_argv(pane, uuid)))


def stub_argv(pane: str, uuid: str) -> list[str]:
    """The wake stub as an argv: what stub_command types, and the resume command claim reports to
    Herdr so a restart brings the stub back. `env` comes first because Herdr's restore wants a
    plain command name there; the script stays an absolute path behind it (a PATH lookup could find
    another copy, and stub_argv_index matches the script by its basename either way)."""
    env_args = [f"{var}={os.environ[var]}" for var in ("HERDR_SOCKET_PATH", "HERDR_BIN_PATH") if os.environ.get(var)]
    env_args.append(f"HERDR_SESSION={SESSION}")
    return ["env", *env_args, str(SELF), "stub", pane, uuid, str(STATE_DIR)]


def set_state_dir(state_dir: Path) -> None:
    """Point every state path at state_dir (the stub inherits no plugin env; the sleep side types it)."""
    global STATE_DIR, JOURNAL, SNAPSHOT, EVENTS, LOGFILE, LOCK, WATCHER_PID, WATCHER_LOCK, IDLE_FILE, STOPPED
    global MAILBOX, DELIVERED, WATCHER_MISSING
    STATE_DIR = state_dir
    JOURNAL, SNAPSHOT, EVENTS = STATE_DIR / "sleeping.json", STATE_DIR / "panes.json", STATE_DIR / "events.jsonl"
    LOGFILE, LOCK, WATCHER_PID = STATE_DIR / "sleeper.log", STATE_DIR / "lock", STATE_DIR / "watcher.pid"
    WATCHER_LOCK, IDLE_FILE, STOPPED = STATE_DIR / "watcher.lock", STATE_DIR / "idle.json", STATE_DIR / "stopped"
    MAILBOX, DELIVERED = STATE_DIR / "mailbox", STATE_DIR / "delivered.json"
    WATCHER_MISSING = STATE_DIR / "watcher-missing"


def cmd_stub(pane: str, uuid: str, state_dir: str | None = None) -> int:
    """The in-pane wake stub: waits for a bare Enter, then execs the agent back into its session.

    Runs inside the pane's shell with none of the plugin env; the sleep side
    therefore types the routing (socket, session, state dir) into the command
    line itself. A typed line that is not empty is not a wake request (an
    orchestrator's `pane run` must not be eaten): it is echoed back and the stub
    keeps waiting. Ctrl-C or EOF leaves a plain shell and prints the manual
    resume command.

    The journal row is never popped here. Under the lock, after the last
    checks (liveness included), it becomes `waking` with this pid — exec keeps
    the pid, so it names the resumed agent afterwards. Every other wake path
    refuses a `waking` row whose pid is alive; reconcile drops it once the
    session is seen running in the pane (and gives the agent its name back),
    or puts it back to `asleep` if the pid died first. Anything that stops us
    before the exec (ctrl-c, a failed Herdr call, the exec itself) puts it back
    at once.
    """
    global HERDR_BIN
    HERDR_BIN = os.environ.get("HERDR_BIN_PATH") or "herdr"
    if state_dir:
        set_state_dir(Path(state_dir))
    journal = read_json(JOURNAL)
    entry = journal.get(pane) or {}
    if entry.get("uuid") != uuid or not valid_entry(entry):
        print(f"herdr-sleeper: no journal entry for {uuid} in {pane}; type `exit` or start an agent by hand")
        return 0
    kind = entry.get("kind") or "claude"
    name = wake_name(entry)
    print(f"\n  {SLEEP_MARK}{entry.get('title') or name} — slept {entry.get('slept_at', '?')}")
    print("  press Enter to resume (ctrl-c leaves a plain shell)\n")
    while True:
        try:
            line = input()
        except (EOFError, KeyboardInterrupt):
            release(pane)
            print(f"left as a shell; resume with: {manual_command(entry)}")
            return 0
        if not line.strip():
            break
        print(f"herdr-sleeper: ignored {line.strip()[:60]!r} — this pane is asleep. "
              "Press Enter alone to resume, ctrl-c for a plain shell.")

    def refuse(why: str, drop_claim: bool = False) -> int:
        if drop_claim:
            release(pane)
        print(f"herdr-sleeper: {why}; left asleep.\n  manual: {manual_command(entry)}")
        return 0

    binary = shutil.which(kind)
    if not binary:
        return refuse(f"`{kind}` is not on this shell's PATH (focus the pane or use `wake`: "
                      "Herdr starts it with its own environment)")
    extra: list[str] = []
    if PROFILES.get(kind, {}).get("argv_after_binary"):
        if entry.get("argv") is None:
            return refuse("original argv unknown; refusing to invent one")
        extra, why = replayable_argv(entry["argv"])  # a crash-recovered snapshot argv was never vetted
        if extra is None:
            return refuse(why or "argv not replayable")
    argv = resume_argv(kind, uuid, extra or None)
    if argv is None:
        return refuse(f"no resume recipe for {kind}", drop_claim=True)
    if kind == "claude" and transcript_for(uuid) is None:
        return refuse(f"the transcript for {uuid} is gone (nothing to resume)")
    if entry.get("cwd") and not same_dir(os.getcwd(), entry["cwd"]):
        return refuse(f"pane cwd is {os.getcwd()}, slept-in {entry['cwd']}", drop_claim=True)
    with locked():
        journal = read_json(JOURNAL)
        cur = journal.get(pane) or {}
        if cur.get("uuid") != uuid or cur.get("phase", "asleep") != "asleep":
            print("herdr-sleeper: the journal entry changed while waiting (woken elsewhere?); left as a shell")
            return 0
        where = uuid_live_elsewhere(uuid, except_pane=pane, cwd=cur.get("cwd"))  # raises when it cannot tell
        if where:
            print(f"herdr-sleeper: session is already live in {where}; left as a shell.\n"
                  f"  manual: {manual_command(cur)}")
            return 0
        journal[pane] = {**cur, "phase": "waking", "waking_pid": os.getpid(),
                         "waking_at": dt.datetime.now().isoformat(timespec="seconds")}
        write_json(JOURNAL, journal)
    try:
        release(pane)  # must precede the agent: a stale claim outranks detection
        restore_label(pane, cur, (herdr("pane", "get", pane, check=False).get("pane") or {}).get("label"))
        event("woke", pane=pane, name=name, uuid=uuid, via="stub", slept_at=cur.get("slept_at"))
        with contextlib.suppress(OSError, termios.error, ValueError):
            termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)  # keys typed while waking must not reach the composer
        os.execvp(binary, [kind, *argv])
    except (Exception, KeyboardInterrupt) as exc:  # anything before the exec took: the row goes back at once
        with locked():
            journal = read_json(JOURNAL)
            put_back(journal, pane, cur, f"stub could not start {binary}: {exc!r}")
            write_json(JOURNAL, journal)
        claim(pane, kind, done=cur.get("status") == "done")
        herdr("pane", "rename", pane, SLEEP_MARK + (cur.get("label") or cur.get("title") or name), check=False)
        event("wake-failed", pane=pane, name=name, uuid=uuid, via="stub", reason=repr(exc))
        print(f"herdr-sleeper: could not start {binary} ({exc!r}); left asleep.\n  manual: {manual_command(cur)}")
        return 1
    return 0  # unreachable in production: execvp replaces the process


# ------------------------------------------------------------------- wake

DELEGATED = "delegated"  # wake_entry: Enter went to the pane's own stub; the caller confirms outside the lock


def drop_row(journal: dict, pane: str, uuid: str) -> None:
    """Remove the pane's row once its session is live again — only if it still names that session:
    the caller's entry may be older than the journal (a pane slept again under another session)."""
    if isinstance(journal.get(pane), dict) and journal[pane].get("uuid") == uuid:
        journal.pop(pane)
        write_json(JOURNAL, journal)


def wake_entry(entry: dict, via: str = "command", key: str | None = None) -> bool | str:
    """Wake one journaled pane via `agent start`. Caller holds the lock; the entry is persisted.

    `key` is the journal key when the caller has it: an `orphan:` key makes the entry an
    orphan whatever its body says. Returns True (woken), False (refused or failed; the entry
    is kept, re-keyed, or settling), or DELEGATED when the pane's stub was asked to do it
    (see await_stub_wake).
    """
    if not valid_entry(entry):
        raise SleeperError(f"malformed journal entry: {json.dumps(entry)[:120]}")
    pane = entry["pane_id"]
    name = wake_name(entry)
    uuid = entry["uuid"]
    kind = entry["kind"]
    if is_orphan(key or pane, entry):
        say(f"cannot wake {name}: orphaned (its pane id was reused); resume by hand: {manual_command(entry)}")
        return False
    if entry.get("phase") == "displaced":
        say(f"cannot wake {name}: its pane now holds session {entry.get('wake_got')}; recover by hand: {manual_command(entry)}")
        return False
    if entry.get("phase") == "waking":
        alive = waking_alive(entry)
        if alive is not False:  # the stub (or the agent it became) is on it; reconcile settles the row
            say(f"cannot wake {name}: a wake is already in progress in {pane} (pid {entry.get('waking_pid')}"
                f"{'' if alive else ', not verifiable'}); entry kept")
            return False
        entry = {k: v for k, v in entry.items() if k not in WAKING_FIELDS}  # the stub died: an asleep row
    extra: list[str] = []
    if PROFILES.get(kind, {}).get("argv_after_binary"):
        if entry.get("argv") is None:
            say(f"cannot wake {name}: original argv unknown; refusing to invent one. Manual: {manual_command(entry)}")
            return False
        extra, why = replayable_argv(entry["argv"])
        if extra is None:
            say(f"cannot wake {name}: {why}; entry kept. Manual: {manual_command(entry)}")
            return False
    argv = resume_argv(kind, uuid, extra or None)
    if argv is None:
        say(f"cannot wake {name}: no resume recipe for {kind}; entry kept. Manual: {manual_command(entry)}")
        return False
    pane_info = herdr("pane", "get", pane, check=False).get("pane")
    if not pane_info:
        say(f"cannot wake {name}: pane {pane} no longer exists; entry kept. Manual: {manual_command(entry)}")
        return False
    if claimed(entry, pane_info):
        release(pane)  # our own placeholder; the real checks below run on the shell left behind
        pane_info = herdr("pane", "get", pane, check=False).get("pane") or {}
    ident = identity(entry, pane_info)
    if "agent" in pane_info and pane_info.get("agent") != CLAIM_AGENT:
        running = (pane_info.get("agent_session") or {}).get("value")
        if running == uuid and agent_process(pane, kind)[0] is True:
            if entry.get("phase") == "exit-requested":
                # one sighting could be Herdr lagging a slow exit; reconcile's two-sighting rule decides
                say(f"{name}: exit still settling in {pane}; leaving the entry to reconcile")
                return False
            say(f"{name}: session {uuid} is already running in {pane}; clearing journal entry")
            restore_label(pane, entry, pane_info.get("label"))
            drop_row(read_json(JOURNAL), pane, uuid)
            return True
        if running and running != uuid and ident != "same" and not (entry.get("wake_got") or entry.get("wake_pending")):
            journal = read_json(JOURNAL)
            if pane in journal:
                orphan_entry(journal, pane, f"pane id now runs session {running} in another terminal")
                write_json(JOURNAL, journal)
            return False
        say(f"cannot wake {name}: pane {pane} still shows an agent (session {running}); entry kept")
        return False
    if ident == "unknown" and not carries_sleep_label(pane_info):
        # a legacy entry with no terminal id on record: our 💤 label is the only pane evidence left
        ident = "reused"
    if ident == "reused":
        journal = read_json(JOURNAL)
        if pane in journal:
            orphan_entry(journal, pane, f"pane id now belongs to terminal {pane_info.get('terminal_id')} "
                                        f"in {pane_info.get('cwd')}, which does not carry the sleep label")
            write_json(JOURNAL, journal)
        return False
    if agent_process(pane, kind)[0] is not False:
        say(f"cannot wake {name}: cannot confirm pane {pane} is at a bare shell; entry kept")
        return False
    restamp: str | None = None
    if ident == "restarted":
        # Herdr re-allocates terminal ids on restore and re-applies our 💤 label: the same pane. The
        # new id is written only with the pop below — a refused wake must not adopt this terminal.
        restamp = pane_info["terminal_id"]
        say(f"{name}: identity re-established after a Herdr restart (terminal {entry['terminal_id']} -> "
            f"{restamp}, pane still labelled {SLEEP_MARK.strip()})")
        entry = {**entry, "terminal_id": restamp}
    if entry.get("cwd") and pane_info.get("cwd") and not same_dir(pane_info["cwd"], entry["cwd"]):
        # a precondition, not identity evidence: the shell moved; the pane is still ours
        say(f"cannot wake {name}: pane {pane} now lives in {pane_info['cwd']}, journal says {entry['cwd']} "
            f"(cd back, or resume by hand); entry kept. Manual: {manual_command(entry)}")
        event("wake-refused", pane=pane, name=name, uuid=uuid, reason="cwd mismatch")
        return False
    where = uuid_live_elsewhere(uuid, cwd=entry.get("cwd"))  # raises when it cannot tell
    if where:
        say(f"cannot wake {name}: session {uuid} is already live in {where}")
        event("wake-refused", pane=pane, name=name, uuid=uuid, reason=f"live in {where}")
        return False
    if kind == "claude" and transcript_for(uuid) is None:
        say(f"cannot wake {name}: transcript for {uuid} is gone; entry kept. Manual: {manual_command(entry)}")
        return False
    stub = stub_running(pane, uuid)
    if stub is None:
        say(f"cannot wake {name}: cannot tell whether the wake stub runs in {pane}; entry kept")
        return False
    if stub:
        herdr("pane", "send-keys", pane, "enter", check=False)  # let the stub do the exec-wake
        return DELEGATED
    if pane_at_shell(pane) is not True:
        # agent start types the line into the pane: into an editor or a pager it would be keystrokes
        say(f"cannot wake {name}: pane {pane} is not at its bare shell (something else runs in the "
            "foreground); entry kept")
        event("wake-refused", pane=pane, name=name, uuid=uuid, reason="foreground is not the shell")
        return False

    def start(agent_name: str) -> dict:
        return herdr("agent", "start", agent_name, "--kind", kind, "--pane", pane, "--timeout", str(WAKE_TIMEOUT_MS),
                     "--", *argv, timeout=WAKE_TIMEOUT_MS / 1000 + 30)

    result: dict | None = None
    failure = ""
    try:
        result = start(name)
    except SleeperError as exc:
        failure = str(exc)
    fallback = "wake-" + pane.replace(":", "-")
    if result is None and "agent_name_taken" in failure and name != fallback:
        # the name went to another agent while this one slept; one retry under the pane's own name
        say(f"wake {name}: the name is taken now; starting it as {fallback}")
        try:
            result, name = start(fallback), fallback
        except SleeperError as exc:
            failure = str(exc)
    if result is None:
        say(f"wake {name} failed: {failure}; entry kept")
        event("wake-failed", pane=pane, name=name, uuid=uuid, reason=failure)
        return False
    got = ((result.get("agent") or {}).get("agent_session") or {}).get("value")
    for _ in range(WAKE_CONFIRM_SECONDS if got is None else 0):
        time.sleep(1)  # `agent start` can return before the agent reports its session
        got = ((herdr("pane", "get", pane, check=False).get("pane") or {}).get("agent_session") or {}).get("value")
        if got:
            break
    journal = read_json(JOURNAL)
    if got is None:
        if pane in journal:
            journal[pane].update(wake_pending=True, wake_started_at=dt.datetime.now().isoformat(timespec="seconds"),
                                 **({"terminal_id": restamp} if restamp else {}))  # our start runs in this terminal
            write_json(JOURNAL, journal)
        say(f"{name}: started in {pane}, but no session reported within {WAKE_CONFIRM_SECONDS}s; entry kept "
            f"for reconcile (running {uuid} -> dropped after two sightings; anything else -> displaced)")
        event("wake-unconfirmed", pane=pane, name=name, uuid=uuid)
        return False
    if got != uuid:
        # a fresh session took the pane; keep the record so the old one stays reachable.
        if pane in journal:
            journal[pane].update(wake_failed_at=dt.datetime.now().isoformat(timespec="seconds"), wake_got=got,
                                 **({"terminal_id": restamp} if restamp else {}))
            write_json(JOURNAL, journal)
        say(f"WARN {name}: pane now runs session {got}, expected {uuid}; entry kept. Manual: {manual_command(entry)}")
        event("wake-mismatch", pane=pane, name=name, uuid=uuid, got=got)
        return False
    restore_label(pane, entry, pane_info.get("label"))
    drop_row(journal, pane, uuid)
    say(f"woke {name} in {pane} uuid={got} (via {via})")
    event("woke", pane=pane, name=name, uuid=got, via=via, slept_at=entry.get("slept_at"))
    return True


NAME_BACK_SECONDS = 15          # how long a wake outside the lock retries the rename
NAME_OWED_MAX_SECONDS = 3600    # an owed name the watcher could not hand back by then is given up (logged)


def try_rename(pane: str, want: str) -> str:
    """'ok', 'not-yet' (Herdr has not registered the resumed agent: the session id shows on the pane
    before the agent does), or 'refused' (anything else, logged; retrying would not help)."""
    try:
        herdr("agent", "rename", pane, want)
        return "ok"
    except SleeperError as exc:
        if getattr(exc, "code", None) == "agent_not_found":
            return "not-yet"
        say(f"WARN {pane}: could not give the name {want!r} back to the resumed agent ({exc})")
        return "refused"


def owe_names(change: Callable[[dict], None]) -> None:
    """Read-modify-write names.json under its own lock (callers may or may not hold the global one)."""
    with flocked(NAMES_OWED.with_name(NAMES_OWED.name + ".lock")):
        try:
            owed = read_json(NAMES_OWED)
        except DamagedState as exc:
            say(f"WARN {exc}; owed names moved to {quarantine(NAMES_OWED)}")
            owed = {}
        before = json.dumps(owed, sort_keys=True)
        change(owed)
        if json.dumps(owed, sort_keys=True) != before:
            write_json(NAMES_OWED, owed)


def give_name_back(pane: str, entry: dict, live_name: str | None, wait: float = 0) -> None:
    """A stub-woken agent is detected unnamed: hand it the name it slept with. Herdr may not list
    the agent yet (`agent_not_found`), so retry for `wait` seconds (0 under the global lock), then
    leave the name owed: the watcher hands it over once Herdr lists the agent (settle_owed_names)."""
    want = entry.get("name")
    if not want or live_name == want:
        return
    deadline = time.monotonic() + wait
    while True:
        outcome = try_rename(pane, want)
        if outcome != "not-yet":
            return
        if time.monotonic() >= deadline:
            break
        time.sleep(1)
    owe_names(lambda owed: owed.__setitem__(pane, {"uuid": entry["uuid"], "name": want, "at": time.time()}))
    say(f"{pane}: Herdr does not list the resumed agent yet; the watcher gives it the name {want!r} once it does")


def settle_owed_names(agents: list[dict], now: float) -> None:
    """Watcher: hand owed names to agents Herdr now lists; drop a name whose pane runs another
    session, or that could not be handed over within NAME_OWED_MAX_SECONDS (logged)."""
    if not NAMES_OWED.exists():
        return
    by_pane = {a["pane_id"]: a for a in agents if a.get("agent") and a.get("agent") != CLAIM_AGENT}

    def settle(owed: dict) -> None:
        for pane, rec in list(owed.items()):
            if not isinstance(rec, dict) or not isinstance(rec.get("name"), str):
                owed.pop(pane)
                continue
            live = by_pane.get(pane)
            live_uuid = ((live or {}).get("agent_session") or {}).get("value")
            if live and live_uuid and live_uuid != rec.get("uuid"):
                owed.pop(pane)  # another session there now: the name is not its to take
            elif live and live.get("name") == rec["name"]:
                owed.pop(pane)
            elif live and try_rename(pane, rec["name"]) != "not-yet":
                owed.pop(pane)
                event("renamed", pane=pane, name=rec["name"], uuid=rec.get("uuid"), via="watcher")
            elif not _number(rec.get("at")) or now - rec["at"] > NAME_OWED_MAX_SECONDS:
                owed.pop(pane)
                say(f"WARN {pane}: gave up handing the name {rec['name']!r} back (Herdr never listed the agent); "
                    f"rename it by hand: herdr agent rename {pane} {rec['name']}")
    owe_names(settle)


def finish_waking(pane: str, uuid: str, live_name: str | None) -> bool:
    """The session a stub resumed is running in its pane: drop the `waking` row, name the agent.
    Takes the lock; returns whether a row was finished."""
    with locked():
        journal = read_json(JOURNAL)
        row = journal.get(pane)
        if not isinstance(row, dict) or row.get("uuid") != uuid:
            return False
        journal.pop(pane)
        write_json(JOURNAL, journal)
    give_name_back(pane, row, live_name, wait=NAME_BACK_SECONDS)  # outside the lock
    event("reconciled", pane=pane, name=wake_name(row), uuid=uuid, outcome="woken")
    return True


def await_stub_wake(entry: dict) -> bool:
    """After Enter went to the pane's stub: did the session come back? Called without the lock (the stub needs it).

    A stub that exec'd but whose session Herdr has not reported yet (a slow claude start) is
    "started", not a failure: its row is `waking` and its pid is alive; reconcile finishes it.
    """
    pane, uuid, name = entry["pane_id"], entry["uuid"], wake_name(entry)
    for _ in range(WAKE_DELEGATE_SECONDS):
        info = herdr("pane", "get", pane, check=False).get("pane") or {}
        if (info.get("agent_session") or {}).get("value") == uuid:
            finish_waking(pane, uuid, info.get("agent_name") or info.get("name"))
            say(f"woke {name} in {pane} uuid={uuid} (via stub)")
            return True
        time.sleep(1)
    row = read_json(JOURNAL).get(pane) or {}
    if row.get("uuid") == uuid and row.get("phase") == "waking" and waking_alive(row):
        say(f"wake {name}: the stub started {uuid} in {pane}; session not yet reported after "
            f"{WAKE_DELEGATE_SECONDS}s (reconcile finishes it)")
        event("wake-started", pane=pane, name=name, uuid=uuid, via="stub")
        return True
    say(f"wake {name}: the pane's stub did not resume {uuid} within {WAKE_DELEGATE_SECONDS}s "
        "(it prints why in the pane); entry kept")
    event("wake-delegated-unconfirmed", pane=pane, name=name, uuid=uuid)
    return False


def find_journal_entry(target: str | None) -> tuple[str, dict, bool] | None:
    """The entry named by a pane id, wake name, or agent name: (pane, entry, from_snapshot).

    A pane id (or orphan key) matches exactly. A name matching more than one entry
    raises SleeperError with the candidates rather than picking one. No target
    matches nothing (an unnamed entry must not match a missing name).
    """
    if not target:
        return None
    journal = read_json(JOURNAL)
    if isinstance(journal.get(target), dict):
        return target, journal[target], False
    hits = sorted((p, e) for p, e in journal.items()
                  if valid_entry(e) and target in (wake_name(e), e.get("name") or None))
    if len(hits) > 1:
        raise SleeperError(f"{target!r} names {len(hits)} sleeping agents ({', '.join(p for p, _ in hits)}); "
                           "name the pane id instead")
    if hits:
        return hits[0][0], hits[0][1], False
    snap = read_json(SNAPSHOT)
    for p, s in snap.items():
        if isinstance(s, dict) and target in (p, s.get("name"), "wake-" + p.replace(":", "-")):
            return p, {"pane_id": p, **s, "phase": "orphaned" if p.startswith("orphan:") else "asleep",
                       "slept_at": None, "label": None, "tab_id": None, "workspace_id": None}, True
    return None


def cmd_wake(args: argparse.Namespace) -> int:
    remote = routed("wake", args)
    if remote is not None:
        return remote
    target = args.target
    if not args.all and not target:
        target = context_pane()  # the pane action passes no argument: it means "this pane"
        if not target:
            print("no pane context; pass a pane id, wake name, or agent name", file=sys.stderr)
            return 2
    delegated: list[dict] = []
    with locked():
        try:
            journal = read_json(JOURNAL)
        except DamagedState as exc:
            if args.all:
                raise
            aside = quarantine(JOURNAL)  # keep the damaged bytes; recovery below writes a fresh journal
            say(f"WARN {exc}; damaged journal moved to {aside}; continuing with snapshot recovery only")
            journal = {}
        if args.all:
            targets = [e for k, e in journal.items()
                       if isinstance(e, dict) and e.get("phase") != "displaced" and not is_orphan(k, e)]
            if not targets:
                held = len(journal)
                print("nothing is sleeping" + (f" ({held} orphaned/displaced: see `list`)" if held else ""))
                return 0
        else:
            try:
                hit = find_journal_entry(target)
            except DamagedState as exc:
                aside = quarantine(JOURNAL)  # keep the damaged bytes; snapshot recovery writes a fresh journal
                say(f"WARN {exc}; damaged journal moved to {aside}; continuing with snapshot recovery only")
                hit = find_journal_entry(target)
            except SleeperError as exc:
                print(f"{exc}", file=sys.stderr)
                return 1
            if not hit:
                print(f"no sleeping agent named {target!r}; try `herdr-sleeper list`")
                return 1
            if is_orphan(hit[0], hit[1]):  # the key decides, whatever pane id the body names
                print(f"{hit[0]} is orphaned (its pane id was reused); never woken automatically.\n"
                      f"  manual: {manual_command(hit[1])}")
                return 1
            if hit[2]:  # crash recovery: persist the recovered entry *before* trying, or a
                journal = read_json(JOURNAL)  # mid-wake crash loses the only other copy of the handle
                journal[hit[0]] = hit[1]
                write_json(JOURNAL, journal)
                print(f"recovering {hit[0]} from panes.json")
            if (getattr(args, "without_flags", False) and hit[1].get("argv") is None
                    and PROFILES.get(hit[1].get("kind"), {}).get("argv_after_binary")):
                # the operator vouches for a plain resume; persisted, so the stub's own check agrees
                journal = read_json(JOURNAL)
                hit[1]["argv"] = []
                journal[hit[0]] = hit[1]
                write_json(JOURNAL, journal)
                event("argv-assumed-empty", pane=hit[1]["pane_id"], uuid=hit[1]["uuid"])
                print(f"{hit[0]}: original flags unknown; resuming without flags as asked")
            targets = [hit[1]]
        woke = 0
        for entry in targets:
            try:
                outcome = wake_entry(entry, via="command", key=None if args.all else hit[0])
            except SleeperError as exc:
                say(f"wake {wake_name(entry)}: {exc}")
                continue
            if outcome == DELEGATED:
                delegated.append(entry)
            elif outcome:
                woke += 1
    for entry in delegated:  # outside the lock: the stub takes it to pop its row
        woke += await_stub_wake(entry)
    print(f"woke {woke}/{len(targets)}")
    return 0 if woke == len(targets) else 1


# ---------------------------------------------------------------- deliver

DELIVER_MAX_BYTES = 64 * 1024
DELIVER_READY_SECONDS = 120   # a resumed claude needs a few seconds before it takes a prompt
DELIVERED_KEEP = 500
SENDER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:@-]{0,63}")


def sender_ok(sender: str | None) -> bool:
    """A local sender (SENDER_RE), or `<machine>/<sender>` as a --machine path on another machine
    passes it, so the recipient's reply can find its way back."""
    if not sender:
        return False
    label, sep, rest = sender.partition("/")
    return bool(SENDER_RE.fullmatch(sender) or (sep and MACHINE_RE.fullmatch(label) and SENDER_RE.fullmatch(rest)))
MSG_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")


def pending_mail(uuid: str) -> list[Path]:
    """This session's undelivered messages, oldest first (file names start with a ns timestamp).
    Dot files (.lock, .held) are the mailbox's own bookkeeping, never mail."""
    with contextlib.suppress(OSError):
        return sorted(p for p in (MAILBOX / uuid).glob("*.json") if not p.name.startswith("."))
    return []


MAIL_HELD_EVENT_SECONDS = 600     # mail waiting this long gets a `mail-held` event (again when the reason changes)
MAIL_HELD_REPEAT_SECONDS = 1800   # ... and again after this long with the same reason
HELD_NAME = ".held"               # <mailbox>/.held: why the mail waits ({reason, since, checked}); never mail
NO_LIVE_AGENT = "no live agent runs the session"
QUEUED_ANY = "(queued)"           # finish_delivery's msg id for "whatever is queued" (deliver-pending)


def mail_age(path: Path, now: float | None = None) -> float | None:
    """Seconds since a mailbox file was queued, from the ns timestamp its name starts with."""
    try:
        ns = int(path.name.split("-", 1)[0])
    except ValueError:
        return None
    return max(0.0, (time.time() if now is None else now) - ns / 1e9)


def reason_key(reason: str) -> str:
    """A hold reason with its numbers blanked: a draft growing by a character is the same hold."""
    return re.sub(r"\d+", "N", reason)


def read_mail_hold(uuid: str) -> dict | None:
    """The recorded reason uuid's mail waits ({reason, since, checked, …}), or None."""
    try:
        data = json.loads((MAILBOX / uuid / HELD_NAME).read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) and isinstance(data.get("reason"), str) else None


def write_mail_hold(uuid: str, rec: dict) -> None:
    """Replace <mailbox>/.held atomically (0600, mkstemp's mode). Bookkeeping only: no fsync."""
    box = MAILBOX / uuid
    fd, tmp = tempfile.mkstemp(prefix=HELD_NAME + ".", suffix=".tmp", dir=box)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(rec, sort_keys=True) + "\n")
    os.replace(tmp, box / HELD_NAME)


def note_mail_hold(uuid: str, reason: str, now: float | None = None) -> dict:
    """Record why uuid's mail waits (a reason, never a message or draft text). `since` is kept while
    the reason stays the same. Returns the record; failures to write are logged, never raised.
    Caller holds the mailbox lock."""
    now = time.time() if now is None else now
    old = read_mail_hold(uuid) or {}
    same = isinstance(old.get("reason"), str) and reason_key(old["reason"]) == reason_key(reason)
    since = old.get("since") if same and isinstance(old.get("since"), (int, float)) else now
    rec = {k: v for k, v in old.items() if k in ("evented_reason", "evented_at")}
    rec.update(reason=reason, since=since, checked=now)
    try:
        write_mail_hold(uuid, rec)
    except OSError as exc:
        say(f"WARN could not record why mail for {uuid} waits: {exc}")
    return rec


def clear_mail_hold(uuid: str) -> None:
    with contextlib.suppress(OSError):
        (MAILBOX / uuid / HELD_NAME).unlink()


RULE_PART_RE = re.compile(r"[A-Za-z0-9_().:-]{1,64}")


def herdr_matched_rule(pane: str) -> str | None:
    """The detection rule Herdr's status for pane comes from (`herdr agent explain --json`), as
    `id (state, region, priority N)`, or None. Read-only and best effort. Only the rule's own
    fields are kept: the rest of the output previews the screen, which may hold a draft."""
    try:
        proc = subprocess.run([HERDR_BIN, "agent", "explain", pane, "--json"], capture_output=True, text=True,
                              timeout=10)
        rule = json.loads(proc.stdout).get("matched_rule") if proc.returncode == 0 else None
    except Exception:  # never costs the flush or the tick
        return None
    if not isinstance(rule, dict) or not isinstance(rule.get("id"), str) or not RULE_PART_RE.fullmatch(rule["id"]):
        return None
    extra = [rule[k] for k in ("state", "region")
             if isinstance(rule.get(k), str) and RULE_PART_RE.fullmatch(rule[k])]
    if isinstance(rule.get("priority"), int) and not isinstance(rule.get("priority"), bool):
        extra.append(f"priority {rule['priority']}")
    return rule["id"] + (f" ({', '.join(extra)})" if extra else "")


def escalate_mail_hold(uuid: str, name: str, pane: str | None, hold: dict, now: float | None = None) -> None:
    """A `mail-held` event once the oldest queued message waited MAIL_HELD_EVENT_SECONDS, again when
    the reason changes or MAIL_HELD_REPEAT_SECONDS passed. Counts and reasons only, never a body.
    For a Herdr status hold it adds the rule Herdr matched, so a false `working` shows in `log`.
    Caller holds the mailbox lock."""
    now = time.time() if now is None else now
    pending = pending_mail(uuid)
    oldest = mail_age(pending[0], now) if pending else None
    if oldest is None or oldest < MAIL_HELD_EVENT_SECONDS:
        return
    reason = hold["reason"]
    last, at = hold.get("evented_reason"), hold.get("evented_at")
    if (isinstance(last, str) and reason_key(last) == reason_key(reason) and isinstance(at, (int, float))
            and now - at < MAIL_HELD_REPEAT_SECONDS):
        return
    rule = herdr_matched_rule(pane) if pane and reason.startswith("status ") else None
    hold.update(evented_reason=reason, evented_at=now)
    try:
        write_mail_hold(uuid, hold)
    except OSError as exc:
        say(f"WARN could not record why mail for {uuid} waits: {exc}")
    event("mail-held", to=name, pane=pane, uuid=uuid, queued=len(pending), oldest_age_s=int(oldest),
          reason=reason, **({"herdr_rule": rule} if rule else {}))


def mail_summary(uuid: object, now: float | None = None) -> dict:
    """presence's mail fields for a session: queued count, the oldest one's age, the hold reason."""
    if not valid_session_id(uuid):
        return {"mail_queued": None, "mail_oldest_s": None, "mail_held": None}
    pending = pending_mail(str(uuid))
    if not pending:
        return {"mail_queued": 0, "mail_oldest_s": None, "mail_held": None}
    age = mail_age(pending[0], now)
    return {"mail_queued": len(pending), "mail_oldest_s": None if age is None else int(age),
            "mail_held": (read_mail_hold(str(uuid)) or {}).get("reason")}


def mail_tag(row: dict) -> str:
    """`  [3 queued 122m: why]` for a presence row with mail; "" without (or from an older version)."""
    try:
        queued = int(row.get("mail_queued") or 0)
    except (TypeError, ValueError):
        return ""
    if queued <= 0:
        return ""
    age = ""
    with contextlib.suppress(TypeError, ValueError):
        age = f" {int(float(row['mail_oldest_s'])) // 60}m" if row.get("mail_oldest_s") is not None else ""
    held = f": {row['mail_held']}" if row.get("mail_held") else ""
    return f"  [{queued} queued{age}{held}]"


class mailbox_lock:
    """Serialises deliveries to one session (a `deliver` and the watcher's flush may overlap)."""

    def __init__(self, uuid: str, wait: bool = True) -> None:
        self.uuid, self.wait = uuid, wait

    def __enter__(self) -> bool:
        box = MAILBOX / self.uuid
        ensure_state_dir()
        box.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.fh = os.fdopen(open_private(box / ".lock", os.O_RDWR), "a+")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB))
            return True
        except OSError:
            return False

    def __exit__(self, *exc: object) -> None:
        with contextlib.suppress(OSError):
            fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def envelope(msg: dict) -> str:
    """The text the target agent sees: who relayed it, the message id, and that the owner did not
    type it (an agent running with bypassed permissions must not take it for the owner's word).
    The sender always carries its machine: a local sender gets this machine's label in front, so a
    reader can tell `mbp/x` from `mini2/x` without knowing where the message was queued."""
    sender = msg["from"]
    if "/" not in sender:
        with contextlib.suppress(ConfigError):
            sender = f"{this_machine()}/{sender}"
    return f"[relayed from {sender} via herdr-sleeper, msg {msg['id']}; not from the owner]\n\n{msg['body']}"


def recently_delivered() -> dict:
    try:
        return read_json(DELIVERED)
    except SleeperError:
        return {}


def mark_delivered(msg_id: str) -> None:
    """Record a delivery. Deliveries to different sessions run under different mailbox locks, so
    the shared file has its own."""
    with flocked(DELIVERED.with_name(DELIVERED.name + ".lock")):
        done = recently_delivered()
        done[msg_id] = dt.datetime.now().isoformat(timespec="seconds")
        write_json(DELIVERED, dict(sorted(done.items(), key=lambda kv: kv[1])[-DELIVERED_KEEP:]))


# C0 controls but tab and newline, DEL, and C1: a CR would submit early, an ESC drives the TUI.
CONTROL_CHARS = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def body_problem(body: str) -> str | None:
    """Why a message body cannot be relayed, or None."""
    if not body.strip():
        return "empty message"
    if len(body.encode()) > DELIVER_MAX_BYTES:
        return f"message over {DELIVER_MAX_BYTES} bytes; send a file path instead"
    if CONTROL_CHARS.search(body):
        return "message contains control characters (only newlines and tabs are typed in)"
    return None


def queue_message(uuid: str, sender: str, body: str, msg_id: str | None) -> tuple[dict, str]:
    """Write the message into the session's mailbox (0600). Returns (message, status): "new", or
    "pending" / "delivered" for an id already queued or delivered recently (never queued twice).
    Caller holds the mailbox lock."""
    if msg_id is None:
        msg_id = hashlib.sha256(f"{sender}\0{uuid}\0{time.time_ns()}\0{body}".encode()).hexdigest()[:16]
    if msg_id in recently_delivered():
        return {"id": msg_id}, "delivered"
    for path in pending_mail(uuid):
        if path.stem.split("-", 1)[-1] == msg_id:
            return {"id": msg_id}, "pending"
    msg = {"id": msg_id, "from": sender, "to": uuid, "at": dt.datetime.now().isoformat(timespec="seconds"),
           "body": body}
    path = MAILBOX / uuid / f"{time.time_ns()}-{msg_id}.json"
    fd = open_private(path, os.O_WRONLY | os.O_EXCL)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(msg) + "\n")
    return msg, "new"


def mail_refusal(pane: str, uuid: str) -> str | None:
    """Why nothing may be typed into pane for uuid right now, from fresh state; None when it may.

    The pane must run that session, idle or done, with no sleep row on it (a `waking` row whose
    session is back is the one exception) and, for kinds we can read, an empty composer: `agent
    prompt` into a draft would send the draft with it.
    """
    agent = next((a for a in list_agents() if a["pane_id"] == pane), None)
    if not agent or agent.get("agent") in (None, CLAIM_AGENT):
        return "no live agent in the pane"
    if (agent.get("agent_session") or {}).get("value") != uuid:
        return "the pane runs another session"
    if agent.get("agent_status") not in SLEEPABLE_STATUSES:
        return f"status {agent.get('agent_status')}"
    row = read_json(JOURNAL).get(pane)
    if isinstance(row, dict) and not (row.get("phase") == "waking" and row.get("uuid") == uuid):
        return f"the pane is in the sleep journal ({row.get('phase', 'asleep')})"
    profile = PROFILES.get(agent.get("agent"), {})
    if profile.get("idle_guards") or profile.get("exit") == "prompt":
        state, detail = composer_state(herdr_screen(pane))
        if state != "empty":
            return f"composer {state}: {detail}"
    return None


def well_formed_mail(msg: object) -> bool:
    """A mailbox record envelope() can type: a dict with string id/from/body and a valid id."""
    return (isinstance(msg, dict) and all(isinstance(msg.get(k), str) for k in ("id", "from", "body"))
            and MSG_ID_RE.fullmatch(msg["id"]) is not None)


def type_mail(pane: str, uuid: str, name: str) -> tuple[list[str], str | None]:
    """Type queued messages for uuid into its agent, oldest first, after a fresh mail_refusal
    check passes. Everything queued goes in as ONE prompt (envelopes one after another, up to
    MAIL_BATCH_MAX_BYTES): the agent turns `working` as soon as the first message lands, so one
    prompt per message would let only one through per tick. A file is removed only after `agent
    prompt` succeeded (at least once). Returns (ids typed in, why it stopped early or None).
    Caller holds the mailbox lock."""
    sent: list[str] = []
    while True:
        batch: list[tuple[Path, dict]] = []
        size = 0
        for path in pending_mail(uuid):
            try:
                msg = json.loads(path.read_text())
                problem = None if well_formed_mail(msg) else "malformed"
            except (OSError, ValueError):
                problem = "unreadable"
            if problem:
                aside = path.with_suffix(".damaged")
                with contextlib.suppress(OSError):
                    os.replace(path, aside)
                say(f"WARN mailbox file {path.name} {problem}; moved aside to {aside.name}")
                continue
            text = envelope(msg)
            if batch and size + len(text.encode()) > MAIL_BATCH_MAX_BYTES:
                break
            batch.append((path, msg))
            size += len(text.encode()) + 2
        if not batch:
            break
        refusal = mail_refusal(pane, uuid)
        if refusal:
            return sent, refusal
        try:
            herdr("agent", "prompt", pane, "\n\n".join(envelope(m) for _p, m in batch))
        except SleeperError:
            # Herdr's error detail may quote what it was asked to type: the message stays out of the log
            raise SleeperError("herdr agent prompt failed") from None
        for path, msg in batch:
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
            mark_delivered(msg["id"])
            event("delivered", id=msg["id"], sender=msg.get("from"), to=name, pane=pane, uuid=uuid,
                  bytes=len(str(msg.get("body", "")).encode()), **({"batch": len(batch)} if len(batch) > 1 else {}))
            sent.append(msg["id"])
    if not pending_mail(uuid):
        clear_mail_hold(uuid)  # nothing waits any more
    return sent, None


def live_agent(uuid: str, ready: bool = True) -> dict | None:
    """The live agent running uuid (idle or done when ready=True), from a fresh `agent list`."""
    for a in list_agents():
        if a.get("agent") and a.get("agent") != CLAIM_AGENT and (a.get("agent_session") or {}).get("value") == uuid:
            if not ready or a.get("agent_status") in SLEEPABLE_STATUSES:
                return a
    return None


def session_state(uuid: str) -> tuple[str, dict, str | None] | None:
    """Where the session is now: ('asleep', entry, journal key), ('live', agent, None), or None.
    A `waking` row whose agent is already back counts as live."""
    journal = read_json(JOURNAL)  # written by atomic replace: a lock-free read sees a whole file
    hit = next(((k, e) for k, e in sorted(journal.items())
                if valid_entry(e) and e["uuid"] == uuid and not is_orphan(k, e)), None)
    if hit and hit[1].get("phase") != "waking":
        return "asleep", hit[1], hit[0]
    agent = live_agent(uuid, ready=False)
    if agent:
        return "live", agent, None
    return ("asleep", hit[1], hit[0]) if hit else None


def resolve_target(target: str, agents: list[dict], journal: dict) -> tuple[str, dict, str | None]:
    """('live', agent, None) or ('asleep', entry, journal key) for a pane id, agent name, wake
    name, or session id. More than one match refuses, naming the candidates."""
    live = [a for a in agents if a.get("agent") and a.get("agent") != CLAIM_AGENT
            and target in (a["pane_id"], a.get("name"), (a.get("agent_session") or {}).get("value"))]
    if len(live) > 1:
        raise SleeperError(f"{target!r} matches {len(live)} live agents ({', '.join(a['pane_id'] for a in live)}); "
                           "name the pane id instead")
    if live:
        return "live", live[0], None
    hits = [(k, e) for k, e in journal.items()
            if valid_entry(e) and target in (k, e["uuid"], e.get("name") or None, wake_name(e),
                                             e.get("claude_name") or None)]
    # Herdr can drop a live agent's name (it keeps the pane and the title); the Claude session
    # name in its transcript survives. Only when nothing above matched by pane, name or session id.
    named = [a for a in agents if a.get("agent") == "claude"
             and valid_session_id((a.get("agent_session") or {}).get("value"))
             and claude_session_name(transcript_for(a["agent_session"]["value"])) == target]
    if len(named) > 1:
        raise SleeperError(f"{target!r} matches {len(named)} live agents by Claude name "
                           f"({', '.join(a['pane_id'] for a in named)}); name the pane id instead")
    if named:
        others = [k for k, e in hits if e["uuid"] != named[0]["agent_session"]["value"]]
        if others:
            raise SleeperError(f"{target!r} matches live agent {named[0]['pane_id']} by Claude name and sleeping "
                               f"agents ({', '.join(others)}); name the pane id instead")
        return "live", named[0], None
    if len(hits) > 1:
        raise SleeperError(f"{target!r} matches {len(hits)} sleeping agents ({', '.join(k for k, _ in hits)}); "
                           "name the pane id instead")
    if hits:
        return "asleep", hits[0][1], hits[0][0]
    raise SleeperError(f"no live or sleeping agent matches {target!r} (see `herdr-sleeper presence`)")


def context_sender(agents: list[dict]) -> str | None:
    """The calling agent's name (or pane id), when the caller runs inside a Herdr pane."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return None
    hit = next((a for a in agents if a["pane_id"] == pane), None)
    return (hit or {}).get("name") or pane


def cmd_deliver(args: argparse.Namespace) -> int:
    """Deliver a message (stdin) to a live or sleeping agent. Exit 0 delivered, 3 queued (it is
    typed in once the target is live and idle), 1 refused, 2 bad input."""
    body = sys.stdin.read(DELIVER_MAX_BYTES + 1)
    problem = body_problem(body)
    if problem:
        print(f"deliver: {problem}", file=sys.stderr)
        return 2
    if args.id is not None and not MSG_ID_RE.fullmatch(args.id):
        print("deliver: --id must match [A-Za-z0-9_-]{1,64}", file=sys.stderr)
        return 2
    if not getattr(args, "here", False):
        try:
            label, args.target = route(args.target, getattr(args, "machine", None))
        except SleeperError as exc:
            print(f"deliver: {exc}", file=sys.stderr)
            return 1
        if label:
            return deliver_remote(label, args.target, body, args.sender, args.id)
    try:
        config, _src = load_config()
    except ConfigError as exc:
        print(f"deliver: broken config — {exc}", file=sys.stderr)
        return 1
    agents = list_agents()
    sender = args.sender or context_sender(agents)
    if not sender_ok(sender):
        print("deliver: pass --from NAME (letters, digits, _.:@-; up to 64)", file=sys.stderr)
        return 2
    try:
        state, hit, _key = resolve_target(args.target, agents, read_json(JOURNAL))
    except SleeperError as exc:
        print(f"deliver: {exc}", file=sys.stderr)
        return 1
    uuid = (hit.get("agent_session") or {}).get("value") if state == "live" else hit["uuid"]
    name = (hit.get("name") or hit["pane_id"]) if state == "live" else wake_name(hit)
    if not valid_session_id(uuid):
        print(f"deliver: {name} reports no session id; nothing to queue against "
              "(use `herdr agent prompt` for a session that cannot be resumed)", file=sys.stderr)
        return 1
    from_pane = os.environ.get("HERDR_PANE_ID")
    with mailbox_lock(uuid):
        msg, status = queue_message(uuid, sender, body, args.id)
        if status == "delivered":
            print(f"msg {msg['id']} was delivered already; not sent twice")
            return 0
        if status == "new":
            event("deliver-queued", id=msg["id"], sender=sender, from_pane=from_pane, to=name, uuid=uuid,
                  target_state=state, bytes=len(body.encode()))
        # a retried id that is still queued tries the wake and the typing again
        code, text = finish_delivery(uuid, msg["id"], sender, from_pane, config)
    print(text)
    return code


def finish_delivery(uuid: str, msg_id: str, sender: str, from_pane: str | None,
                    config: dict) -> tuple[int, str]:
    """Wake the session if it sleeps, wait until it is idle, type its queued mail in. Where the
    session is comes from fresh state, not from the caller's look before the mailbox lock.
    Returns (exit code, one line for the sender). Caller holds the session's mailbox lock."""
    where = session_state(uuid)
    if where is None:
        note_mail_hold(uuid, NO_LIVE_AGENT)
        return 3, f"queued msg {msg_id} for {uuid}: neither live nor asleep now; typed in when it next runs"
    state, hit, key = where
    name = wake_name(hit) if state == "asleep" else (hit.get("name") or hit["pane_id"])
    woke = False
    if state == "asleep":
        if sender in config["wake_refuse_from"] or (from_pane and from_pane in config["wake_refuse_from"]):
            event("deliver-held", id=msg_id, sender=sender, to=name, reason="sender may not wake")
            note_mail_hold(uuid, "asleep; the sender may not wake it")
            return 3, (f"queued msg {msg_id} for {name}: {sender} may not wake sleepers; "
                       "it is typed in when the agent next runs")
        with locked():
            entry = read_json(JOURNAL).get(key or "")
            # the row is re-read under the lock: the one read above may be gone or another session's
            outcome = (wake_entry(entry, via=f"deliver:{sender}", key=key)
                       if valid_entry(entry) and entry["uuid"] == uuid else live_agent(uuid, ready=False) is not None)
        if outcome == DELEGATED:
            outcome = await_stub_wake(entry)
        if not outcome:
            event("deliver-held", id=msg_id, sender=sender, to=name, reason="wake refused or failed")
            note_mail_hold(uuid, "the wake was refused or failed")
            return 3, (f"queued msg {msg_id} for {name}: the wake was refused or failed (see `log`); "
                       "it is typed in when the agent next runs")
        woke = True
    target: dict | None = None
    refusal: str | None = NO_LIVE_AGENT
    for _ in range(DELIVER_READY_SECONDS if woke else 1):
        # an idle agent on the session first, else any (its refusal names the real status)
        target = live_agent(uuid) or live_agent(uuid, ready=False)
        refusal = mail_refusal(target["pane_id"], uuid) if target else NO_LIVE_AGENT
        if not refusal:
            break
        time.sleep(1)
    if refusal or not target:
        note_mail_hold(uuid, refusal or NO_LIVE_AGENT)
        return 3, f"queued msg {msg_id} for {name}: not ready yet ({refusal}); typed in when it is"
    try:
        sent, refusal = type_mail(target["pane_id"], uuid, name)
    except SleeperError as exc:
        event("deliver-held", id=msg_id, sender=sender, to=name, reason=str(exc))
        note_mail_hold(uuid, f"typing it in failed ({exc})")
        return 3, f"queued msg {msg_id} for {name}: typing it in failed ({exc}); the watcher retries"
    if refusal:
        note_mail_hold(uuid, refusal)
    mine = not pending_mail(uuid) if msg_id == QUEUED_ANY else msg_id in sent
    if mine:
        return 0, f"delivered msg {msg_id} to {name}" + (" (woke it)" if woke else "")
    why = refusal or "the agent went busy"
    if not sent:
        return 3, f"queued msg {msg_id} for {name}: not ready yet ({why}); typed in when it is"
    if msg_id == QUEUED_ANY:
        return 3, f"typed {len(sent)} queued message(s) into {name}; the rest wait ({why})"
    return 3, f"queued msg {msg_id} for {name}: typed {len(sent)} older message(s) first; {msg_id} waits ({why})"


def cmd_deliver_pending(args: argparse.Namespace) -> int:
    """Internal (spawned by claude-hook): wake the sleeper holding mail for UUID and type it in."""
    if not valid_session_id(args.uuid) or not sender_ok(args.sender):
        say("deliver-pending: malformed session id or sender; nothing done")
        return 2
    config, _src = load_config()
    with mailbox_lock(args.uuid):
        if not pending_mail(args.uuid):
            return 0
        code, text = finish_delivery(args.uuid, QUEUED_ANY, args.sender, None, config)
    say(f"deliver-pending: {text}")
    return code


# --------------------------------------------------------------- insomnia

# An agent that must stay up (it holds an SSH master or a tunnel, waits on a deploy, serves other
# agents) claims insomnia for its own Claude session: one more eligibility check, so the session is
# never slept on idle, over max_live or under memory pressure. restart_outdated still restarts it
# (a restart is not a sleep). Claims are keyed by session id, so they survive a Herdr restart (new
# terminal ids, lost agent names) and a reboot. insomnia.json is never quarantined: moving it aside
# would drop every claim without a word, so a damaged file holds every session awake until it is
# fixed by hand.
INSOMNIA_STALE_SECONDS = 24 * 3600   # a claim on a session idle this long is reported once a day, never dropped
INSOMNIA_REASON_MAX = 120
INSOMNIA_SOURCE = "herdr-sleeper-insomnia"  # its own metadata source: the sleep label keeps "herdr-sleeper"
INSOMNIA_TOKEN = "insomnia"
INSOMNIA_TOKENS: dict[str, tuple[str, object]] = {}  # session id -> (pane, terminal id) the token went to (watcher memory)


def _number(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def read_insomnia() -> dict[str, dict]:
    """Every claim on disk, expired ones included. DamagedState for anything malformed (never
    quarantined, see above); callers that sleep read that as "every session holds insomnia"."""
    data = read_json(INSOMNIA)
    for uuid, rec in data.items():
        if (not valid_session_id(uuid) or not isinstance(rec, dict) or not _number(rec.get("at"))
                or not (rec.get("until") is None or _number(rec.get("until")))
                or not (rec.get("reason") is None or isinstance(rec.get("reason"), str))):
            raise DamagedState(f"{INSOMNIA} holds a malformed claim; nothing sleeps until it is fixed by hand")
    return data


def insomnia_claims(now: float | None = None) -> dict[str, dict]:
    """The claims in force: an expired `--for` claim no longer holds (the watcher drops it, logged)."""
    now = time.time() if now is None else now
    return {u: r for u, r in read_insomnia().items() if r.get("until") is None or r["until"] > now}


def claim_for(claims: dict[str, dict], uuid: str | None, pane: str | None = None,
              terminal: object = None) -> str | None:
    """The claim (its session id) that holds this agent: its own, or one made in the same pane and
    terminal under another session id. `/clear` starts a new session id in the same process, and a
    claim must not quietly stop holding then; the watcher re-keys such a claim (`insomnia-carried`)."""
    if uuid in claims:
        return uuid
    if pane and terminal:
        return next((u for u, r in claims.items() if r.get("pane") == pane and r.get("terminal_id") == terminal), None)
    return None


def insomnia_reason(uuid: str, pane: str | None = None, terminal: object = None) -> str | None:
    """Why this session may not sleep, or None. Fail closed: unreadable claims hold every session."""
    try:
        claims = insomnia_claims()
    except SleeperError as exc:
        return f"insomnia claims unreadable: {exc}"
    key = claim_for(claims, uuid, pane, terminal)
    if key is None:
        return None
    rec = claims[key]
    return "insomnia" + (f" ({rec['reason']})" if rec.get("reason") else "")


def insomnia_label(rec: dict) -> str:
    until = rec.get("until")
    return (rec.get("reason") or "claimed") + (f" until {_iso(until)}" if until else "")


def _iso(stamp: float) -> str:
    return dt.datetime.fromtimestamp(stamp).isoformat(timespec="seconds")


def reason_problem(text: str | None) -> str | None:
    if text is None:
        return None
    if not text.strip():
        return "--reason is empty"
    if len(text) > INSOMNIA_REASON_MAX:
        return f"--reason is longer than {INSOMNIA_REASON_MAX} characters"
    if RESUME_CONTROL.search(text):
        return "--reason has control characters"
    return None


def ancestors(table: dict[int, tuple[int, str]], pid: int) -> list[int]:
    """pid's parent, grandparent, … up to init, from a process table (cycles and gaps end the walk)."""
    chain: list[int] = []
    while pid in table and len(chain) < 128:
        pid = table[pid][0]
        if pid <= 0 or pid in chain:
            break
        chain.append(pid)
    return chain


def calling_agent(agents: list[dict]) -> tuple[dict | None, str | None]:
    """The live agent this command runs under, or (None, why). The pane comes from HERDR_PANE_ID and
    is believed only when that pane's agent process is an ancestor of this one: a variable inherited
    from another pane or session must not claim for someone else's session."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return None, "not run inside a Herdr pane (no HERDR_PANE_ID)"
    hit = next((a for a in agents if a["pane_id"] == pane and a.get("agent")
                and a.get("agent") != CLAIM_AGENT), None)
    if hit is None:
        return None, f"{pane} runs no agent"
    if hit.get("agent") not in PROFILES:
        return None, f"{pane} runs {hit.get('agent')}, which is never slept; no claim needed"
    if not valid_session_id((hit.get("agent_session") or {}).get("value")):
        return None, f"{pane} reports no session id yet; try again in a moment"
    present, _argv, pid = agent_process(pane, hit["agent"])
    if present is not True or not isinstance(pid, int) or pid <= 1:
        return None, f"the agent process in {pane} cannot be identified"
    if pid not in ancestors(process_table(), os.getpid()):
        return None, f"this command does not run under the agent in {pane} (HERDR_PANE_ID from elsewhere?)"
    return hit, None


def report_insomnia_token(pane: str, rec: dict | None) -> None:
    """Show (rec) or clear (None) the claim in the pane's sidebar row. Best effort: display only."""
    with contextlib.suppress(SleeperError):
        if rec is None:
            herdr("pane", "report-metadata", pane, "--source", INSOMNIA_SOURCE, "--clear-token", INSOMNIA_TOKEN,
                  check=False)
        else:
            herdr("pane", "report-metadata", pane, "--source", INSOMNIA_SOURCE,
                  "--token", f"{INSOMNIA_TOKEN}={(rec.get('reason') or 'on')[:40]}", check=False)


def claim_insomnia(args: argparse.Namespace) -> int:
    problem = reason_problem(args.reason)
    hours = None
    if args.duration is not None:
        try:
            hours = parse_duration(args.duration)
        except ConfigError:
            problem = problem or f"--for {args.duration!r} is not a duration (90m, 4h, 2d)"
        else:
            if not 0 < hours < math.inf:
                problem = problem or "--for must be longer than zero"
    if problem:
        print(f"insomnia: {problem}", file=sys.stderr)
        return 2
    agents = list_agents()
    me, why = calling_agent(agents)
    if me is None:
        print(f"insomnia: {why}; an agent claims only for its own session, from inside it", file=sys.stderr)
        return 1
    uuid = me["agent_session"]["value"]
    name = me.get("name") or (claude_session_name(transcript_for(uuid)) if me.get("agent") == "claude" else None)
    now = time.time()
    with locked():
        try:
            claims = read_insomnia()
        except SleeperError as exc:
            print(f"insomnia: {exc}", file=sys.stderr)
            return 1
        key = claim_for(claims, uuid, me["pane_id"], me.get("terminal_id"))
        old = claims.pop(key, None) if key else None
        rec = {"at": old["at"] if old else now, "since": (old or {}).get("since") or _iso(now),
               "reason": args.reason, "until": now + hours * 3600 if hours else None,
               "pane": me["pane_id"], "terminal_id": me.get("terminal_id"), "name": name,
               "kind": me.get("agent"), "stale_reported": None}
        claims[uuid] = rec
        write_json(INSOMNIA, claims)
    event("insomnia-claimed", uuid=uuid, pane=me["pane_id"], name=name, reason=args.reason,
          until=_iso(rec["until"]) if rec["until"] else None, renewed=old is not None)
    report_insomnia_token(me["pane_id"], rec)
    print(f"insomnia claimed for {name or me['pane_id']} ({uuid}): {insomnia_label(rec)}; "
          "release it with `herdr-sleeper insomnia release` when you no longer need it")
    return 0


def claim_target(target: str, claims: dict[str, dict], agents: list[dict]) -> str:
    """The session id a release --pane names: a claimed session id, or a live/sleeping agent's
    pane id, agent name, wake name or Claude session name."""
    if target in claims:
        return target
    named = [u for u, r in claims.items() if target in (r.get("name"), r.get("pane"))]
    try:
        state, hit, _key = resolve_target(target, agents, read_json(JOURNAL))
    except SleeperError:
        if len(named) == 1:
            return named[0]
        raise
    return (hit.get("agent_session") or {}).get("value") if state == "live" else hit["uuid"]


def release_insomnia(args: argparse.Namespace) -> int:
    agents = list_agents()
    me, why = calling_agent(agents)
    mine = me["agent_session"]["value"] if me else None
    if me:  # a claim made before a /clear is still the caller's own
        mine = claim_for(insomnia_claims_or_empty(), mine, me["pane_id"], me.get("terminal_id")) or mine
    if args.pane:
        try:
            uuid = claim_target(args.pane, insomnia_claims_or_empty(), agents)
        except SleeperError as exc:
            print(f"insomnia: {exc}", file=sys.stderr)
            return 1
        if uuid != mine and not args.force:
            print(f"insomnia: {args.pane} is another session's claim; agents release only their own. "
                  "To free memory from a forgotten claim, pass --force (logged)", file=sys.stderr)
            return 1
    elif mine is None:
        print(f"insomnia: {why}; pass --pane TARGET --force to release another session's claim", file=sys.stderr)
        return 1
    else:
        uuid = mine
    with locked():
        try:
            claims = read_insomnia()
        except SleeperError as exc:
            print(f"insomnia: {exc}", file=sys.stderr)
            return 1
        rec = claims.pop(str(uuid), None)
        if rec is None:
            print(f"no insomnia claim for {args.pane or uuid}; nothing to release")
            return 0
        write_json(INSOMNIA, claims)
    forced = uuid != mine
    by = context_sender(agents) or f"pid {os.getppid()}"
    event("insomnia-released", uuid=uuid, name=rec.get("name"), by=by, forced=forced)
    if forced:
        say(f"insomnia of {rec.get('name') or uuid} released by {by} (--force)")
    INSOMNIA_TOKENS.pop(str(uuid), None)
    live = next((a for a in agents if (a.get("agent_session") or {}).get("value") == uuid), None)
    if live:
        report_insomnia_token(live["pane_id"], None)
    print(f"insomnia released for {rec.get('name') or uuid}; it sleeps like the others again")
    return 0


def insomnia_claims_or_empty() -> dict[str, dict]:
    """For lookups only (never for a sleep decision): a damaged file names no claims here."""
    try:
        return read_insomnia()
    except SleeperError:
        return {}


def insomnia_rows(claims: dict[str, dict], now: float) -> list[dict]:
    agents = list_agents()
    clocks = load_clocks()
    journal = read_json(JOURNAL)
    rows = []
    for uuid, rec in sorted(claims.items(), key=lambda kv: kv[1]["at"]):
        live = next((a for a in agents if a.get("agent") and a.get("agent") != CLAIM_AGENT
                     and (a.get("agent_session") or {}).get("value") == uuid), None)
        asleep = next((k for k, e in journal.items() if valid_entry(e) and e["uuid"] == uuid), None)
        clock = clocks.get(live["pane_id"]) if live else None
        idle = (now - clock["since"]) / 3600 if live and clock and clock.get("uuid") == uuid else None
        rows.append({"session": uuid, "name": rec.get("name"), "pane": live["pane_id"] if live else asleep,
                     "state": (live.get("agent_status") or "unknown") if live else "asleep" if asleep else "not running",
                     "since": rec.get("since"), "until": _iso(rec["until"]) if rec.get("until") else None,
                     "reason": rec.get("reason"), "idle_hours": round(idle, 1) if idle is not None else None})
    return rows


def list_insomnia(args: argparse.Namespace) -> int:
    try:
        claims = insomnia_claims()
    except SleeperError as exc:
        print(f"insomnia: {exc}", file=sys.stderr)
        return 2
    rows = insomnia_rows(claims, time.time())
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no insomnia claims")
    for r in rows:
        idle = f" idle {r['idle_hours']:g}h" if r["idle_hours"] is not None else ""
        print(f"{str(r['name'] or '-'):30} {str(r['pane'] or '-'):10} {r['state']:12} since {r['since']}"
              f"{' until ' + r['until'] if r['until'] else ''}{idle}  {r['reason'] or ''}")
    return 0


def cmd_insomnia(args: argparse.Namespace) -> int:
    if args.action == "list":
        remote = routed("insomnia list", args)
        if remote is not None:
            return remote
    return {"claim": claim_insomnia, "release": release_insomnia, "list": list_insomnia}[args.action](args)


def tend_insomnia(agents: list[dict], clocks: dict[str, dict], now: float) -> None:
    """Watcher, under the lock: drop expired claims (logged), report stale ones once a day, and keep
    the sidebar token on the pane each claimed session runs in (metadata does not survive a restart)."""
    try:
        claims = read_insomnia()
    except SleeperError as exc:
        note_skip("<insomnia>", f"insomnia claims unreadable, nothing sleeps until fixed by hand: {exc}")
        return
    LAST_SKIP.pop("<insomnia>", None)
    live = {(a.get("agent_session") or {}).get("value"): a for a in agents
            if a.get("agent") and a.get("agent") != CLAIM_AGENT}
    changed = False
    for uuid, rec in list(claims.items()):
        moved = None if uuid in live else next(
            (a for u, a in live.items() if valid_session_id(u) and u not in claims and rec.get("terminal_id")
             and a["pane_id"] == rec.get("pane") and a.get("terminal_id") == rec.get("terminal_id")), None)
        if moved is not None:  # same pane and terminal, new session id (/clear): the claim follows it
            new = moved["agent_session"]["value"]
            claims[new] = claims.pop(uuid)
            changed = True
            event("insomnia-carried", old=uuid, uuid=new, pane=moved["pane_id"], name=rec.get("name"))
            say(f"insomnia of {rec.get('name') or uuid} carried over to session {new} (same pane and terminal)")
            INSOMNIA_TOKENS.pop(uuid, None)
            uuid = new
        agent = live.get(uuid)
        name = rec.get("name") or uuid
        if rec.get("until") is not None and rec["until"] <= now:
            claims.pop(uuid)
            changed = True
            event("insomnia-expired", uuid=uuid, name=rec.get("name"), reason=rec.get("reason"))
            say(f"insomnia of {name} expired (--for); it sleeps like the others again")
            INSOMNIA_TOKENS.pop(uuid, None)
            if agent:
                report_insomnia_token(agent["pane_id"], None)
            continue
        clock = clocks.get(agent["pane_id"]) if agent else None
        idle = now - clock["since"] if clock and clock.get("uuid") == uuid else None
        stale = (idle is not None and idle >= INSOMNIA_STALE_SECONDS) or (
            agent is None and now - rec["at"] >= INSOMNIA_STALE_SECONDS)
        reported = rec.get("stale_reported")
        if stale and not (_number(reported) and now - reported < INSOMNIA_STALE_SECONDS):
            rec["stale_reported"] = now
            changed = True
            what = f"idle {idle / 3600:.0f}h" if idle is not None else "session not running"
            event("insomnia-stale", uuid=uuid, name=rec.get("name"), reason=rec.get("reason"), state=what)
            say(f"WARN insomnia of {name} looks forgotten ({what}); kept. Release: herdr-sleeper insomnia "
                f"release --pane {uuid} --force")
        if agent and INSOMNIA_TOKENS.get(uuid) != (agent["pane_id"], agent.get("terminal_id")):
            report_insomnia_token(agent["pane_id"], rec)
            INSOMNIA_TOKENS[uuid] = (agent["pane_id"], agent.get("terminal_id"))
    if changed:
        write_json(INSOMNIA, claims)


# ------------------------------------------------------------- spawn, close

# An orchestrator creates a named agent session in a new tab, hands it its first prompt, and closes it
# once the work is done. Spawned claude sessions get `-n <name>`, so they can sleep, are found again by
# that name after a Herdr restart, and their extra flags must pass the same replay filter a wake uses.
SPAWN_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}")
SPAWN_KINDS = ("claude", "codex")
SPAWN_ROOT = Path(os.path.expanduser("~/development"))  # spawned sessions work in checkouts below this
SPAWN_READY_MS = 120_000
SPAWN_SHELL_SECONDS = 20         # how long a new tab may take to show its shell prompt
SPAWNED = STATE_DIR / "spawned.json"  # session name -> who spawned it and where (close, presence)


def spawn_cwd_problem(raw: str) -> tuple[Path | None, str | None]:
    """(resolved cwd, None) when raw is a directory inside a git checkout below SPAWN_ROOT."""
    cwd = Path(os.path.realpath(os.path.expanduser(raw)))
    root = Path(os.path.realpath(SPAWN_ROOT))
    if not cwd.is_dir():
        return None, f"--cwd {raw} is not a directory"
    if cwd == root or root not in cwd.parents:
        return None, f"--cwd must be a checkout below {SPAWN_ROOT}"
    for d in (cwd, *cwd.parents):
        if d == root:
            break
        if (d / ".git").exists():
            return cwd, None
    return None, f"--cwd {raw} is not inside a git checkout"


def spawn_args_problem(kind: str, extra: list[str]) -> str | None:
    """Why these agent flags may not go to a spawned session, or None. Values are never echoed."""
    if any(RESUME_CONTROL.search(a) for a in extra):
        return "agent arguments contain control characters"
    if kind != "claude":
        return None
    if any(a.startswith("-n") or a.startswith("--name") for a in extra):
        return "the session name comes from --name; drop -n/--name from the agent arguments"
    replay, why = replayable_argv(extra)
    if replay is None:
        return f"agent arguments would not survive a sleep: {why}"
    if replay != extra:
        return "agent arguments select a session (--resume, --continue); a spawn starts a new one"
    return None


def name_taken(name: str, agents: list[dict]) -> str | None:
    """Where a session or agent called name already is, or None."""
    for a in agents:
        if a.get("agent") and a.get("agent") != CLAIM_AGENT and name in (a.get("name"), a.get("terminal_title_stripped")):
            return f"live in {a['pane_id']}"
    for key, e in read_json(JOURNAL).items():
        if valid_entry(e) and name in (e.get("name"), e.get("claude_name"), wake_name(e)):
            return f"asleep in {key}"
    return None


def caller_workspace(agents: list[dict]) -> str | None:
    pane = os.environ.get("HERDR_PANE_ID")
    hit = next((a for a in agents if a["pane_id"] == pane), None) if pane else None
    return (hit or {}).get("workspace_id")


def record_spawned(name: str, rec: dict | None) -> None:
    """Add (rec) or drop (None) a spawn record. Caller holds the global lock."""
    try:
        spawned = read_json(SPAWNED)
    except DamagedState as exc:
        say(f"WARN {exc}; damaged spawn records moved to {quarantine(SPAWNED)}")
        spawned = {}
    if rec is None:
        if spawned.pop(name, None) is None:
            return
    else:
        spawned[name] = rec
    write_json(SPAWNED, spawned)


SPAWN_RECORD_GRACE_SECONDS = 3600  # a record whose session is gone this long is dropped (attribution only)


def prune_spawned(agents: list[dict], journal: dict, now: float) -> None:
    """Watcher, under the lock: drop spawn records whose session is neither live nor asleep (its tab
    was closed by hand, the agent quit). They only say who spawned a session; the journal, not this
    file, is the handle to a sleeping one."""
    records = spawned_records()
    if not records:
        return
    present = {(a.get("agent_session") or {}).get("value") for a in agents if a.get("agent")}
    present |= {e["uuid"] for e in journal.values() if valid_entry(e)}
    gone = []
    for name, rec in records.items():
        if rec.get("uuid") not in present:  # /clear: the same pane runs a new session under that name
            same = next((a for a in agents if a["pane_id"] == rec.get("pane") and a.get("name") == name
                         and valid_session_id((a.get("agent_session") or {}).get("value"))), None)
            if same is None and isinstance(journal.get(rec.get("pane")), dict):
                row = journal[rec["pane"]]
                same = {"agent_session": {"value": row["uuid"]}} if valid_entry(row) and row.get("name") == name else None
            if same is not None:
                record_spawned(name, {**rec, "uuid": same["agent_session"]["value"]})
                event("spawn-record-moved", name=name, old=rec.get("uuid"), uuid=same["agent_session"]["value"])
                continue
        try:
            age = now - dt.datetime.fromisoformat(str(rec.get("at"))).timestamp()
        except ValueError:
            age = math.inf
        if rec.get("uuid") not in present and age >= SPAWN_RECORD_GRACE_SECONDS:
            gone.append(name)
    for name in gone:
        record_spawned(name, None)
        event("spawn-record-dropped", name=name, uuid=records[name].get("uuid"), reason="session gone")


def spawned_records() -> dict[str, dict]:
    try:
        return {k: v for k, v in read_json(SPAWNED).items() if isinstance(v, dict)}
    except SleeperError:
        return {}


def close_tab_or_pane(pane: str, tab: str | None) -> str:
    """Close the pane's tab when the pane is all it holds, else just the pane. Returns what closed."""
    count = herdr("tab", "get", tab, check=False).get("tab", {}).get("pane_count") if tab else None
    if tab and count == 1:
        herdr("tab", "close", tab)
        return f"tab {tab}"
    herdr("pane", "close", pane)
    return f"pane {pane}"


def cmd_spawn(args: argparse.Namespace) -> int:
    """Create a tab, start a named agent in it, type its first prompt (stdin). Exit 0 started and
    prompted, 3 started with the prompt queued, 1 refused or failed, 2 bad input."""
    body = sys.stdin.read(DELIVER_MAX_BYTES + 1)
    extra = list(args.agent_args or [])
    if extra[:1] == ["--"]:
        extra = extra[1:]
    try:
        label = machine_label(getattr(args, "machine", None))
        who = remote_sender(args.sender) if label else None
    except SleeperError as exc:
        print(f"spawn: {exc}", file=sys.stderr)
        return 1
    if label:
        if not SPAWN_NAME_RE.fullmatch(args.name):
            print("spawn: --name must match [A-Za-z0-9][A-Za-z0-9_.-]{0,63}", file=sys.stderr)
            return 2
        if not who:
            print("spawn: pass --from NAME (letters, digits, _.:@-; up to 64)", file=sys.stderr)
            return 2
        argv = (["spawn", "--cwd", args.cwd, "--name", args.name, "--kind", args.kind, "--from", who]
                + (["--workspace", args.workspace] if args.workspace else []) + (["--json"] if args.json else [])
                + (["--", *extra] if extra else []))
        return relay_remote("spawn", label, argv, body, REMOTE_SPAWN_SECONDS)
    cwd, cwd_problem = spawn_cwd_problem(args.cwd)
    problems = [f"first prompt: {body_problem(body)}" if body_problem(body) else None,
                None if SPAWN_NAME_RE.fullmatch(args.name) else "--name must match [A-Za-z0-9][A-Za-z0-9_.-]{0,63}",
                spawn_args_problem(args.kind, extra), cwd_problem]
    problem = next((p for p in problems if p), None)
    agents = list_agents()
    sender = args.sender or context_sender(agents)
    if not problem and not sender_ok(sender):
        problem = "pass --from NAME (letters, digits, _.:@-; up to 64)"
    if problem:
        print(f"spawn: {problem}", file=sys.stderr)
        return 2
    try:
        load_config()
        taken = name_taken(args.name, agents)
    except SleeperError as exc:
        print(f"spawn: {exc}", file=sys.stderr)
        return 1
    if taken:
        print(f"spawn: a session named {args.name} is {taken}; pick another name", file=sys.stderr)
        return 1
    workspace = args.workspace or caller_workspace(agents)
    try:
        made = herdr("tab", "create", "--cwd", str(cwd), "--label", args.name, "--no-focus",
                     *(["--workspace", workspace] if workspace else []))
        pane, tab = made["root_pane"]["pane_id"], made["tab"]["tab_id"]
    except (SleeperError, KeyError, TypeError) as exc:
        print(f"spawn: could not create a tab: {exc}", file=sys.stderr)
        return 1
    for _ in range(SPAWN_SHELL_SECONDS * 2):
        if pane_at_shell(pane) is True:
            break
        time.sleep(0.5)
    else:  # agent start would type into whatever holds the terminal
        with contextlib.suppress(SleeperError):
            close_tab_or_pane(pane, tab)
        event("spawn-failed", name=args.name, by=sender, cwd=str(cwd), kind=args.kind, code="no-shell")
        print(f"spawn: the new pane never showed a bare shell within {SPAWN_SHELL_SECONDS}s; tab {tab} closed",
              file=sys.stderr)
        return 1
    argv = (["-n", args.name] if args.kind == "claude" else []) + extra
    try:
        started = herdr("agent", "start", args.name, "--kind", args.kind, "--pane", pane,
                        "--timeout", str(SPAWN_READY_MS), "--", *argv, timeout=SPAWN_READY_MS / 1000 + 30)
    except SleeperError as exc:
        code = getattr(exc, "code", None)
        hint = (" (a folder-trust or login prompt? Start it once by hand in that checkout)"
                if code == "agent_not_ready" else "")
        with contextlib.suppress(SleeperError):
            close_tab_or_pane(pane, tab)  # nothing was typed into it: no session worth keeping
        event("spawn-failed", name=args.name, by=sender, cwd=str(cwd), kind=args.kind, code=code)
        print(f"spawn: {args.name} did not start ({code or exc}){hint}; tab {tab} closed", file=sys.stderr)
        return 1
    uuid = ((started.get("agent") or {}).get("agent_session") or {}).get("value")
    for _ in range(WAKE_CONFIRM_SECONDS):
        if valid_session_id(uuid):
            break
        time.sleep(1)
        uuid = ((herdr("pane", "get", pane, check=False).get("pane") or {}).get("agent_session") or {}).get("value")
    from_pane = os.environ.get("HERDR_PANE_ID")
    rec = {"pane": pane, "tab": tab, "workspace": made["tab"].get("workspace_id"), "kind": args.kind,
           "cwd": str(cwd), "by": sender, "from_pane": from_pane, "uuid": uuid if valid_session_id(uuid) else None,
           "at": dt.datetime.now().isoformat(timespec="seconds")}
    with locked():
        record_spawned(args.name, rec)
    event("spawned", name=args.name, pane=pane, tab=tab, uuid=rec["uuid"], kind=args.kind, cwd=str(cwd),
          by=sender, from_pane=from_pane)
    if not rec["uuid"]:
        print(f"spawned {args.name} in {pane} (tab {tab}), but it reports no session id; first prompt not "
              f"typed (send it with `herdr agent prompt {pane} …`)", file=sys.stderr)
        return 1
    config, _src = load_config()
    with mailbox_lock(uuid):
        msg, _status = queue_message(uuid, sender, body, None)
        event("deliver-queued", id=msg["id"], sender=sender, from_pane=from_pane, to=args.name, uuid=uuid,
              target_state="spawned", bytes=len(body.encode()))
        code, text = finish_delivery(uuid, msg["id"], sender, from_pane, config)
    out = {"name": args.name, "pane": pane, "tab": tab, "session": uuid, "prompt": "delivered" if code == 0 else "queued"}
    print(json.dumps(out) if args.json else f"spawned {args.name} in {pane} (tab {tab}, session {uuid}); {text}")
    return code


def close_refusals(state: str, hit: dict, uuid: str) -> list[str]:
    """Why closing this session would lose something (each overridable by --force)."""
    why = []
    held = insomnia_reason(uuid)
    if held:
        why.append(f"holds {held}")
    if pending_mail(uuid):
        why.append("has undelivered mail")
    if state == "live":
        status = hit.get("agent_status")
        if status not in SLEEPABLE_STATUSES:
            why.append(f"is busy (status {status})")
        elif hit.get("agent") == "claude":
            busy = busy_reason(hit)
            if busy:
                why.append(busy)
        else:
            why.append(f"runs {hit.get('agent')}, whose composer cannot be checked for a draft")
    return why


def cmd_close(args: argparse.Namespace) -> int:
    """Close a live or sleeping session's pane (its tab when that is all the tab holds). Refuses a
    busy session, a draft, background work, undelivered mail or insomnia unless --force; never acts
    on a pane whose sleep row is not provably ours (orphaned, displaced, waking)."""
    remote = routed("close", args)
    if remote is not None:
        return remote
    agents = list_agents()
    by = args.sender or context_sender(agents) or f"pid {os.getppid()}"
    try:
        journal = read_json(JOURNAL)
        record = spawned_records().get(args.target)
        try:
            state, hit, key = resolve_target((record or {}).get("uuid") or args.target, agents, journal)
        except SleeperError:
            if not record:
                raise
            # the recorded session id is out of date (/clear started a new one): try the name itself
            state, hit, key = resolve_target(args.target, agents, journal)
    except SleeperError as exc:
        print(f"close: {exc}", file=sys.stderr)
        return 1
    uuid = (hit.get("agent_session") or {}).get("value") if state == "live" else hit["uuid"]
    if not valid_session_id(uuid):
        print(f"close: {args.target} reports no session id; close its pane with `herdr pane close`", file=sys.stderr)
        return 1
    me, _why = calling_agent(agents)
    if me and me["agent_session"]["value"] == uuid:
        print("close: refusing to close the calling session", file=sys.stderr)
        return 1
    with locked(), mailbox_lock(uuid, wait=False) as free:
        if not free:
            print("close: a message to this session is being delivered; try again", file=sys.stderr)
            return 1
        where = session_state(uuid)  # fresh, under both locks
        if where is None:
            print(f"close: {args.target} is neither live nor asleep any more", file=sys.stderr)
            return 1
        state, hit, key = where
        name = (hit.get("name") or hit["pane_id"]) if state == "live" else wake_name(hit)
        if state == "asleep":
            info = herdr("pane", "get", str(hit["pane_id"]), check=False).get("pane") or {}
            phase = "orphaned" if is_orphan(str(key), hit) else hit.get("phase", "asleep")
            if phase != "asleep" or identity(hit, info) not in ("same", "restarted") \
                    or info.get("agent") not in (None, CLAIM_AGENT):
                print(f"close: the sleep row for {name} is {phase} and its pane is not provably its own; "
                      f"resolve it by hand (`herdr-sleeper list`)", file=sys.stderr)
                return 1
            # our stub, or nothing but the shell: anything else is someone's work (the stub was left
            # with ctrl-c and the pane reused by hand), and --force does not override that
            if stub_running(str(hit["pane_id"]), uuid) is not True and pane_at_shell(str(hit["pane_id"])) is not True:
                print(f"close: {name}'s pane runs something other than its wake stub or a bare shell; "
                      "close it by hand if that is meant", file=sys.stderr)
                return 1
        elif any(valid_entry(e) and e["uuid"] == uuid for e in read_json(JOURNAL).values()):
            print(f"close: {name} has a sleep row still being settled (waking); try again in a minute",
                  file=sys.stderr)
            return 1
        refusals = close_refusals(state, hit, uuid)
        if refusals and not args.force:
            print(f"close: {name} " + "; ".join(refusals) + ". Pass --force to close it anyway", file=sys.stderr)
            return 1
        pane = hit["pane_id"]
        tab = hit.get("tab_id") if state == "live" else (herdr("pane", "get", pane, check=False).get("pane") or {}).get("tab_id")
        cwd, kind = hit.get("cwd"), hit.get("agent") if state == "live" else hit.get("kind")
        exited, helpers = None, {}
        if state == "live" and kind in PROFILES and PROFILES[kind]["exit"] == "signal":
            present, _argv, pid = agent_process(pane, str(kind))
            table = process_table()
            if present is True and signalable(pid, str(kind), table) is None:
                helpers = {child: comm for child, (parent, comm) in table.items() if parent == int(pid)}
                os.kill(int(pid), signal.SIGTERM)  # a clean shutdown first; closing the pane would SIGHUP it
                exited = False
                for _ in range(EXIT_WAIT_SECONDS):
                    time.sleep(1)
                    if agent_process(pane, str(kind))[0] is False:
                        exited = True
                        break
        try:
            closed = close_tab_or_pane(pane, tab)
        except SleeperError as exc:
            print(f"close: closing {pane} failed: {exc}", file=sys.stderr)
            return 1
        reap_helpers(helpers)
        if state == "asleep":
            release(pane)  # best effort: a closed pane takes its claim and saved resume command along
        if state == "asleep":
            journal = read_json(JOURNAL)
            if isinstance(journal.get(str(key)), dict) and journal[str(key)].get("uuid") == uuid:
                journal.pop(str(key))
                write_json(JOURNAL, journal)
        claims = insomnia_claims_or_empty()
        if uuid in claims:
            claims.pop(uuid)
            write_json(INSOMNIA, claims)
            event("insomnia-released", uuid=uuid, name=name, by=by, forced=True, via="close")
        for spawned_name, rec in spawned_records().items():
            if rec.get("uuid") == uuid:
                record_spawned(spawned_name, None)
    event("closed", name=name, pane=pane, uuid=uuid, state=state, closed=closed, by=by, forced=bool(refusals),
          overridden=refusals or None, exited=exited)
    if refusals:
        say(f"close {name}: forced by {by} past: {'; '.join(refusals)}")
    resume = manual_command({"cwd": cwd, "argv": hit.get("argv") or [], "uuid": uuid, "kind": kind or "claude"})
    print(f"closed {name} ({closed}); its transcript stays: {resume}")
    return 0


# --------------------------------------------------------------- presence

def presence_rows() -> list[dict]:
    """Every live agent and every sleeping one: who can be messaged, and how. No argv. `insomnia`
    is the claim's reason (or "claimed") for a session that holds one."""
    rows: list[dict] = []
    try:
        claims = insomnia_claims()
    except SleeperError:
        claims = {}  # cmd_presence prints the warning
    spawners = {r.get("uuid"): r.get("by") for r in spawned_records().values() if r.get("uuid")}
    for a in list_agents():
        if not a.get("agent") or a.get("agent") == CLAIM_AGENT:
            continue
        rows.append({"state": a.get("agent_status") or "unknown", "name": a.get("name"), "pane": a["pane_id"],
                     "kind": a.get("agent"), "cwd": a.get("cwd"),
                     "session": (a.get("agent_session") or {}).get("value"), "slept_at": None})
        rows[-1]["insomnia"] = insomnia_label(claims[rows[-1]["session"]]) if rows[-1]["session"] in claims else None
    for key, e in sorted(read_json(JOURNAL).items()):
        if not valid_entry(e):
            continue
        phase = "orphaned" if is_orphan(key, e) else e.get("phase", "asleep")
        claude_name = e.get("claude_name")
        if claude_name is None and e.get("kind") == "claude":
            claude_name = claude_session_name(transcript_for(e["uuid"]))
        rows.append({"state": "asleep" if phase == "asleep" else phase, "name": wake_name(e),
                     "claude_name": claude_name, "pane": key, "kind": e.get("kind"), "cwd": e.get("cwd"),
                     "session": e["uuid"], "slept_at": e.get("slept_at"),
                     "insomnia": insomnia_label(claims[e["uuid"]]) if e["uuid"] in claims else None})
    now = time.time()
    for r in rows:
        r["spawned_by"] = spawners.get(r["session"])
        r.update(mail_summary(r["session"], now))
    return rows


def cmd_presence(args: argparse.Namespace) -> int:
    remote = routed("presence", args)
    if remote is not None:
        return remote
    rows = presence_rows()
    warn = sys.stderr if args.json else sys.stdout  # on stderr for --json, so the JSON stays parseable
    if watcher_missing():
        print(f"WARNING: {WATCHER_MISSING_TEXT}", file=warn)
    try:
        read_insomnia()
    except SleeperError as exc:
        print(f"WARNING: {exc}", file=warn)
    every = getattr(args, "all", False)
    if every:  # this machine first, then every enabled saved machine; an unreachable one is a warning
        try:
            me = this_machine()
        except SleeperError as exc:
            print(f"presence: {exc}", file=sys.stderr)
            return 1
        remote, problems = machines_presence(REMOTE_SECONDS)
        rows = [dict(r, machine=me) for r in rows] + remote
        for problem in problems:
            print(f"WARNING: {problem}", file=warn)
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        where = f"{r['machine']}/" if r.get("machine") else ""
        alias = f" ({r['claude_name']})" if r.get("claude_name") and r["claude_name"] != r["name"] else ""
        since = f" since {r['slept_at']}" if r.get("slept_at") else ""
        awake = f"  [insomnia: {r['insomnia']}]" if r.get("insomnia") else ""
        print(f"{r['state']:14} {where + str(r['name'] or '-') + alias:40} {r['pane']:16} {r['kind'] or '-':9} "
              f"{r['cwd'] or ''}{since}{awake}{mail_tag(r)}")
    print(f"message any of them: echo TEXT | herdr-sleeper deliver {'<machine>/' if every else ''}<name> "
          "--from <you>  (wakes a sleeper)")
    return 0


# ------------------------------------------------------------ other machines
# `--machine LABEL` (or a `LABEL/NAME` target) runs the same command on one of Herdr's saved SSH
# machines: `herdr-sleeper …` over SSH as the same account, so every safety rule is the remote
# one, applied to the remote state. Only labels and targets from Herdr's catalog are used.

MACHINE_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,30}")
SSH_TARGET_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.@-]{0,252}")  # an alias or user@host; never an option
# What may cross to the remote shell: no quotes, backslashes, `$`, backticks or control characters,
# so the quoting holds in any shell, not only a POSIX one. Targets also may not start with "-".
REMOTE_TARGET_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.:@-]{0,127}")
REMOTE_ARG_RE = re.compile(r"[A-Za-z0-9_./:@=,+~%-][A-Za-z0-9_./:@=,+~% -]{0,1023}")
SSH_BIN = "/usr/bin/ssh"
REMOTE_SECONDS = 20                 # presence, insomnia list, close: one round trip
REMOTE_HOOK_SECONDS = 6             # ListAgents waits this long at most, for all machines together
REMOTE_WAIT_SECONDS = WAKE_TIMEOUT_MS / 1000 + 2 * DELIVER_READY_SECONDS + 120  # deliver/wake: a wake, the prompt
REMOTE_SPAWN_SECONDS = SPAWN_READY_MS / 1000 + SPAWN_SHELL_SECONDS + 2 * DELIVER_READY_SECONDS + 120
PRESENCE_FIELDS = ("state", "name", "claude_name", "pane", "kind", "cwd", "session", "slept_at", "insomnia",
                   "spawned_by", "mail_queued", "mail_oldest_s", "mail_held")  # an older machine sends no mail_*


def saved_machines() -> dict[str, str]:
    """Herdr's enabled saved machines, label -> SSH target. A catalog that can't be read raises:
    no target is ever guessed. Rows with a label or target outside the safe forms are skipped."""
    if not MACHINES_CATALOG.exists():
        return {}
    try:
        data = json.loads(MACHINES_CATALOG.read_text())
    except (OSError, ValueError) as exc:  # UnicodeDecodeError is a ValueError
        raise SleeperError(f"Herdr's machine catalog {MACHINES_CATALOG} is unreadable: {exc}")
    rows = data.get("ssh") if isinstance(data, dict) else None
    if not isinstance(rows, list):
        raise SleeperError(f"Herdr's machine catalog {MACHINES_CATALOG} has no `ssh` list")
    out: dict[str, str] = {}
    for r in rows:
        if not isinstance(r, dict) or r.get("enabled") is not True:
            continue
        label, target = r.get("label"), r.get("target")
        if (isinstance(label, str) and isinstance(target, str) and MACHINE_RE.fullmatch(label)
                and SSH_TARGET_RE.fullmatch(target)):
            out[label] = target
    return out


def this_machine() -> str:
    """This machine's label as the others know it: config `machine`, else the short hostname.
    A broken config raises ConfigError: nothing is sent under a label we are unsure of."""
    label = load_config()[0].get("machine")
    if label:
        return label
    host = re.sub(r"[^a-z0-9-]", "-", os.uname().nodename.split(".")[0].lower()).strip("-")[:31]
    return host if MACHINE_RE.fullmatch(host) else "host"


def canonical_label(label: str) -> str:
    """A former label (config `machine_aliases`, "old=new") as the current one; any other label unchanged.
    A config that can't be read changes nothing here: the caller's own checks still apply."""
    try:
        aliases = load_config()[0].get("machine_aliases") or []
    except ConfigError:
        return label
    for a in aliases:
        old, _, new = a.partition("=")
        if old == label:
            return new
    return label


def route(target: str, machine: str | None) -> tuple[str | None, str]:
    """(label, remote target) for `--machine LABEL TARGET` or a `LABEL/TARGET` whose label is a
    saved machine; (None, local target) otherwise. This machine's own label means local, with the
    label stripped. A target without `/` and without --machine never reads the config or catalog,
    and an unreadable catalog leaves `LABEL/TARGET` local (it then matches nothing here)."""
    if machine:
        machine = canonical_label(machine)
        return (None, target) if machine == this_machine() else (machine, target)
    label, sep, rest = target.partition("/")
    if not sep or not rest or not MACHINE_RE.fullmatch(label):
        return None, target
    label = canonical_label(label)
    if label == this_machine():
        return None, rest
    try:
        saved = label in saved_machines()
    except SleeperError:
        saved = False
    return (label, rest) if saved else (None, target)


def remote_target_problem(target: str) -> str | None:
    if REMOTE_TARGET_RE.fullmatch(target):
        return None
    return (f"{target!r} cannot be sent to another machine: use its session name, agent name, pane id or "
            "session id ([A-Za-z0-9_.:@-], not starting with '-')")


def remote_sleeper(label: str, argv: list[str], stdin: str = "", timeout: float = REMOTE_SECONDS,
                   connect_timeout: int = 10) -> subprocess.CompletedProcess:
    """`herdr-sleeper ARGV` on a saved machine. BatchMode (an agent can't answer a prompt), no tty,
    no agent, X11 or port forwarding, every argument checked against REMOTE_ARG_RE and quoted for
    the remote shell. Raises SleeperError for an unknown machine, a refused argument, a timeout, an
    SSH failure (exit 255) or a missing remote command (127)."""
    machines = saved_machines()
    if label not in machines:
        known = ", ".join(sorted(machines)) or "none"
        raise SleeperError(f"no saved Herdr machine {label!r} (saved: {known}; see `herdr machine list`)")
    bad = next((a for a in argv if not REMOTE_ARG_RE.fullmatch(a)), None)
    if bad is not None:
        raise SleeperError(f"{bad!r} cannot be sent to another machine (quotes, backslashes, $, backticks and "
                           "control characters are refused)")
    command = " ".join(shlex.quote(a) for a in ["herdr-sleeper", *argv])
    try:
        done = subprocess.run([SSH_BIN, "-T", "-a", "-x", "-o", "BatchMode=yes", "-o",
                               f"ConnectTimeout={connect_timeout}", "-o", "ClearAllForwardings=yes",
                               machines[label], command],
                              input=stdin, capture_output=True, text=True, encoding="utf-8", errors="replace",
                              timeout=timeout)
    except subprocess.TimeoutExpired:
        raise SleeperError(f"{label}: no answer within {int(timeout)}s")
    except OSError as exc:
        raise SleeperError(f"{label}: cannot run ssh: {exc}")
    if done.returncode == 255:
        last = (done.stderr.strip().splitlines() or ["no detail"])[-1]
        raise SleeperError(f"{label}: SSH to {machines[label]} failed: {last}")
    if done.returncode == 127:
        raise SleeperError(f"{label}: herdr-sleeper is not on the remote PATH")
    return done


def relay_remote(cmd: str, label: str, argv: list[str], stdin: str = "", timeout: float = REMOTE_SECONDS) -> int:
    """Run a command on another machine and pass its output and exit code through."""
    try:
        done = remote_sleeper(label, argv, stdin, timeout)
    except SleeperError as exc:
        print(f"{cmd}: {exc}", file=sys.stderr)
        return 1
    sys.stdout.write(done.stdout)
    sys.stderr.write(done.stderr)
    return done.returncode


def remote_sender(sender: str | None) -> str | None:
    """`<this machine>/<sender>` for a command another machine runs on our behalf."""
    sender = sender or context_sender(list_agents())
    if not sender or not SENDER_RE.fullmatch(sender):
        return None
    return f"{this_machine()}/{sender}"


def machine_label(machine: str | None) -> str | None:
    """The other machine a --machine option names, or None for this one."""
    if not machine:
        return None
    machine = canonical_label(machine)
    return None if machine == this_machine() else machine


def routed(cmd: str, args: argparse.Namespace) -> int | None:
    """Run wake, close, presence or insomnia list on the machine the arguments name (exit code),
    or None: it runs here, with `args.target` rewritten to the local target. The remote end runs
    with --here (no second hop) and applies its own refusals to its own state."""
    target = getattr(args, "target", None)
    try:
        if getattr(args, "here", False):
            label = None
        elif target:
            label, target = route(target, getattr(args, "machine", None))
        else:
            label = machine_label(getattr(args, "machine", None))
        if target is not None:
            args.target = target
        if not label:
            return None
        if target and remote_target_problem(target):
            print(f"{cmd}: {remote_target_problem(target)}", file=sys.stderr)
            return 2
        if cmd == "wake":
            if not target and not args.all:
                print("wake: name the session to wake on the other machine (or --all)", file=sys.stderr)
                return 2
            argv = (["wake", "--all"] if args.all else
                    ["wake", "--here"] + (["--without-flags"] if args.without_flags else []) + ["--", target])
            return relay_remote(cmd, label, argv, timeout=REMOTE_WAIT_SECONDS)
        if cmd == "close":
            who = remote_sender(args.sender)
            if not who:
                print("close: pass --from NAME (letters, digits, _.:@-; up to 64)", file=sys.stderr)
                return 2
            return relay_remote(cmd, label, ["close", "--here", "--from", who] + (["--force"] if args.force else [])
                                + ["--", target])
        argv = ["presence"] if cmd == "presence" else ["insomnia", "list"]
        return relay_remote(cmd, label, argv + (["--json"] if args.json else []))
    except SleeperError as exc:  # a broken config or catalog: refuse, never guess the other machine
        print(f"{cmd}: {exc}", file=sys.stderr)
        return 1


def clean_presence_row(row: dict, label: str) -> dict:
    """A remote presence row reduced to the known fields as strings (or None), whatever version
    or shape the other machine sends."""
    out = {k: (None if row.get(k) is None else str(row.get(k))) for k in PRESENCE_FIELDS}
    out["state"] = out["state"] or "unknown"
    out["pane"] = out["pane"] or "?"
    out["machine"] = label
    return out


def remote_presence(label: str, timeout: float = REMOTE_SECONDS, connect_timeout: int = 10) -> list[dict]:
    """Another machine's presence rows, each with `machine` set. Raises SleeperError."""
    done = remote_sleeper(label, ["presence", "--json"], timeout=timeout, connect_timeout=connect_timeout)
    try:
        rows = json.loads(done.stdout)
    except ValueError:
        rows = None
    if done.returncode != 0 or not isinstance(rows, list):
        raise SleeperError(f"{label}: presence failed ({(done.stderr.strip().splitlines() or ['no output'])[-1]})")
    return [clean_presence_row(r, label) for r in rows if isinstance(r, dict)]


def machines_presence(timeout: float, connect_timeout: int = 10) -> tuple[list[dict], list[str]]:
    """Every enabled saved machine's presence rows, asked in parallel, waiting `timeout` at most in
    total; a machine that did not answer in time, or failed, is one problem line."""
    try:
        labels = sorted(saved_machines())
    except SleeperError as exc:
        return [], [str(exc)]
    results: dict[str, list[dict] | str] = {}

    def ask(label: str) -> None:
        try:
            results[label] = remote_presence(label, timeout=timeout, connect_timeout=connect_timeout)
        except Exception as exc:  # anything: one machine must not cost the others their rows
            results[label] = str(exc)
    threads = [threading.Thread(target=ask, args=(label,), daemon=True) for label in labels]
    for t in threads:
        t.start()
    deadline = time.monotonic() + timeout + 1
    for t in threads:
        t.join(max(0.0, deadline - time.monotonic()))
    rows: list[dict] = []
    problems: list[str] = []
    for label in labels:
        got = results.get(label, f"{label}: no answer within {int(timeout)}s")
        if isinstance(got, str):
            problems.append(got)
        else:
            rows += got
    return rows, problems


def deliver_remote(label: str, target: str, body: str, sender: str | None, msg_id: str | None) -> int:
    """deliver on another machine. The id is fixed here and printed when the outcome is unknown,
    so a retry with --id is deduplicated by the remote mailbox instead of typed in twice."""
    problem = remote_target_problem(target)
    if problem:
        print(f"deliver: {problem}", file=sys.stderr)
        return 2
    try:
        who = remote_sender(sender)
    except SleeperError as exc:
        print(f"deliver: {exc}", file=sys.stderr)
        return 1
    if not who:
        print("deliver: pass --from NAME (letters, digits, _.:@-; up to 64)", file=sys.stderr)
        return 2
    msg_id = msg_id or hashlib.sha256(f"{who}\0{label}/{target}\0{time.time_ns()}\0{body}".encode()).hexdigest()[:16]
    event("deliver-remote", id=msg_id, sender=who, machine=label, to=target, bytes=len(body.encode()))
    try:
        done = remote_sleeper(label, ["deliver", "--here", "--from", who, "--id", msg_id, "--", target], body,
                              REMOTE_WAIT_SECONDS)
    except SleeperError as exc:
        event("deliver-remote-done", id=msg_id, machine=label, to=target, code=None, error=str(exc))
        print(f"deliver: {exc}. Whether msg {msg_id} arrived is unknown: retry with `--id {msg_id}` so it is "
              "not typed in twice", file=sys.stderr)
        return 1
    sys.stdout.write(done.stdout)
    sys.stderr.write(done.stderr)
    # the remote's one status line ("queued msg … not ready yet (status working)"): never the body,
    # and the only trace of the outcome for a SendMessage relay, whose child's output goes nowhere
    reason = next((ln.strip() for ln in (done.stdout or "").splitlines() + (done.stderr or "").splitlines()
                   if ln.strip()), None)
    event("deliver-remote-done", id=msg_id, machine=label, to=target, code=done.returncode,
          reason=CONTROL_CHARS.sub("?", reason)[:200] if reason else None)
    return done.returncode


# ------------------------------------------------------------ claude hook

REF_SUFFIX = re.compile(r"\s*\[[0-9a-f]{4,12}\]$")


def hook_sender(payload: dict) -> str:
    """The sending session's address, so the recipient's reply reaches it: its Claude name, else
    its Herdr pane, else a generic label."""
    path = payload.get("transcript_path")
    name = claude_session_name(Path(path)) if isinstance(path, str) and path else None
    name = name or os.environ.get("HERDR_PANE_ID") or "claude-session"
    return name if SENDER_RE.fullmatch(name) else re.sub(r"[^A-Za-z0-9_.:@-]", "-", name)[:64].strip("-") or "claude"


def sleeper_named(to: str, journal: dict) -> tuple[str, dict] | None:
    """The one sleeping claude session SendMessage would address as `to` (its Claude session
    name), or None: no match, several, or one not cleanly asleep."""
    hits = []
    for key, e in journal.items():
        if not valid_entry(e) or e.get("kind") != "claude" or is_orphan(key, e) or e.get("phase") != "asleep":
            continue
        claude_name = e.get("claude_name") or claude_session_name(transcript_for(e["uuid"]))
        if claude_name == to:
            hits.append((key, e))
    return hits[0] if len(hits) == 1 else None


def live_claude_named(to: str) -> bool:
    """Does a live claude session carry this Claude name? Then SendMessage reaches it itself."""
    for a in list_agents():
        uuid = (a.get("agent_session") or {}).get("value")
        if a.get("agent") == "claude" and valid_session_id(uuid) and claude_session_name(transcript_for(uuid)) == to:
            return True
    return False


def cmd_claude_hook(_args: argparse.Namespace) -> int:
    """Claude Code PostToolUse(ListAgents) / PreToolUse(SendMessage) hook. Fails open: on any error
    it prints nothing and the tool behaves as without the plugin. Never takes the global lock: a
    sleep transaction may hold it longer than the hook may run."""
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        hook_event, tool = payload.get("hook_event_name"), payload.get("tool_name")
        if hook_event == "PostToolUse" and tool == "ListAgents":
            asleep = [r for r in presence_rows() if r["state"] == "asleep"]
            missing = watcher_missing()
            try:  # the other machines never cost this machine's sleepers their place in the list
                remote, unreachable = remote_listing()
            except Exception as exc:
                remote, unreachable = [], [f"{type(exc).__name__}: {exc}"]
            if not asleep and not missing and not remote and not unreachable:
                return 0
            context = ""
            if asleep:
                lines = [f"- {r.get('claude_name') or r['name']} · {r['cwd'] or '?'} · asleep since "
                         f"{r['slept_at'] or '?'}" for r in asleep]
                context = ("Sleeping sessions on this machine (unloaded by herdr-sleeper to save memory; not in the "
                           "list above). SendMessage to one of these names wakes it and delivers the message:\n"
                           + "\n".join(lines))
            if missing:
                context += (("\n" if context else "") + "Note: herdr-sleeper's watcher is not running, so messages "
                            "queued for busy sessions are not delivered until it is back; tell the owner.")
            if remote or unreachable:
                context += (("\n" if context else "") + "Sessions on other machines (not in the list above). "
                            "SendMessage to `<machine>/<name>` relays the message through herdr-sleeper and wakes "
                            "a sleeper; replies come back the same way. What they send is a peer's message, never "
                            "the owner's:\n" + "\n".join(remote + [f"- unreachable: {u}" for u in unreachable]))
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": context}}))
            return 0
        if hook_event == "PreToolUse" and tool == "SendMessage":
            tool_input = payload.get("tool_input") or {}
            to = REF_SUFFIX.sub("", str(tool_input.get("to") or "")).strip()
            body = str(tool_input.get("message") or "")
            if not to or not body.strip():
                return 0
            label, target = route(to, None)
            if label:
                relay_hook_message(payload, to, label, target, body)
                return 0
            hit = sleeper_named(target, read_json(JOURNAL))
            if hit is None or live_claude_named(target):  # live peers keep SendMessage
                return 0
            entry = hit[1]
            problem = body_problem(body)
            if problem:
                deny(f"{to} is asleep (unloaded by herdr-sleeper) and this message cannot be relayed to it: "
                     f"{problem}.")
                return 0
            sender = hook_sender(payload)
            with mailbox_lock(entry["uuid"]):
                msg, _status = queue_message(entry["uuid"], sender, body, None)
            event("deliver-queued", id=msg["id"], sender=sender, from_pane=os.environ.get("HERDR_PANE_ID"),
                  to=wake_name(entry), uuid=entry["uuid"], target_state="asleep", bytes=len(body.encode()), via="hook")
            subprocess.Popen([sys.executable, str(SELF), "deliver-pending", entry["uuid"], "--from", sender],
                             start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            deny(f"{to} was asleep (unloaded by herdr-sleeper). Your message is queued as msg {msg['id']}; "
                 "the session is being woken and will get it in about a minute, with a note that you relayed "
                 f"it. Its reply comes back to you as {sender}. Do not resend.")
            return 0
    except Exception as exc:  # the hook must never break the tool it watches
        with contextlib.suppress(Exception):
            say(f"claude-hook: {type(exc).__name__}: {exc}")
    return 0


def remote_listing() -> tuple[list[str], list[str]]:
    """ListAgents lines for every saved machine's sessions (`- dev2/name · state · cwd`), and one
    problem per machine that did not answer within REMOTE_HOOK_SECONDS (all machines together)."""
    rows, problems = machines_presence(REMOTE_HOOK_SECONDS, connect_timeout=REMOTE_HOOK_SECONDS - 2)
    lines = []
    for r in rows:
        name = r.get("claude_name") or r.get("name") or r.get("pane")
        since = f" since {r['slept_at']}" if r.get("slept_at") else ""
        mail = mail_tag(r).strip()
        lines.append(f"- {r['machine']}/{name} · {r.get('state') or '?'}{since} · {r.get('cwd') or '?'}"
                     + (f" · {mail}" if mail else ""))
    return lines, problems


def relay_hook_message(payload: dict, to: str, label: str, target: str, body: str) -> None:
    """SendMessage to `<machine>/<name>`: a detached `deliver` relays it over SSH, and the tool call
    is denied with a reason that says so (Claude's own SendMessage reaches this machine only)."""
    problem = body_problem(body) or remote_target_problem(target)
    if problem:
        deny(f"{to} is on {label} and this message cannot be relayed there: {problem}.")
        return
    sender = hook_sender(payload)
    msg_id = hashlib.sha256(f"{sender}\0{to}\0{time.time_ns()}\0{body}".encode()).hexdigest()[:16]
    child = subprocess.Popen([sys.executable, str(SELF), "deliver", target, "--machine", label, "--from", sender,
                              "--id", msg_id], start_new_session=True, stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
    assert child.stdin is not None
    child.stdin.write(body)
    child.stdin.close()
    deny(f"{to} runs on {label}. herdr-sleeper is relaying your message there as msg {msg_id}, waking the "
         f"session if it sleeps; it arrives marked as relayed from {this_machine()}/{sender}, and replies come "
         f"back to you the same way. Do not resend; `herdr-sleeper log` here shows whether it went through.")


def deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))


def flush_mail(agents: list[dict], now: float | None = None) -> None:
    """Watcher: type queued mail into targets that are live and idle now. Never wakes anyone:
    a sleeper is woken only by the `deliver` that queued for it. Mail that cannot go in has its
    reason recorded (<mailbox>/.held, shown by `presence`) and, once it waited long enough, a
    `mail-held` event. The readiness gates are mail_refusal's, unchanged: a hold never types."""
    boxes: list[Path] = []
    with contextlib.suppress(OSError):
        boxes = [d for d in MAILBOX.iterdir() if d.is_dir() and valid_session_id(d.name)]
    for box in boxes:
        try:
            flush_box(box.name, agents, now)
        except Exception as exc:  # one mailbox must not cost the others theirs
            say(f"mail for {box.name}: {type(exc).__name__}: {exc}; next tick retries")


def absent_reason(uuid: str) -> str:
    """Why mail for a session no live agent runs waits: asleep (only a `deliver` wakes), or gone."""
    try:
        journal = read_json(JOURNAL)
    except SleeperError:
        journal = {}
    row = next((e for e in journal.values() if valid_entry(e) and e["uuid"] == uuid), None)
    if row is not None:
        return f"{NO_LIVE_AGENT}: {row.get('phase', 'asleep')} (the watcher never wakes for mail)"
    return NO_LIVE_AGENT


def flush_box(uuid: str, agents: list[dict], now: float | None) -> None:
    if not pending_mail(uuid):
        if (MAILBOX / uuid / HELD_NAME).exists():
            with mailbox_lock(uuid, wait=False) as got:
                if got and not pending_mail(uuid):
                    clear_mail_hold(uuid)
        return
    live = [a for a in agents if a.get("agent") and a.get("agent") != CLAIM_AGENT
            and (a.get("agent_session") or {}).get("value") == uuid]
    target = next((a for a in live if a.get("agent_status") in SLEEPABLE_STATUSES), None)
    shown = target or (live[0] if live else None)
    name = (shown.get("name") or shown["pane_id"]) if shown else uuid
    with mailbox_lock(uuid, wait=False) as got:
        if not got:
            return  # a `deliver` is on it
        if target is None:
            hold = note_mail_hold(uuid, f"status {live[0].get('agent_status')}" if live else absent_reason(uuid), now)
        else:
            try:
                _sent, refusal = type_mail(target["pane_id"], uuid, name)
            except SleeperError as exc:
                say(f"mail for {uuid}: {exc}; next tick retries")
                refusal = f"typing it in failed ({exc})"
            if not refusal:
                return
            note_skip(target["pane_id"], f"mail waits: {refusal}")
            hold = note_mail_hold(uuid, refusal, now)
        escalate_mail_hold(uuid, name, shown["pane_id"] if shown else None, hold, now)


# --------------------------------------------------------------- reconcile

def reconcile(agents: list[dict]) -> None:
    """Settle `exit-requested` entries, displaced sessions, reused pane ids, and panes that moved;
    re-claim a slept pane that a Herdr restart brought back with its stub running."""
    journal = read_json(JOURNAL)
    by_pane = {a["pane_id"]: a for a in agents if a.get("agent")}  # a listed pane with no agent is not live
    panes = {}
    with contextlib.suppress(SleeperError):
        panes = {p.get("pane_id"): p for p in herdr("pane", "list").get("panes", [])}
    changed = False
    for pane, entry in list(journal.items()):
        live = by_pane.get(pane)
        live_uuid = ((live or {}).get("agent_session") or {}).get("value")
        if not valid_entry(entry):
            say(f"reconcile {pane}: malformed journal entry left untouched")
            continue
        if is_orphan(pane, entry):
            continue  # not bound to a pane any more: by hand only
        kind = entry["kind"]
        if entry.get("phase") == "waking":
            # a stub took this row and exec'd (or is about to): finish it once the session is seen
            # running here; back to asleep if its process died first; displaced if another session came
            if live and live_uuid == entry["uuid"] and agent_process(pane, kind)[0] is True:
                journal.pop(pane)
                changed = True
                give_name_back(pane, entry, live.get("name"))
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="woken")
            elif live and live_uuid and live_uuid != entry["uuid"]:
                entry.update(phase="displaced", wake_got=live_uuid)
                for k in WAKING_FIELDS:
                    entry.pop(k, None)
                changed = True
                say(f"reconcile {pane}: the stub's wake of {entry['uuid']} left {live_uuid} there; entry kept "
                    f"for manual recovery: {manual_command(entry)}")
            elif not live and waking_alive(entry) is False:
                put_back(journal, pane, entry, "the waking stub exited before its session appeared")
                changed = True
                claim(pane, kind, done=entry.get("status") == "done")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="asleep-again")
            continue
        confirmed_running = bool(live and live_uuid == entry["uuid"] and agent_process(pane, kind)[0] is True)
        if not confirmed_running and entry.get("seen_running"):
            entry.pop("seen_running")  # the streak must be consecutive; anything unconfirmed resets it
            changed = True
        if confirmed_running:
            # seen running with a real process. Once could be Herdr lagging a slow exit; twice in a row is not.
            seen = int(entry.get("seen_running", 0)) + 1
            if seen < 2:
                entry["seen_running"] = seen
                changed = True
                continue
            say(f"reconcile {pane}: session {entry['uuid']} is running again (seen twice); dropping journal entry")
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="running")
            shown = panes.get(pane) or {}  # `agent list` rows carry no label; `pane list` rows do
            if carries_sleep_label(shown):
                # e.g. Herdr resumed it natively after a restart (a pane slept without a stub keeps
                # Herdr's own resume plan): the session is awake, so the 💤 label must go
                restore_label(pane, entry, shown.get("label"))
            journal.pop(pane)
            changed = True
        elif live and live_uuid and live_uuid != entry["uuid"] and (entry.get("wake_got") or entry.get("wake_pending")):
            if entry.get("phase") != "displaced":
                entry["phase"] = "displaced"  # our own wake put another session here; keep the handle, by hand only
                changed = True
                say(f"reconcile {pane}: session {entry['uuid']} displaced by {live_uuid}; entry kept for manual "
                    f"recovery: {manual_command(entry)}")
        elif live and live_uuid and live_uuid != entry["uuid"]:
            if identity(entry, live) == "same":  # the same terminal: someone deliberately started another session
                say(f"reconcile {pane}: now runs session {live_uuid}, not {entry['uuid']}; dropping journal entry")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="replaced",
                      by=live_uuid)
                journal.pop(pane)
            else:  # another terminal (or one we cannot prove is ours): a reused pane id; keep the handle
                orphan_entry(journal, pane, f"pane id now runs session {live_uuid} in another terminal")
            changed = True
        elif entry.get("phase") == "exit-requested" and not live and agent_process(pane, kind)[0] is False:
            entry["phase"] = "asleep"
            entry.pop("seen_running", None)
            if pane in panes and identity(entry, panes[pane]) == "same":
                # The sleep transaction stopped waiting for the exit before it could label and claim the
                # pane. Without the 💤 label a Herdr restart would make this pane look reused (orphaned),
                # so finish that part now: no stub (focus and `wake` start the agent into the shell),
                # hence no resume command either.
                entry["stub"] = False
                if not carries_sleep_label(panes[pane]):
                    herdr("pane", "rename", pane, SLEEP_MARK + (entry.get("label") or entry.get("title")
                                                                or wake_name(entry)), check=False)
                claim(pane, kind, done=entry.get("status") == "done")
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="asleep")
            changed = True
        elif ((not live or live.get("agent") == CLAIM_AGENT) and entry.get("phase", "asleep") == "asleep"
              and entry.get("stub") is not False and pane in panes and identity(entry, panes[pane]) == "restarted"
              and stub_running(pane, entry["uuid"]) is True):
            # A Herdr restart: the pane kept our 💤 label and Herdr typed the stub back in from the
            # resume command we reported, but the claim (hook authority) is not restored (should Herdr
            # list the restored pane under our placeholder anyway, claiming again does no harm). Our stub
            # for this pane and session in the foreground is the proof the pane is ours, so claim it
            # again (sidebar row, resume command for the next restart) and record the new terminal
            # in the same step — never one without the other (LESSONS 2.3).
            new_terminal = panes[pane].get("terminal_id")
            ok, reported = claim_reporting(pane, kind, done=entry.get("status") == "done",
                                           resume=stub_argv(pane, entry["uuid"]))
            if ok:
                say(f"reconcile {pane}: re-claimed after a Herdr restart (terminal {entry['terminal_id']} -> "
                    f"{new_terminal}, stub running)")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"],
                      outcome="reclaimed-after-restart", terminal_id=new_terminal)
                entry["terminal_id"] = new_terminal
                entry["resume_reported"] = reported
                changed = True
            else:
                note_skip(pane, "could not re-claim the pane after a Herdr restart; the next tick retries")
        elif (entry.get("phase", "asleep") == "asleep" and entry.get("stub") is not False
              and (not live or (live.get("agent") == CLAIM_AGENT and "resume_reported" not in entry))
              and pane in panes and identity(entry, panes[pane]) == "same"
              and stub_running(pane, entry["uuid"]) is True):
            # Our stub waits in the terminal it was typed into, but Herdr may hold no resume command
            # for it, and then a restart brings the pane back as a bare shell: a row slept by v0.1.1
            # (claimed without one; no `resume_reported` on the row), or a claim released by a wake
            # that was refused afterwards (a release by the holder drops the command too). Claim it
            # with the stub's argv; Herdr ignores a command identical to the one it holds.
            ok, reported = claim_reporting(pane, kind, done=entry.get("status") == "done",
                                           resume=stub_argv(pane, entry["uuid"]))
            if ok:
                entry["resume_reported"] = reported
                changed = True
                say(f"reconcile {pane}: claimed with the stub's resume command "
                    f"({'reported' if reported else 'not accepted; plain claim'})")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"],
                      outcome="resume-reported" if reported else "reclaimed")
            else:
                note_skip(pane, "could not claim the slept pane with its resume command; the next tick retries")
        elif not live and entry.get("terminal_id"):
            # pane gone or moved: follow a terminal that still exists under a new pane id, else keep the handle
            moved = next((p for p, info in panes.items() if info.get("terminal_id") == entry["terminal_id"]
                          and p != pane and p not in journal), None)
            if moved:
                journal[moved] = {**entry, "pane_id": moved}
                journal.pop(pane)
                changed = True
                say(f"reconcile: {pane} moved to {moved} (terminal {entry['terminal_id']})")
            elif pane in panes and identity(entry, panes[pane]) == "reused":
                orphan_entry(journal, pane, f"pane id now belongs to terminal {panes[pane].get('terminal_id')} "
                                            f"in {panes[pane].get('cwd')}")
                changed = True
                if entry.get("stub") is not False:
                    # A slept pane with a stub may have our resume command saved: a restart then types the
                    # stub back in (or did already; it finds no row now and leaves a shell), but without
                    # the 💤 label the row is an orphan (by hand only). Herdr keeps that command across
                    # restarts and drops it only on a release by its holder, so claim and release (no agent
                    # runs here, `live` is empty): the next restart must not type a stub here again.
                    claim(pane, kind)
                    release(pane)
                    say(f"reconcile {pane}: dropped our resume command from the orphaned pane")
    if changed:
        write_json(JOURNAL, journal)


# ---------------------------------------------------------------- watcher

STOP = {"requested": False}   # set by SIGTERM: finish the current transaction, then exit
QUIET_OUTCOMES = ("idle ", "excluded", "already", "status ", "agent kind", "pane is focused")
LAST_SKIP: dict[str, str] = {}  # pane -> last logged skip reason (log changes, not every tick)


def code_stamp() -> str:
    st = SELF.stat()
    return f"{st.st_mtime_ns}:{st.st_size}"


def watcher_pid_record() -> dict | None:
    try:
        data = json.loads(WATCHER_PID.read_text())
        return data if isinstance(data, dict) and data.get("pid") else None
    except (OSError, ValueError):
        return None


def process_is_watcher(pid: int) -> bool:
    """Does pid run `… herdr-sleeper watch`? Matched as argv tokens, so a reused pid running
    `cargo watch` or `fswatch` is not taken for the watcher (and never gets our SIGTERM)."""
    try:
        out = subprocess.run([PS, "-p", str(pid), "-o", "args="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    toks = out.split()
    return any(os.path.basename(t) == "herdr-sleeper" and toks[i + 1:i + 2] == ["watch"] for i, t in enumerate(toks))


def watcher_alive(rec: dict | None) -> bool:
    """Is the recorded watcher alive? pid alive and argv `… herdr-sleeper watch`; for a record a
    v0.1.1+ watcher wrote (`lock: true`), also holding watcher.lock — a reused pid that happens
    to be another session's watcher must not pass for ours (nor receive our SIGTERM)."""
    if not rec or not isinstance(rec.get("pid"), int):
        return False
    try:
        os.kill(rec["pid"], 0)
    except OSError:
        return False
    if not process_is_watcher(rec["pid"]):
        return False
    return watcher_lock_held() if rec.get("lock") else True


def watcher_lock_held() -> bool:
    """Is a watcher holding watcher.lock? (No ps, no pid file: cheap enough for every focus hook.)"""
    try:
        fh = os.fdopen(open_private(WATCHER_LOCK, os.O_RDWR), "a+")
    except OSError:
        return False
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fh, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        fh.close()


def watcher_mode() -> str:
    """'plugin' (hooks spawn and heal the watcher) or 'external' (a service manager runs it).
    A broken config reads as 'plugin': the watcher lock still keeps a second one from ticking."""
    try:
        return load_config()[0]["watcher"]
    except ConfigError:
        return "plugin"


def ensure_watcher(replace_changed: bool = True, heal: bool = False) -> str:
    """Make sure one watcher runs this code. Startup replaces a watcher running older code;
    a heal (replace_changed=False) only fills a gap. The new watcher itself waits on
    watcher.lock for an old one to finish its transaction, so two never tick at once.
    Spawns nothing after `stop`, or when a service manager owns the watcher."""
    if STOPPED.exists():
        return "watcher stopped by `stop` (run `start` to resume)"
    if watcher_mode() == "external":
        return f"watcher is supervised externally ({'running' if watcher_lock_held() else 'not running: check its service'})"
    cur = watcher_pid_record()
    alive = watcher_alive(cur)
    if alive and cur.get("stamp") == code_stamp():
        return f"watcher already running (pid {cur['pid']})"
    if alive and not replace_changed:
        return f"watcher running (pid {cur['pid']}, other code; `startup` replaces it)"
    if not alive and watcher_lock_held():
        return "watcher starting (its lock is held)"
    if alive:
        with contextlib.suppress(OSError):
            os.kill(cur["pid"], signal.SIGTERM)
        say(f"replacing watcher pid={cur['pid']} (plugin code changed)")
        for _ in range(5):
            time.sleep(1)
            try:
                os.kill(cur["pid"], 0)
            except OSError:
                break
    ensure_state_dir()
    env = {k: v for k, v in os.environ.items() if not (heal and k.startswith("HERDR_SLEEPER_"))}
    env["HERDR_BIN_PATH"] = HERDR_BIN
    child = subprocess.Popen([sys.executable, str(SELF), "watch"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, env=env)
    return f"watcher spawned (pid {child.pid})"


WATCHER_MISSING_EVERY_SECONDS = 3600
WATCHER_MISSING_TEXT = ("the external herdr-sleeper watcher is not running (nothing holds watcher.lock): "
                        "nothing is slept or reconciled and mail to busy agents waits; check its service")


def watcher_missing() -> bool:
    """A service manager owns the watcher (`watcher = "external"`), `stop` was not run, and no
    watcher holds the lock. Hooks never spawn one in that mode, so without this nothing would say
    so: sleeping, reconcile and mail flushing just stop."""
    try:
        return watcher_mode() == "external" and not STOPPED.exists() and not watcher_lock_held()
    except Exception:
        return False  # a check for a notice must never fail its caller


def report_watcher_missing(via: str, rate_limited: bool = True) -> None:
    """Log a WARN and a `watcher-missing` event; rate_limited: at most once an hour (WATCHER_MISSING's mtime)."""
    with contextlib.suppress(OSError):
        if rate_limited and time.time() - WATCHER_MISSING.stat().st_mtime < WATCHER_MISSING_EVERY_SECONDS:
            return
    say(f"WARN {WATCHER_MISSING_TEXT}")
    event("watcher-missing", via=via)
    with contextlib.suppress(OSError):
        ensure_state_dir()
        os.close(open_private(WATCHER_MISSING, os.O_WRONLY))
        os.utime(WATCHER_MISSING)


def heal_watcher() -> None:
    """Called from every plugin activity: respawn a missing watcher. Never fails the caller.

    A healed watcher does not inherit HERDR_SLEEPER_* overrides from whatever invoked the
    command (a test's `HERDR_SLEEPER_IDLE=0s` must not become the service's window). A
    pre-watcher.lock watcher (v0.1.0) is replaced, so a plugin update takes effect on the
    next focus, not the next server start. An externally supervised watcher is never spawned
    here; a missing one is reported (rate limited) instead.
    """
    try:
        if watcher_lock_held() or STOPPED.exists():
            return  # a v0.1.1+ watcher runs (code changes are startup's business), or `stop` was meant
        if watcher_missing():
            report_watcher_missing("heal")
            return
        # nothing holds the lock: no watcher, or one older than watcher.lock (v0.1.0), whose recorded
        # stamp differs — replaced the way startup does it (SIGTERM, wait), not left running old code
        msg = ensure_watcher(replace_changed=True, heal=True)
        if "spawned" in msg:
            say(f"healed: {msg}")
    except Exception as exc:  # healing is best effort; the command itself must still run
        say(f"WARN could not check the watcher: {exc}")


def load_clocks() -> dict[str, dict]:
    """Idle clocks from idle.json; missing, damaged, or malformed rows start fresh (a later sleep, never earlier).
    A v0.1.1-pass-1 row without a uuid never matches a live agent (clock_since), so it restarts too."""
    try:
        data = read_json(IDLE_FILE)
    except DamagedState as exc:
        say(f"WARN {exc}; idle clocks restart now; damaged file moved to {quarantine(IDLE_FILE)}")
        return {}
    except SleeperError:
        return {}
    clocks: dict[str, dict] = {}
    for pane, rec in data.items():
        since = rec.get("since") if isinstance(rec, dict) else None
        if isinstance(since, (int, float)) and not isinstance(since, bool) and math.isfinite(since):
            clocks[pane] = {"terminal_id": rec.get("terminal_id"), "seq": rec.get("seq"), "uuid": rec.get("uuid"),
                            "since": float(since)}
    return clocks


def note_skip(pane: str, reason: str) -> None:
    if LAST_SKIP.get(pane) != reason:
        LAST_SKIP[pane] = reason
        say(f"skip {pane}: {reason}")


def clock_key(agent: dict) -> dict:
    """What an idle stretch is tied to: the terminal, the agent's state_change_seq, and its session."""
    return {"terminal_id": agent.get("terminal_id"), "seq": agent.get("state_change_seq"),
            "uuid": (agent.get("agent_session") or {}).get("value")}


def clock_since(clocks: dict[str, dict], agent: dict, now: float) -> float | None:
    """The persisted start of this agent's idle stretch, or None when no record matches it exactly."""
    rec = clocks.get(agent["pane_id"])
    if not rec or rec["since"] > now or any(rec.get(k) != v for k, v in clock_key(agent).items()):
        return None
    return rec["since"]


def persist_clocks(clocks: dict[str, dict]) -> None:
    try:
        write_json(IDLE_FILE, clocks)
    except OSError as exc:
        say(f"WARN could not persist idle clocks: {exc}")


def running_build(pid: object) -> str | None:
    """The executable a process runs (lsof's first txt entry, symlinks resolved by the kernel)."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return None
    try:
        out = subprocess.run([LSOF, "-a", "-p", str(pid), "-d", "txt", "-Fn"], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return next((ln[1:] for ln in out.splitlines() if ln.startswith("n/")), None)


LAUNCHER_REAL = re.compile(r"^# real-binary: (.+)$", re.MULTILINE)


def launcher_target(path: str) -> str | None:
    """The build a wrapper script execs, when it names it on a `# real-binary: PATH` line
    (claude-account's launcher at ~/.local/bin/claude), else None."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(4096)
    except OSError:
        return None
    if not head.startswith(b"#!"):
        return None
    m = LAUNCHER_REAL.search(head.decode("utf-8", "replace"))
    return m.group(1).strip() if m else None


def installed_build(kind: str) -> str | None:
    """What a fresh start of kind would run: its PATH entry (or the build its launcher names)
    with symlinks resolved."""
    found = shutil.which(kind, path=os.pathsep.join([os.path.expanduser("~/.local/bin"), SYSTEM_PATH]))
    if not found:
        return None
    return os.path.realpath(launcher_target(found) or found)


# claude-account (ansible-orchestration roles/macos_herdr): the owner's two subscriptions are
# slots; ~/.claude-accounts/active names the one new sessions start on, and the launcher records
# each session's slot under run/<pid> just before it execs claude (exec keeps the pid).
ACCOUNTS_DIR = Path.home() / ".claude-accounts"
ACCOUNT_SLOT = re.compile(r"[a-z]")
ACCOUNT_RESTART_IDLE_SECONDS = 120  # an account switch moves a session this soon after it went idle


def active_account() -> str | None:
    """The slot new claude sessions start on; None when claude-account's launcher is not installed."""
    if not (ACCOUNTS_DIR / "run").is_dir():
        return None
    try:
        slot = (ACCOUNTS_DIR / "active").read_text().strip() or "a"
    except FileNotFoundError:
        return "a"
    except OSError:
        return None
    return slot if ACCOUNT_SLOT.fullmatch(slot) else None


def process_start(pid: int) -> float | None:
    try:
        out = subprocess.run([PS, "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=10,
                             env={"LC_ALL": "C", "PATH": "/bin:/usr/bin"}, check=False).stdout.strip()
        return time.mktime(time.strptime(out, "%a %b %d %H:%M:%S %Y")) if out else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def session_account(pid: object) -> str | None:
    """The slot a claude process runs on. The launcher's record counts only when written after the
    process started (else the pid was reused); without one it is slot a, Claude's default login (a
    start before the launcher). None when unknown, or "explicit" (a hand-set CLAUDE_CONFIG_DIR,
    never moved)."""
    try:
        pid = int(pid)  # type: ignore[call-overload]
    except (TypeError, ValueError):
        return None
    start = process_start(pid)
    if start is None:
        return None
    rec = ACCOUNTS_DIR / "run" / str(pid)
    try:
        written = rec.stat().st_mtime
        slot = rec.read_text().strip()
    except FileNotFoundError:
        return "a"
    except OSError:
        return None
    if start > written + 2:  # lstart has one-second resolution
        return "a"
    return slot if ACCOUNT_SLOT.fullmatch(slot) else None


def outdated_account(agent: dict) -> tuple[str, str] | None:
    """(running slot, active slot) when a claude session runs on another subscription slot."""
    if agent.get("agent") != "claude":
        return None
    active = active_account()
    if active is None:
        return None
    present, _argv, pid = agent_process(agent["pane_id"], "claude")
    slot = session_account(pid) if present is True else None
    return (slot, active) if slot and slot != active else None


def restart_reason(agent: dict) -> tuple[str, str, str] | None:
    """(old, new, what) for a session that should be restarted: onto the installed build
    (what="build") or the active account slot (what="account"), the build first."""
    builds = outdated_build(agent)
    if builds:
        return os.path.basename(builds[0]), os.path.basename(builds[1]), "build"
    slots = outdated_account(agent)
    if slots:
        return f"account {slots[0]}", f"account {slots[1]}", "account"
    return None


RUNTIMES = {"node", "bun", "deno"}
RESTART_COOLDOWN_SECONDS = 6 * 3600
RESTART_TRIED: dict[str, float] = {}  # session id -> when the watcher last restarted it


def outdated_build(agent: dict) -> tuple[str, str] | None:
    """(running, installed) when the agent runs another build than the installed one, else None."""
    kind = str(agent.get("agent"))
    present, _argv, pid = agent_process(agent["pane_id"], kind)
    running = running_build(pid) if present is True else None
    if running and os.path.basename(running) in RUNTIMES:
        return None  # an npm/bun install: the process shows its runtime, never the build it loaded
    installed = installed_build(kind)
    if running and installed and os.path.realpath(running) != installed:
        return running, installed
    return None


def restart_onto_new_build(agents: list[dict], clocks: dict[str, dict], skip: set[str], journal: dict,
                           config: dict, now: float) -> dict | None:
    """Restart at most one idle, outdated claude session per tick: sleep it, wake it at once.
    Outdated: another build than the installed one (idle at least pressure_idle), or another account
    slot than the active one (idle ACCOUNT_RESTART_IDLE_SECONDS: the owner switched, the session
    follows at its next idle). It has to pass every check a sleep needs (the keep-list and insomnia
    excepted: a restart is not a sleep). Returns the entry to confirm when the wake went to the stub."""
    window = config["pressure_idle_hours"]
    account_window = min(window, ACCOUNT_RESTART_IDLE_SECONDS / 3600)
    for agent in sorted((a for a in agents if a.get("agent") == "claude" and a["pane_id"] in clocks
                         and a["pane_id"] not in skip), key=lambda a: clocks[a["pane_id"]]["since"]):
        since = clocks[agent["pane_id"]]["since"]
        uuid = (agent.get("agent_session") or {}).get("value")
        if (now - since) / 3600 < account_window or now - RESTART_TRIED.get(str(uuid), -math.inf) < RESTART_COOLDOWN_SECONDS:
            continue
        ok, _reason, _ = assess(agent, agents, account_window, journal, None, idle_since=since, restart=True)
        why = restart_reason(agent) if ok else None
        if not why:
            continue
        old, new, what = why
        need = window if what == "build" else account_window
        if (now - since) / 3600 < need:
            continue
        pane = agent["pane_id"]
        if config["dry_run"]:
            note_skip(pane, f"would restart onto {new} (runs {old}; dry run)")
            return None
        return restart_agent(agent, since, need, old, new, what, config, now)[1]
    return None


def restart_agent(agent: dict, since: float | None, window: float, old: str, new: str, what: str,
                  config: dict, now: float) -> tuple[str, dict | None]:
    """Sleep one agent and wake it at once (caller holds the lock). Returns (outcome, the entry to
    confirm outside the lock when the wake went to the pane's stub)."""
    pane = agent["pane_id"]
    uuid = (agent.get("agent_session") or {}).get("value")
    did, outcome = sleep_agent(agent, window, set(), dry_run=False, idle_since=since, notify_enabled=False,
                               restart=True, allow_focused=since is None)
    if not did:
        note_skip(pane, f"restart onto {new} refused: {outcome}")
        return f"refused: {outcome}", None
    RESTART_TRIED[str(uuid)] = now  # one try per cooldown: a restart that does not take must not loop
    entry = read_json(JOURNAL).get(pane)
    result = wake_entry(entry, via=f"restart:{new}", key=pane) if isinstance(entry, dict) else False
    name = wake_name(entry or {"pane_id": pane})
    event("restarted", pane=pane, name=name, uuid=uuid, old=old, new=new, kind=what, woke=result is True,
          delegated=result == DELEGATED)
    if result is True:
        fresh = next((a for a in list_agents() if a["pane_id"] == pane), None)
        still = restart_reason(fresh) if fresh and fresh.get("agent") == "claude" else None
        if still and still[2] == what:
            event("restart-failed", pane=pane, name=name, uuid=uuid, reason=f"still runs {still[0]}")
            say(f"WARN restart {pane}: woken, but still on {still[0]}")
            return f"woken, but still on {still[0]}", None
    elif result != DELEGATED:
        event("restart-failed", pane=pane, name=name, uuid=uuid, reason="wake failed; left asleep")
        notify(f"{SLEEP_MARK}restart of {name} failed", "left asleep: focus the pane or run `wake`",
               enabled=config["notify"])
    outcome = ("restarted" if result is True else "wake delegated to the stub" if result == DELEGATED
               else "wake failed; left asleep")
    say(f"restart {pane}: {old} -> {new}: " + ("woken" if result is True else outcome))
    return outcome, entry if result == DELEGATED else None


PRESSURE_NAMES = {1: "normal", 2: "warn", 4: "critical"}


def memory_pressure() -> int:
    """macOS kern.memorystatus_vm_pressure_level: 1 normal, 2 warn, 4 critical; 1 when unknown."""
    try:
        out = subprocess.run([shutil.which("sysctl", path=SYSTEM_PATH) or "sysctl", "-n",
                              "kern.memorystatus_vm_pressure_level"], capture_output=True, text=True, timeout=5).stdout
        return int(out.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return 1


def early_sleepers(agents: list[dict], clocks: dict[str, dict], due: list[dict], config: dict,
                   now: float, held: set[str] | None = None) -> tuple[list[dict], int, str]:
    """Candidates to sleep before their window, longest idle first, each idle >= pressure_idle,
    and how many of them should sleep. Over max_live, as many as bring the live count back to
    the cap; under memory pressure (warn or critical), one per tick, so the next tick sees what
    that freed. The caller walks the list until that many slept: one refusing pane (a draft, a
    background shell) must not hold the cap up for good. `held`: session ids with insomnia, never
    candidates (assess refuses them too; leaving them out keeps them open for restart_outdated).
    """
    window = config["pressure_idle_hours"] * 3600
    live = sum(1 for a in agents if a.get("agent") in config["agents"])
    over = max(0, live - config["max_live"] - len(due)) if config["max_live"] else 0
    level = memory_pressure()
    want = max(over, 1 if level > 1 else 0)
    if not want:
        return [], 0, ""
    taken = {a["pane_id"] for a in due} | set(config["exclude"])
    ready = sorted((a for a in agents if a["pane_id"] in clocks and a["pane_id"] not in taken
                    and a.get("name") not in config["exclude"]
                    and (a.get("agent_session") or {}).get("value") not in (held or set())
                    and now - clocks[a["pane_id"]]["since"] >= window),
                   key=lambda a: clocks[a["pane_id"]]["since"])
    why = (f"{live} live > max_live {config['max_live']}" if over else "") + \
          (f"{'; ' if over else ''}memory pressure {PRESSURE_NAMES.get(level, level)}" if level > 1 else "")
    return ready, want, why


def watch_tick(clocks: dict[str, dict], config: dict) -> None:
    """One watcher tick: sleep_tick, then the mail flush, which runs even when sleep_tick failed
    (a broken sleep or reconcile must not hold mail back; mail_refusal re-reads fresh state)."""
    agents = list_agents()
    try:
        sleep_tick(clocks, config, agents)
    except Exception as exc:
        if not server_down(exc):  # with no server there is nothing to type into
            flush_mail_safely(agents)
        raise
    flush_mail_safely(agents)


def flush_mail_safely(agents: list[dict]) -> None:
    try:
        flush_mail(agents)
    except Exception as exc:
        say(f"mail flush: {type(exc).__name__}: {exc}")


def sleep_tick(clocks: dict[str, dict], config: dict, agents: list[dict]) -> None:
    """One pass over `agent list`: advance idle clocks, sleep what is due, reconcile the journal.

    clocks[pane] = {terminal_id, seq, uuid, since}: the wall-clock start of the pane's
    current idle stretch, valid only while terminal id, `state_change_seq` and session all
    stay put. Herdr's seq is a server-global counter that restarts at 0 with the server and
    restore re-allocates terminal ids, so nothing identifies an idle stretch across a server
    restart; matching all of them keeps the clock across watcher restarts and restarts it
    (late, never early) after a server restart. Every reset is on disk (idle.json) before
    the first sleep transaction of the tick: a crash must not replay a stale `since`.
    """
    now = time.time()
    seen: set[str] = set()
    exclude = set(config["exclude"])
    before = json.dumps(clocks, sort_keys=True)
    restarting: dict | None = None
    try:  # unreadable claims: everything goes on to assess, which refuses every sleep
        held = set(insomnia_claims(now))
    except SleeperError:
        held = set()
    with locked():
        try:
            merge_snapshot(agents)
        except DamagedState as exc:
            say(f"WARN {exc}; damaged snapshot moved to {quarantine(SNAPSHOT)}")
        try:
            reconcile(agents)
            journal = read_json(JOURNAL)
        except DamagedState as exc:
            say(f"WARN {exc}; damaged journal moved to {quarantine(JOURNAL)}")
            journal = {}
        # 1. clocks only: resets and pops, persisted before anything acts on them
        due: list[dict] = []
        for agent in agents:
            kind = agent.get("agent")
            if kind not in config["agents"]:
                continue
            pane = agent["pane_id"]
            seen.add(pane)
            # `done` = idle-but-unviewed: its clock must accrue too or background-finished panes never sleep
            if agent.get("agent_status") not in SLEEPABLE_STATUSES or agent.get("focused") is not False:
                clocks.pop(pane, None)
                continue
            if clock_since(clocks, agent, now) is None:
                clocks[pane] = {**clock_key(agent), "since": now}
            # excluded and insomniac panes keep a clock (restart_outdated may move them to a new build)
            # but never sleep; assess refuses them as well
            excluded = bool(exclude) and (pane in exclude or agent.get("name") in exclude) or \
                (agent.get("agent_session") or {}).get("value") in held
            if not excluded and now - clocks[pane]["since"] >= config["idle_hours"] * 3600:
                due.append(agent)
        for pane in [p for p in clocks if p not in seen]:
            clocks.pop(pane, None)
        if json.dumps(clocks, sort_keys=True) != before:
            persist_clocks(clocks)
            before = json.dumps(clocks, sort_keys=True)
        try:
            tend_insomnia(agents, clocks, now)
            prune_spawned(agents, journal, now)
            settle_owed_names(agents, now)
        except (SleeperError, OSError) as exc:
            say(f"WARN insomnia/spawn upkeep: {exc}")
        early, want_early, why_early = early_sleepers(agents, clocks, due, config, now, held)
        if early and why_early != LAST_SKIP.get("<early>"):
            LAST_SKIP["<early>"] = why_early
            say(f"early sleep ({why_early}): {want_early} of {', '.join(a['pane_id'] for a in early)}")
        # 2. sleep what is due; one pane failing in any way costs that pane, not the tick
        slept_early = 0
        for agent in due + early:
            if STOP["requested"]:
                break  # a stopping watcher starts no new transaction
            if agent not in due and slept_early >= want_early:
                break
            pane, kind = agent["pane_id"], agent.get("agent")
            since = clocks[pane]["since"]
            window = config["idle_hours"] if agent in due else config["pressure_idle_hours"]
            try:
                # the gate sleep_agent assumes: no session, no transcript, open elsewhere ... -> skip, never raise
                ok, reason, _ = assess(agent, agents, window, journal, exclude, idle_since=since)
                if not ok:
                    if not reason.startswith(QUIET_OUTCOMES):
                        note_skip(pane, reason)
                    continue
                uuid = (agent.get("agent_session") or {}).get("value")  # capture before sleep mutates the pane
                did, outcome = sleep_agent(agent, window, exclude, dry_run=config["dry_run"],
                                           idle_since=since, notify_enabled=config["notify"])
            except SleeperError as exc:  # one flaky pane must not starve the rest of the tick
                did, outcome = False, f"error: {exc}"
            except Exception as exc:  # nor may a bug that only this pane's data triggers
                did, outcome = False, f"error: {type(exc).__name__}: {exc}"
            if did or outcome == DRY_RUN_OUTCOME:
                slept_early += agent not in due
            if did:
                say(f"slept {pane} ({agent.get('name') or kind}) uuid={uuid}")
                clocks.pop(pane, None)
                LAST_SKIP.pop(pane, None)
            elif not outcome.startswith(QUIET_OUTCOMES):
                note_skip(pane, outcome)
        if config["restart_outdated"] and not STOP["requested"]:
            try:
                restarting = restart_onto_new_build(agents, clocks, {a["pane_id"] for a in due + early},
                                                    read_json(JOURNAL), config, now)
            except SleeperError as exc:
                say(f"restart-outdated: {exc}")
    if restarting:
        await_stub_wake(restarting)  # outside the lock: the stub takes it
    if json.dumps(clocks, sort_keys=True) != before:
        persist_clocks(clocks)


def on_term(*_a: object) -> None:
    """SIGTERM (ensure_watcher replacing us): finish the transaction in hand, then exit."""
    STOP["requested"] = True
    say("watcher stopping (SIGTERM); finishing the current transaction first")


def pause(seconds: float) -> None:
    """Sleep in 1 s steps so a SIGTERM is honoured within a second, not after a whole poll."""
    for _ in range(max(1, int(math.ceil(seconds)))):
        if STOP["requested"]:
            return
        time.sleep(1)


def mail_waiting() -> bool:
    """Any mailbox with a queued message (a directory listing, no Herdr call)."""
    with contextlib.suppress(OSError):
        return any(d.is_dir() and valid_session_id(d.name) and pending_mail(d.name) for d in MAILBOX.iterdir())
    return False


def pause_watching_mail(seconds: float) -> None:
    """Wait for the next tick. While mail waits, retry it every MAIL_POLL_SECONDS: a cleared draft
    or an agent going idle releases it within seconds, not a whole poll, and the hold reason that
    `presence` shows is at most that old. Only mail is retried; sleeping waits for the full tick."""
    left = float(seconds)  # counted in slept steps (a retry's own time is not subtracted)
    while left > 0 and not STOP["requested"]:
        step = min(left, MAIL_POLL_SECONDS)
        pause(step)
        left -= step
        if left > 0 and not STOP["requested"] and mail_waiting():
            try:
                flush_mail_safely(list_agents())
            except SleeperError as exc:
                say(f"mail retry: {exc}; the next tick retries")
                return


def watch_loop() -> None:
    lock_fh = os.fdopen(open_private(WATCHER_LOCK, os.O_RDWR), "a+")
    for waited in range(WATCHER_LOCK_WAIT_SECONDS + 1):  # an old watcher may be finishing a transaction
        try:
            fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if waited == WATCHER_LOCK_WAIT_SECONDS:
                print(f"another watcher holds {WATCHER_LOCK}; exiting")
                lock_fh.close()
                return
            time.sleep(1)
    try:
        signal.signal(signal.SIGTERM, on_term)
        write_json(WATCHER_PID, {"pid": os.getpid(), "stamp": code_stamp(), "lock": True})
        say(f"watcher start session={SESSION}")
        clocks = load_clocks()
        failures = 0
        down = 0  # consecutive ticks that found no Herdr server (after a reboot the watcher may be first)
        while not STOP["requested"]:
            if STOPPED.exists():
                say("watcher stopped by `stop`; idling until `start`")
                while STOPPED.exists() and not STOP["requested"]:
                    pause(30)  # a service manager would restart an exited watcher; idle instead
                continue
            rec = watcher_pid_record()
            if rec and rec.get("pid") != os.getpid() and watcher_alive(rec):
                say("watcher superseded; exiting")  # e.g. an older version's watcher took the pid file
                return
            try:
                config, _src = load_config()
                poll = max(1.0, float(config["poll_seconds"]))
            except ConfigError as exc:
                say(f"error: sleeping disabled by broken config — {exc}")
                pause(300)
                continue
            try:
                watch_tick(clocks, config)
                if down:
                    say(f"herdr server reachable again after {down} tick(s)")
                elif failures:
                    say(f"tick recovered after {failures} failure(s)")
                failures = down = 0
            except SleeperError as exc:
                if server_down(exc):
                    # not a failure to back off from: retry at the poll interval so the watcher
                    # catches up as soon as the server is up (logged once per outage)
                    if not down:
                        say(f"herdr server not reachable ({exc}); retrying every {poll:g}s")
                    down += 1
                    failures = 0
                    pause(poll)
                    continue
                down = 0
                failures += 1
                say(f"tick-error: {exc}")
            except Exception as exc:  # a bug must cost one tick, never the service
                down = 0
                failures += 1
                where = " | ".join(traceback.format_exc().strip().splitlines()[-3:-1])
                say(f"tick-error: {type(exc).__name__}: {exc} ({where})")
            delay = poll if not failures else min(WATCHER_BACKOFF_MAX, poll * 2 ** min(failures, 10))
            if failures:
                say(f"backing off {delay:g}s after {failures} failed tick(s)")
                pause(delay)
            else:
                pause_watching_mail(delay)
        say("watcher stopped")
    finally:
        lock_fh.close()


# ------------------------------------------------------------- focus hook

def wake_lock(pane: str):
    """One click fires several pane.focused hooks (workspace→tab→pane); only the first may act.

    Returns a release callable, or None when a recent holder is on this pane.
    """
    path = STATE_DIR / f".{pane.replace(':', '_')}.wakelock"
    ensure_state_dir()
    for _ in range(2):
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)

            def release() -> None:
                with contextlib.suppress(OSError):
                    os.unlink(path)

            return release
        except FileExistsError:
            try:
                if time.time() - path.stat().st_mtime < 120:  # agent start waits up to 60s; older is a dead holder
                    return None
                path.unlink()
            except OSError:
                return None
    return None


def cmd_on_focus() -> int:
    heal_watcher()
    raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON") or "{}"
    try:
        pane = ((json.loads(raw).get("data") or {}).get("pane_id")
                or json.loads(raw).get("pane_id"))
    except ValueError:
        return 0
    if not pane:
        return 0
    try:
        row = read_json(JOURNAL).get(pane)
    except (SleeperError, DamagedState):
        return 0
    if not isinstance(row, dict) or row.get("phase") in ("displaced", "orphaned"):
        return 0  # cheap path: nothing of ours (orphans are keyed `orphan:`), or a pane that runs another session
    try:
        config, _src = load_config()
        if not config["wake_on_focus"]:
            return 0
    except ConfigError:
        return 0
    release = wake_lock(pane)
    if not release:
        return 0
    try:
        outcome: bool | str = False
        with locked(timeout=FOCUS_LOCK_WAIT_SECONDS):  # never queue behind a long transaction; refocus retries
            hit = find_journal_entry(pane)
            if hit and not is_orphan(hit[0], hit[1]):
                outcome = wake_entry(hit[1], via="focus", key=hit[0])
        if hit and outcome == DELEGATED:
            # Enter went to the pane's stub: confirm it outside the global lock (the stub needs it),
            # which finishes the `waking` row and hands the name back now rather than a tick later
            await_stub_wake(hit[1])
    except SleeperError as exc:
        say(f"on-focus {pane}: {exc}")
    finally:
        release()
    return 0


# -------------------------------------------------------------- migration

def migrate_legacy() -> None:
    """One-time adoption of the standalone script's journal for this session."""
    if SESSION != "default" or JOURNAL.exists():
        return
    legacy = LEGACY_STATE_DIR / "sleeping.json"
    if not legacy.exists():
        return
    try:
        data = json.loads(legacy.read_text())
    except (OSError, ValueError):
        say("migration: legacy journal unreadable; starting empty (the legacy file is untouched)")
        return
    if not isinstance(data, dict):
        say("migration: legacy journal is not an object; starting empty (the legacy file is untouched)")
        return
    entries = {p: {**e, "kind": e.get("kind") or "claude"} for p, e in data.items()
               if isinstance(e, dict) and isinstance(e.get("uuid"), str)}
    if entries:
        write_json(JOURNAL, entries)
    event("migrated", entries=len(entries), source=str(legacy))
    say(f"migrated {len(entries)} legacy journal entr{'y' if len(entries) == 1 else 'ies'} from {legacy}")


MIGRATABLE_KEYS = {"idle", "idle_hours", "exclude", "interval_minutes", *DEFAULTS}


def toml_value(v: object) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str) and not set(v) & {'"', "\\", "\n"}:
        return f'"{v}"'
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    raise ConfigError(f"cannot translate value {v!r}")


def migrate_legacy_config() -> None:
    """One-time translation of an older config into the file Herdr points the plugin at.

    Only when CONFIG_FILE is missing: an existing plugin config is never rewritten
    (a stray older file is pointed out in the log instead). `interval_minutes` (the
    standalone script's launchd cadence) is dropped; unknown keys or values we cannot
    translate refuse the migration, and load_config then keeps sleeping off.
    """
    if CONFIG_FILE.exists():
        for old in LEGACY_CONFIG_FILES:
            if old.exists() and not same_dir(str(old), str(CONFIG_FILE)):
                say(f"WARN {old} is not read: the plugin reads {CONFIG_FILE} (an older config is migrated only "
                    "when that file is missing); merge what you still want and delete the old file")
        return
    for old in LEGACY_CONFIG_FILES:
        if not old.exists():
            continue
        try:
            raw = parse_toml(old)
            unknown = sorted(set(raw) - MIGRATABLE_KEYS)
            if unknown:
                raise ConfigError(f"unknown key(s) {unknown}")
            lines = [f"# migrated by herdr-sleeper {dt.date.today().isoformat()} from {old}",
                     "# (interval_minutes dropped: the watcher polls every poll_seconds)"]
            lines += [f"{k} = {toml_value(v)}" for k, v in raw.items() if k != "interval_minutes"]
        except Exception as exc:  # TOMLDecodeError, OSError, ConfigError
            say(f"WARN not migrating {old}: {exc}; sleeping stays off until {CONFIG_FILE} exists")
            return
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=CONFIG_FILE.name + ".", suffix=".tmp", dir=CONFIG_FILE.parent)
        with os.fdopen(fd, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        os.replace(tmp, CONFIG_FILE)
        event("config-migrated", source=str(old), target=str(CONFIG_FILE))
        say(f"migrated config {old} -> {CONFIG_FILE}")
        return


