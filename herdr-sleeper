# Commands the CLI answers with nothing on success: exit 0 and empty stdout, or the error JSON on
# stderr and exit 1 (Herdr v0.9.5 src/cli.rs send_ok_request). No envelope is not a failure for these.
OK_ONLY_COMMANDS = {("pane", "report-agent"), ("pane", "report-agent-session"), ("pane", "release-agent"),
                    ("pane", "report-metadata"), ("pane", "send-keys"), ("pane", "send-text"),
                    ("server", "stop"), ("workspace", "report-metadata")}


def herdr(*args: str, check: bool = True, timeout: float = HERDR_TIMEOUT) -> dict:
    """Run a `herdr` CLI command and return its parsed JSON `result`.

    Herdr prints `{"error": {...}}` with exit 0 on failure, so the envelope is
    what we trust, not the exit code. With check=False a failure returns {}.
    A failure raises HerdrError carrying Herdr's error code when one was sent (on
    stdout, or as the JSON line newer CLIs print to stderr). An OK_ONLY_COMMANDS
    call succeeds (returns {}) on exit 0 with nothing on stdout and no error on stderr.
    """
    try:
        proc = subprocess.run([HERDR_BIN, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            raise HerdrError(f"herdr {' '.join(args[:2])} timed out after {timeout}s")
        return {}
    except FileNotFoundError:
        raise SleeperError(f"`{HERDR_BIN}` not found (set HERDR_BIN_PATH or fix PATH)")
    out = proc.stdout.strip()
    if (tuple(args[:2]) in OK_ONLY_COMMANDS and proc.returncode == 0 and not out
            and error_code(None, proc.stderr) is None):
        return {}
    payload: dict | None = None
    if out.startswith("{"):
        try:
            payload = json.loads(out)
        except json.JSONDecodeError:
            payload = None
    if payload is None or "error" in payload or proc.returncode != 0:
        if check:
            detail = (payload or {}).get("error") or proc.stderr.strip() or out[:200] or f"exit {proc.returncode}"
            raise HerdrError(f"herdr {' '.join(args[:2])} failed: {detail}", error_code(payload, proc.stderr))
        return {}
    result = payload.get("result")
    if not isinstance(result, dict):
        if check:
            raise SleeperError(f"herdr {' '.join(args[:2])}: malformed envelope (result is {type(result).__name__})")
        return {}
    return result


def error_code(payload: dict | None, stderr: str) -> str | None:
    """Herdr's error code from a failed call: the stdout envelope, else a JSON line on stderr."""
    candidates = [payload] if payload else []
    for line in (stderr or "").splitlines():
        line = line.strip()
        if line.startswith("{"):
            with contextlib.suppress(ValueError):
                candidates.append(json.loads(line))
    for c in candidates:
        err = c.get("error") if isinstance(c, dict) else None
        if isinstance(err, dict) and isinstance(err.get("code"), str):
            return err["code"]
    return None


def herdr_screen(pane: str) -> str | None:
    """The pane's screen with its SGR styling (composer_state tells a dim suggestion from a
    draft by it), or None when it could not be read."""
    try:
        proc = subprocess.run([HERDR_BIN, "pane", "read", pane, "--format", "ansi"], capture_output=True, text=True,
                              timeout=HERDR_TIMEOUT)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if proc.returncode != 0 or proc.stdout.lstrip().startswith('{"error"'):
        return None
    return proc.stdout


def list_agents() -> list[dict]:
    agents = herdr("agent", "list").get("agents")
    if not isinstance(agents, list) or not all(isinstance(a, dict) and isinstance(a.get("pane_id"), str) for a in agents):
        raise SleeperError("herdr agent list: malformed agents payload")
    return agents


SESSION_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")  # claude uuids, opencode `ses_…` ids


def valid_session_id(value: object) -> bool:
    """A session id safe to put into a transcript glob, an argv, or a typed stub command."""
    return isinstance(value, str) and SESSION_ID_RE.fullmatch(value) is not None


def valid_entry(entry: object) -> bool:
    """A journal/snapshot entry we are willing to act on."""
    return (isinstance(entry, dict) and isinstance(entry.get("pane_id"), str)
            and valid_session_id(entry.get("uuid")) and isinstance(entry.get("kind"), str))


