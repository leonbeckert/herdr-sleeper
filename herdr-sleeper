class SleeperError(Exception):
    """Any refusal with a reason a human can act on."""


class ConfigError(SleeperError):
    """The configuration is unusable; sleeping stays off until it is fixed."""


class DamagedState(SleeperError):
    """The file exists but is not a JSON object — as opposed to an I/O failure reading it."""


class HerdrError(SleeperError):
    """A `herdr` call that failed; `code` is Herdr's error code when it sent one (else None)."""

    def __init__(self, message: str, code: str | None = None) -> None:
        super().__init__(message)
        self.code = code


# How a CLI call reads when no server listens on the socket: Herdr's own `server_not_running`
# error, `server_unavailable` while it shuts down (seen in the lab when the watcher ticked during a
# `server stop`), or the raw connect failure (ENOENT for a missing socket, ECONNREFUSED for a stale one).
SERVER_DOWN_CODES = ("server_not_running", "server_unavailable")
SERVER_DOWN = re.compile(r"server_not_running|server_unavailable|ConnectionRefused|Connection refused|NotFound"
                         r"|\(os error (?:2|61|111)\)")


def server_down(exc: BaseException) -> bool:
    """Did this failure come from a Herdr server that is not running (yet)? After a reboot the
    watcher can come up before the server; that is worth a retry at the poll interval, not a backoff."""
    return getattr(exc, "code", None) in SERVER_DOWN_CODES or bool(SERVER_DOWN.search(str(exc)))


# ------------------------------------------------------------- agent profiles

# exit: "signal" sends SIGTERM to the agent process (claude/opencode shut down
# cleanly and discard composer drafts); "prompt" types exit_command into the
# pane, which is only safe with the composer-empty check (recheck applies it).
# argv_after_binary: replay the pane's original argv on wake (claude only —
# for the others the resume flags carry everything we can vouch for).
# idle_guards: before sleeping, also require an empty composer (a draft is unsent work: a signal
# would discard it) and no background work (footer counts, shell children, scheduled wakeups or
# session crons in the transcript). Claude-shaped, so claude only.
PROFILES: dict[str, dict] = {
    "claude": {"exit": "signal", "argv_after_binary": True, "idle_guards": True},
    "opencode": {"exit": "signal", "argv_after_binary": False},
    # codex is deliberately absent: its TUI does not restore the terminal's keyboard protocol on
    # any signal, so it would need the typed-command exit, and our composer-empty check is
    # claude-shaped (prompt glyphs) — an unknown composer must refuse, which would make a codex
    # profile refuse always. Add it only with its own composer check.
}


def resume_argv(kind: str, uuid: str, extra: list[str] | None = None) -> list[str] | None:
    """The argv after the agent binary that resumes exactly this session."""
    if kind == "claude":
        return [*(extra or []), "--resume", uuid]
    if kind == "opencode":
        return ["-s", uuid]
    if kind == "codex":
        return ["resume", uuid]
    return None


def manual_command(entry: dict) -> str:
    """The by-hand resume line printed when we refuse to act automatically."""
    kind = entry.get("kind") or "claude"
    extra: list[str] = []
    if kind == "claude":
        extra, _why = replayable_argv(entry.get("argv") or [])
    argv = resume_argv(kind, entry["uuid"], extra or None)
    if argv is None:
        return f"(no resume recipe for {kind}; session {entry['uuid']})"
    return f"cd {shlex.quote(entry.get('cwd') or '.')} && " + shlex.join([kind, *argv])


# -------------------------------------------------------------------- output

LOG_MAX_BYTES = 1_000_000  # sleeper.log and events.jsonl rotate to <name>.1 past this


def ensure_state_dir() -> None:
    """Create the state dir private to its owner: it holds session ids, cwds and pane titles."""
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    with contextlib.suppress(OSError):
        if STATE_DIR.stat().st_mode & 0o077:
            STATE_DIR.chmod(0o700)  # created by an earlier version under the default umask


def open_private(path: Path, flags: int) -> int:
    """os.open with O_CREAT and mode 0600; tightens a file an earlier version left 0644."""
    ensure_state_dir()
    fd = os.open(path, flags | os.O_CREAT, 0o600)
    with contextlib.suppress(OSError):
        if os.fstat(fd).st_mode & 0o077:
            os.fchmod(fd, 0o600)
    return fd


@contextlib.contextmanager
def flocked(path: Path, wait: bool = True) -> Iterator[bool]:
    """An exclusive flock on a private lock file; yields False when wait=False and it is taken."""
    with os.fdopen(open_private(path, os.O_RDWR), "a+") as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError:
            yield False
            return
        yield True  # closing the file releases the lock


def append_private(path: Path, line: str) -> None:
    """Append one line to a 0600 file, rotating it to <name>.1 once it outgrows LOG_MAX_BYTES.
    Under a lock: two writers rotating at once would replace the fresh .1 with an empty file."""
    with flocked(path.with_name(path.name + ".lock")):
        with contextlib.suppress(OSError):
            if path.stat().st_size > LOG_MAX_BYTES:
                os.replace(path, path.with_name(path.name + ".1"))
        with os.fdopen(open_private(path, os.O_WRONLY | os.O_APPEND), "a") as fh:
            fh.write(line + "\n")


def say(msg: str) -> None:
    """Diagnostics: to the log always, to the caller's stdout too."""
    with contextlib.suppress(OSError):
        append_private(LOGFILE, f"{dt.datetime.now().isoformat(timespec='seconds')} {msg}")
    print(msg, file=sys.stderr)


def event(what: str, **fields: object) -> None:
    """Append one structured record to events.jsonl (what `log` shows)."""
    try:
        rec = {"at": dt.datetime.now().isoformat(timespec="seconds"), "event": what, **fields}
        append_private(EVENTS, json.dumps(rec, sort_keys=True))
    except OSError as exc:
        say(f"WARN could not write event: {exc}")


def notify(title: str, body: str = "", enabled: bool = True) -> None:
    if not enabled:
        return
    herdr("notification", "show", title, *(["--body", body] if body else []), check=False, timeout=10)


# ---------------------------------------------------------------- json state

def full_sync(fd: int) -> None:
    """Flush fd to stable storage. On macOS fsync(2) only hands the data to the drive, which may
    keep it in its write cache through a power cut; F_FULLFSYNC asks the drive to flush that cache
    too (fsync(2), fcntl(2) man pages). Where F_FULLFSYNC is missing or refused (another platform,
    a filesystem that does not support it), plain fsync."""
    full = getattr(fcntl, "F_FULLFSYNC", None)
    if full is not None:
        try:
            fcntl.fcntl(fd, full)
            return
        except OSError:
            pass
    os.fsync(fd)


def write_json(path: Path, data: object) -> None:
    """Atomic and durable: the temp file reaches the disk before it replaces the old one, and the
    directory entry after (full_sync: F_FULLFSYNC on macOS, where fsync alone stops at the drive's
    write cache). A power cut or a forced reboot otherwise can leave a zero-length journal, which is
    the one handle to every slept session."""
    ensure_state_dir()
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2, sort_keys=True) + "\n")
        fh.flush()
        full_sync(fh.fileno())
    os.replace(tmp, path)
    with contextlib.suppress(OSError):  # a directory sync is best effort (not every filesystem allows it)
        dfd = os.open(path.parent, os.O_RDONLY)
        try:
            full_sync(dfd)
        finally:
            os.close(dfd)


def quarantine(path: Path) -> Path:
    """Move a damaged state file aside (never overwrite evidence) and return where it went."""
    aside = path.with_name(f"{path.name}.damaged-{dt.datetime.now().strftime('%Y%m%dT%H%M%S')}")
    os.replace(path, aside)
    return aside


def read_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        text = path.read_text()
    except OSError as exc:
        raise SleeperError(f"{path} could not be read ({exc}); refusing to act without it")
    except UnicodeDecodeError as exc:
        raise DamagedState(f"{path} is not UTF-8 ({exc.reason}); refusing to act on a damaged state file")
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise DamagedState(f"{path} is not valid JSON ({exc}); refusing to act on a damaged state file")
    if not isinstance(data, dict):
        raise DamagedState(f"{path} does not hold a JSON object; refusing to act on a damaged state file")
    return data


class locked:
    """Interprocess lock around a whole sleep/wake transaction (watcher + hooks may overlap).

    With a timeout, gives up with SleeperError instead of queueing: focus hooks
    use that so a burst of them cannot pile up behind a 25 s sleep transaction
    against Herdr's cap on in-flight plugin commands.
    """

    def __init__(self, timeout: float | None = None) -> None:
        self.timeout = timeout

    def __enter__(self) -> "locked":
        self.fh = os.fdopen(open_private(LOCK, os.O_RDWR), "a+")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return self
        except OSError:
            pass
        if self.timeout is None:
            say("another herdr-sleeper holds the lock; waiting")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
            return self
        for _ in range(max(1, int(self.timeout * 4))):
            time.sleep(0.25)
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                continue
        self.fh.close()
        raise SleeperError(f"busy: another herdr-sleeper held the lock for {self.timeout:g}s")

    def __exit__(self, *exc: object) -> None:
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


